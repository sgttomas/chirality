@@ -3996,3 +3996,203 @@ button:disabled {
   font-size: 0.82rem;
   color: var(--ink-soft);
 }
+
+
+/* SCA-APP-010 Stone presentation. Scope tokens to the woven workspace so the
+   compatibility interface retains its existing presentation contract. */
+.woven-workspace {
+  --ground: #f2f1ed;
+  --surface: #ffffff;
+  --card: #ffffff;
+  --composer: #ffffff;
+  --ink: #222120;
+  --ink-soft: #5c5a55;
+  --ink-faint: #706e68;
+  --rule: #e2e0da;
+  --rule-strong: #cfccc4;
+  --brand-ink: #4a3423;
+  --accent-soft: #efede8;
+  --cta: #222120;
+  --cta-ink: #ffffff;
+  font: 400 13.5px/1.5 var(--font-body);
+}
+:root[data-theme="dark"] .woven-workspace {
+  --ground: #161615;
+  --surface: #1e1e1c;
+  --card: #1e1e1c;
+  --composer: #1e1e1c;
+  --ink: #e8e7e2;
+  --ink-soft: #a5a49d;
+  --ink-faint: #a09f98;
+  --rule: #2b2b29;
+  --rule-strong: #3a3a37;
+  --brand-ink: #e8e7e2;
+  --accent-soft: #2a2a27;
+  --cta: #e8e7e2;
+  --cta-ink: #1a1a19;
+}
+@media (prefers-color-scheme: dark) {
+  :root[data-theme="system"] .woven-workspace {
+    --ground: #161615;
+    --surface: #1e1e1c;
+    --card: #1e1e1c;
+    --composer: #1e1e1c;
+    --ink: #e8e7e2;
+    --ink-soft: #a5a49d;
+    --ink-faint: #a09f98;
+    --rule: #2b2b29;
+    --rule-strong: #3a3a37;
+    --brand-ink: #e8e7e2;
+    --accent-soft: #2a2a27;
+    --cta: #e8e7e2;
+    --cta-ink: #1a1a19;
+  }
+}
+.woven-workspace button {
+  background: transparent;
+  color: var(--ink-soft);
+  box-shadow: none;
+}
+.woven-workspace button:hover { color: var(--ink); filter: none; }
+.woven-workspace .chat-input-row button[type="submit"] {
+  background: var(--cta);
+  color: var(--cta-ink);
+}
+.woven-workspace h2, .woven-workspace h3 {
+  font-family: var(--font-body);
+  font-size: 13.5px;
+  font-weight: 500;
+  letter-spacing: normal;
+}
+.woven-workspace .woven-dialogue-region,
+.woven-workspace .panel--chat { background: var(--surface); }
+.woven-workspace .woven-navigator {
+  padding: 14px 10px 10px;
+  gap: 16px;
+  grid-template-rows: auto minmax(0, 1fr) auto;
+  background: var(--ground);
+}
+.woven-navigator-brand {
+  padding: 0 8px;
+  font: 500 19px/1.2 var(--font-display);
+  letter-spacing: .01em;
+  color: var(--brand-ink);
+}
+.woven-workspace .woven-navigator-sections {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  overflow: auto;
+  gap: 12px;
+}
+.woven-workspace .woven-navigator-session {
+  border: 0;
+  border-radius: 6px;
+  padding: 7px 8px;
+  background: transparent;
+}
+.woven-workspace .woven-navigator-session[aria-pressed="true"] {
+  background: var(--accent-soft);
+}
+.woven-workspace .woven-compatibility {
+  margin: 0;
+  border-top: 1px solid var(--rule);
+  padding: 10px 8px 0;
+  font-size: 12px;
+}
+.woven-workspace .woven-right-panel {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  background: var(--ground);
+}
+.woven-workspace .woven-right-panel-header {
+  min-height: 40px;
+  padding: 6px 8px 6px 14px;
+  gap: 6px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: nowrap;
+  border-bottom: 1px solid var(--rule);
+}
+.woven-right-panel-header > nav,
+.woven-right-panel-header > [role="tablist"] {
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.woven-right-panel-header > nav {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.woven-right-panel-header [role="tablist"] {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+}
+.woven-right-panel-header button,
+.woven-right-panel-header summary {
+  border: 0;
+  padding: 4px 5px;
+  font-size: 12px;
+  border-radius: 4px;
+}
+.woven-right-panel-header [role="tab"][aria-selected="true"] {
+  color: var(--ink);
+  box-shadow: inset 0 -1px var(--accent);
+}
+.woven-right-panel-controls { display: flex; gap: 2px; flex: none; }
+.woven-right-panel-controls > details { position: relative; }
+.woven-right-panel-controls > details > summary {
+  cursor: pointer;
+  list-style: none;
+  min-width: 24px;
+  text-align: center;
+}
+.woven-right-panel-controls > details > summary::-webkit-details-marker { display: none; }
+.woven-right-panel-controls > details[open] {
+  z-index: 5;
+  background: var(--surface);
+}
+.woven-panel-menu-content {
+  position: absolute;
+  top: 100%;
+  right: 0;
+  z-index: 5;
+  width: min(240px, 75vw);
+  border: 1px solid var(--rule-strong);
+  border-radius: 8px;
+  padding: 5px;
+  background: var(--surface);
+  box-shadow: 0 8px 24px var(--shadow-strong);
+}
+.woven-panel-menu-content > button {
+  display: block;
+  width: 100%;
+  text-align: left;
+}
+.woven-panel-menu-content > p { padding: 4px 5px; font-size: 12px; }
+.woven-workspace .document-view--woven {
+  border: 0;
+  border-radius: 0;
+  background: var(--surface);
+  height: 100%;
+}
+.document-view--woven .panel-header { padding: 6px 18px; border: 0; }
+.document-view--woven .panel-header:has(> .sr-only:only-child) { padding: 0; }
+.document-view--woven .document-view-body { padding: 14px 18px; }
+.document-view--woven .document-view-body > p:first-child { font-size: 11.5px; color: var(--ink-faint); }
+.document-view--woven .sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
