diff --git a/projects/chirality-app-dev/frontend/src/app/globals.css b/projects/chirality-app-dev/frontend/src/app/globals.css
index 058b67210..00db6bca2 100644
--- a/projects/chirality-app-dev/frontend/src/app/globals.css
