+
+  let canonicalResourcesRoot;
+  try {
+    canonicalResourcesRoot = await realpath(candidateRoot);
+  } catch (error) {
+    return {
+      status: 'FAIL',
+      path: fallbackPath,
+      canonicalResourcesRoot: null,
+      failures: [`Unable to resolve packaged Resources root: ${error.message}`]
+    };
