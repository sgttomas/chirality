{
  "cwd_policy": "product commands from projects/pec; repository tools from repository root",
  "interpreter": "Python 3.13.7",
  "environment": "PYTHONDONTWRITEBYTECODE=1 and a fresh /private/tmp TMPDIR for product/check execution",
  "commands": [
    {"name": "six hold preflights", "exit_code": 0, "result": "six ALLOW"},
    {"name": "before exact probe capture", "exit_code": 0, "result": "both false-negative PASS results captured"},
    {"name": "before intentional new assertions", "exit_code": 1, "result": "expected failure: two PASS != BLOCK assertions"},
    {"name": "focused changed test modules", "command": "python3 -m unittest -v v2.tests.enforcement.test_dependency_assertion v2.tests.enforcement.test_locality_assertion", "exit_code": 0, "result": "23 tests OK"},
    {"name": "full enforcement suite", "command": "python3 -m unittest discover -s v2/tests/enforcement -p 'test_*.py'", "exit_code": 0, "result": "28 tests OK"},
    {"name": "exact v2-core-posture", "command": "python3 v2/tools/check_service_core_posture.py --config v2/config/service_core_posture.json --workflow software-workflow.json", "exit_code": 0, "result": "PASS"},
    {"name": "select affected registered checks", "command": "python3 tools/software_workflow/select_affected_checks.py projects/pec/software-workflow.json <three exact target paths>", "exit_code": 0, "result": ["harness-self-check", "v2-api-contract", "v2-core-posture"]},
    {"name": "auxiliary registered runner", "command": "python3 tools/software_workflow/run_registered_checks.py projects/pec/software-workflow.json --check harness-self-check --check v2-api-contract --check v2-core-posture --output /private/tmp/<scratch>/results.json --timeout-seconds 120", "exit_code": 1, "result": "pre-run output-containment rejection; no check executed"},
    {"name": "v2-api-contract exact registered command", "command": "python3 -m unittest discover -s v2/tests/contracts/api -p 'test_*.py'", "exit_code": 0, "result": "6 tests OK"},
    {"name": "harness-self-check exact registered command", "command": "python3 tools/practitioner_harness/harness.py self-check", "exit_code": 0, "result": "completed; pre-existing INFO/WARN/REVIEW findings reported"},
    {"name": "after exact probe capture", "exit_code": 0, "result": "both probes BLOCK with exact diagnostics"},
    {"name": "validate explicit author paths", "command": "python3 tools/software_workflow/validate_change_scope.py . --allowed <authorized targets> --path <authored paths>", "exit_code": 0, "result": "PASS"},
    {"name": "product diff whitespace", "command": "git diff --check -- <three product targets>", "exit_code": 0, "result": "PASS"}
  ]
}
