const waited = new Promise((_, reject) => { rejectWait = reject; });
void waited.catch(() => {});
const error = new RuntimeError('ENGINE_UNAVAILABLE', 'Controlled unresolved descendant', 503, { reason: 'DESCENDANT_RECONCILIATION_REQUIRED' });
const identity = { canonicalRoot: base, cwd: base, accountId: 'controlled-no-account', accountEpoch: 1, policyDigest: 'a'.repeat(64) };
