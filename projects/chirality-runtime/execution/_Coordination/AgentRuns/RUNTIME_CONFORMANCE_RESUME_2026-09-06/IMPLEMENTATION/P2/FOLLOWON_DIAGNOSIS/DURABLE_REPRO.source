const runtime = new DelegatedRuntime({ daemonId: 'repro-only', projects: new Map([['p', { identity, compatibility, supervisor, consent, retirement, evidenceClass: 'controlled-worker' }]]) });
try {
  const preflight = await runtime.preflight('p', 'turn:t');
  const turn = runtime.turn('p', { compatibility, preflight, turnId: 't', prompt: 'controlled no-exec reproduction' }).then(value => ({ value }), error => ({ error: { code: error.code, reason: error.details?.reason } }));
  let interruptPreflight;
  for (let attempt = 0; attempt < 100; attempt++) { try { interruptPreflight = await runtime.preflight('p', 'interrupt:t'); break; } catch { await new Promise(resolve => setTimeout(resolve, 1)); } }
  assert.ok(interruptPreflight);
  const interruption = await runtime.interruptTurn('p', { compatibility, preflight: interruptPreflight, turnId: 't' }).then(value => ({ value }), error => ({ error: { code: error.code, reason: error.details?.reason } }));
