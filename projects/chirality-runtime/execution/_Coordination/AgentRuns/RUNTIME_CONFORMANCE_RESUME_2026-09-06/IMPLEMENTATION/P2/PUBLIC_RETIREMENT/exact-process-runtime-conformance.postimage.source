const runtimeRoot = fileURLToPath(new URL('../', import.meta.url));
const pins = async () => {
  // Package barrels load transitive dist modules. Pin their entire executable trees,
  // while the lifecycle under repair is deliberately imported directly from source.
  const packagePaths = (await Promise.all(['core', 'client', 'contracts'].map(async name => {
    return (await Promise.all(['src', 'dist'].map(async tree => {
      const root = `packages/${name}/${tree}`;
      return (await readdir(join(runtimeRoot, root), { recursive: true })).filter(path => tree === 'src' ? path.endsWith('.ts') : path.endsWith('.js')).map(path => `${root}/${path}`);
    }))).flat();
  }))).flat();
  return Object.fromEntries(await Promise.all([...new Set([...sourcePaths, ...packagePaths])].sort().map(async path => [path, createHash('sha256').update(await readFile(join(runtimeRoot, path))).digest('hex')])));
};
it('resolves direct lifecycle source and actual package runtime input pins without supplier launch', async () => {
  const manifest = await pins();
  for (const path of sourcePaths) expect(manifest[path]).toMatch(/^[a-f0-9]{64}$/);
  expect(Object.keys(manifest).some(path => path === 'packages/core/dist/delegated-runtime.js')).toBe(true);
});

