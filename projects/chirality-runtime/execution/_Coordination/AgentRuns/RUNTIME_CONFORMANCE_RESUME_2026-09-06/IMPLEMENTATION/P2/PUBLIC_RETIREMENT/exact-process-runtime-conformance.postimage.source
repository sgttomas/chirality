  finally { clearTimeout(timer); }
}
function safeError(error: unknown) {
  const e = error as { name?: unknown; code?: unknown; details?: { reason?: unknown }; message?: unknown };
  return { name: typeof e?.name === 'string' && /^[A-Za-z0-9_]{1,64}$/.test(e.name) ? e.name : 'Error',
    code: typeof e?.code === 'string' && /^[A-Z0-9_]{1,64}$/.test(e.code) ? e.code : 'UNCLASSIFIED',
    reason: typeof e?.details?.reason === 'string' && /^[A-Z0-9_]{1,64}$/.test(e.details.reason) ? e.details.reason : 'UNCLASSIFIED',
    cause: error instanceof RuntimeError && e.code === 'ENGINE_UNAVAILABLE' && e.message === 'Codex turn timed out' && e.details?.reason === 'CODEX_PROTOCOL_FAILURE' ? 'CONFIGURED_TURN_TIMEOUT' : 'OTHER_FAILURE' };
}
type Census = Awaited<ReturnType<DescendantTracker['reconcile']>>;
function fresh(snapshot: Census) { expect(snapshot.failure).toBeUndefined(); expect(snapshot.limitations).not.toContain('LATEST_CENSUS_MAY_BE_STALE'); }
function clean(snapshot: Census) { fresh(snapshot); expect(snapshot.ownedGroup).toEqual([]); expect(snapshot.detached).toEqual([]); expect(snapshot.identityChanged).toEqual([]); }
function assertCommittedRetirement(record: any, expected: 'completed' | 'interrupted' | 'failed', turnId: string, generation: string, retireCalls: any[]) {
  expect(retireCalls.length).toBeGreaterThan(0);
  for (const call of retireCalls) { expect(call.workerId).toBe(turnId); expect(call.generation).toBe(generation); expect(call.status).toBe('fulfilled'); }
  expect(record).toMatchObject({ state: 'committed', terminal: { turnId, workerId: turnId, generation, outcome: expected } });
}
it('rejects committed interruption when the real retirement operation rejected or never completed', () => {
  const record = { state: 'committed', terminal: { turnId: 't', workerId: 't', generation: 'g', outcome: 'interrupted' } };
  const call = { workerId: 't', generation: 'g', status: 'fulfilled' };
  assertCommittedRetirement(record, 'interrupted', 't', 'g', [call]);
  for (const status of ['rejected', 'pending']) expect(() => assertCommittedRetirement(record, 'interrupted', 't', 'g', [{ ...call, status }])).toThrow();
  expect(() => assertCommittedRetirement(record, 'interrupted', 't', 'foreign', [call])).toThrow();
  expect(() => assertCommittedRetirement({ state: 'reconciliation-required' }, 'interrupted', 't', 'g', [call])).toThrow();
});
it('never accepts stale empty census or detached survivors as retired', () => {
  const empty = { failure: undefined, limitations: [], ownedGroup: [], detached: [], identityChanged: [] } as unknown as Census;
  clean(empty);
  expect(() => clean({ ...empty, failure: 'CENSUS_FAILED' })).toThrow();
  expect(() => clean({ ...empty, limitations: ['LATEST_CENSUS_MAY_BE_STALE'] })).toThrow();
  expect(() => clean({ ...empty, detached: [{ pid: 123 } as any] })).toThrow();
