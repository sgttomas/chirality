      hostMarkers(result.markersAfterPublicRetirement[role], scenario !== 'normal');
      const probe = probes.find((call: any) => call.who === role); expect(probe).toBeDefined();
      if (scenario === 'normal') {
        const lines = (probe.output ?? '').split(/\r?\n/);
        for (const key of ['started', 'foreground', 'signal-attempt', 'signal', 'finished'] as const) expect(lines).toContain(markerValues[key]);
      } else { expect(result.readyObservedAt - probe.issuedAt).toBeGreaterThanOrEqual(0); expect(result.publicTurnReceivedAt - probe.issuedAt).toBeLessThanOrEqual(10000); }
    }
    for (const call of result.firstReturns) { if (call.firstElapsedMs !== null) expect(call.firstElapsedMs).toBeLessThanOrEqual(10000); else if (scenario === 'normal') throw new Error('Completed public process profile lacks issued return'); }
    expect(result.hostSentinelAfter).toBe(result.hostSentinelBefore); expect(provider.failures).toEqual([]); expect(result.censusFailures).toEqual([]);
    expect(signals).toBe(1); expect(result.siblingAfter).toEqual(result.siblingBefore); expect(sibling.exitCode).toBeNull(); expect(sibling.signalCode).toBeNull();
    sibling.kill('SIGUSR1'); await until(async () => signals === 2, 2000); result.siblingPostPositiveControl = true;
    expect(result.accountObservations.length).toBeGreaterThan(0); for (const account of result.accountObservations) expect(account).toEqual({ hasAccount: false, authRequired: false });
    if (scenario !== 'normal') expect(result.actionElapsedMs).toBeLessThanOrEqual(10000);
    result.passed = true; result.publicRuntimeCancellationProven = scenario.startsWith('cancel');
  } catch (error) { result.failure = safeError(error); result.failurePhase = phase; }
  finally {
    result.outerCleanupStartedAt = Date.now(); outerCleanupStarted = true;
    const failures: any[] = []; const cleanup = async (name: string, action: () => Promise<unknown>) => { try { await bounded(action(), 8000); } catch (error) { failures.push({ name, error: safeError(error) }); } };
    if (retirement) await cleanup('journal-before-cleanup', async () => { result.retirementAtCleanup = await retirement!.read(turnId); });
    if (externalTracker) await cleanup('census-before-cleanup', async () => { result.censusAtCleanup = await census('fixture-cleanup-start'); });
    await cleanup('daemon-stop', async () => { await daemon?.stop(); });
    await cleanup('workers-close', async () => { await workers?.close(); });
    await cleanup('server-close', async () => { await server?.close(); });
    await cleanup('owned-vendor-fallback', async () => { groupSignal('SIGKILL'); if (childClosed) await childClosed; });
    await cleanup('owned-sibling', async () => { if (sibling && sibling.exitCode === null && sibling.signalCode === null) sibling.kill('SIGTERM'); if (siblingClosed) await siblingClosed; });
    if (externalTracker) await cleanup('independent-lineage', async () => { await until(async () => { const snapshot = await census('fixture-cleanup-poll'); return snapshot.ownedGroup.length === 0 && snapshot.detached.length === 0; }, 7500); result.afterFixtureCleanup = await census('fixture-cleanup-final'); clean(result.afterFixtureCleanup); });
    await cleanup('external-tracker-stop', async () => { await externalTracker?.stop(); });
    result.providerRecords = provider?.records; result.issuedCalls = provider?.issuedCalls; result.providerFailures = provider?.failures;
    await cleanup('provider-close', async () => { await provider?.close(); }); await cleanup('policy-cleanup', async () => { await policy?.cleanup(); });
    if (terminalPromise) await cleanup('public-turn-settlement', async () => { await terminalPromise; });
    await cleanup('source-after', async () => { result.sourcesAfter = await pins(); result.sourceStable = JSON.stringify(result.sourcesBefore) === JSON.stringify(result.sourcesAfter); });
    await cleanup('supplier-after', async () => { result.supplyAfter = (await verify(supplied)).sha256; });
    clearTimeout(watchdog); result.siblingSignalCount = signals; result.cleanupFailures = failures; result.elapsedMs = Date.now() - started;
    result.passed = result.passed && failures.length === 0 && result.censusFailures.length === 0 && result.sourceStable && result.supplyAfter === result.supplySha256 && result.elapsedMs <= 60000 && !result.watchdogFired && !result.wireOverflow && !result.wireParseFailure && !result.stderrOverflow;
    if (!result.passed) result.publicRuntimeCancellationProven = false;
    await mkdir(evidence, { recursive: true, mode: 0o700 }); await writeFile(join(evidence, 'PUBLIC_PROCESS_RETIREMENT.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx', mode: 0o600 });
    if (base && failures.length === 0) await rm(base, { recursive: true, force: true });
  }
  expect(result.passed, 'Public process retirement failed; preserve source-pinned evidence').toBe(true);
}, 70000);
