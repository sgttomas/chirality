const markerValues = { started: 'PROCESS_STARTED', foreground: 'FOREGROUND_CHILD_DONE', 'signal-attempt': 'SIGNAL_ATTEMPTED', signal: 'SIGNAL_DENIED', ready: 'PROCESS_READY', finished: 'PROCESS_FINISHED' };
const markerNames = [...Object.keys(markerValues), 'signal-status', 'pid'];
function hostMarkers(markers: any, lifetime: boolean) {
  for (const name of ['started', 'foreground', 'signal-attempt', 'signal'] as const) expect(markers[name]).toBe(`${markerValues[name]}\n`);
  expect(markers['signal-status']).toMatch(/^[1-9][0-9]*\n$/);
  expect(markers.ready).toBe(lifetime ? 'PROCESS_READY\n' : null);
  expect(markers.finished).toBe(lifetime ? null : 'PROCESS_FINISHED\n');
}
function firstReturns(records: any[], calls: any[]) {
  return calls.map(call => {
    const recordsWithCall = records.flatMap(record => record.outputs.filter((output: any) => output.callId === call.callId).map((output: any) => ({ receivedAt: record.receivedAt, output: output.output, issued: output.issued }))).sort((a, b) => a.receivedAt - b.receivedAt);
    const first = recordsWithCall[0];
    if (first) { expect(first.issued).toMatchObject({ who: call.who, kind: call.kind, issuedAt: call.issuedAt }); expect(first.receivedAt).toBeGreaterThanOrEqual(call.issuedAt); }
    return { ...call, firstReceivedAt: first?.receivedAt ?? null, firstElapsedMs: first ? first.receivedAt - call.issuedAt : null, output: first?.output ?? null };
  });
}
it('uses only first attributed returned output despite replayed request history', () => {
