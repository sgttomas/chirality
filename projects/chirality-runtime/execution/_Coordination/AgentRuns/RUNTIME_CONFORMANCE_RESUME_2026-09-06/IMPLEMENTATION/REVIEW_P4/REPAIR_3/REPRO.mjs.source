const exact=src.slice(src.indexOf('function nativeSessionMetadata('),src.indexOf("it('reads only exact owned native SessionMeta"));
const js=ts.transpile(exact,{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext});
const read=vm.runInNewContext(js+';readNativeSessionMetadata',{JSON,Error,Date,Buffer,process,constants,createHash,join,lstat,realpath,open,readdir});
const base=await mkdtemp('/private/tmp/runtime-conformance-resume-20260906/REVIEW_P4/REPAIR_3/synthetic-');
