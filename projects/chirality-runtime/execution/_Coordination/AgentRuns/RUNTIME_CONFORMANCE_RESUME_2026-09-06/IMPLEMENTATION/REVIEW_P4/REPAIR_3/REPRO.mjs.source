try{result.misplaced={accepted:true,metadata:await read(base,child,parent,'/fixture')}}catch(e){result.misplaced={accepted:false,error:e.message}}
await rm(path);await mkdir(join(base,'sessions','2026','09','06'),{recursive:true});await writeFile(join(base,'sessions','2026','09','06',`rollout-not-a-date-${child}.jsonl`),line+'\n');
try{result.badFilename={accepted:true,metadata:await read(base,child,parent,'/fixture')}}catch(e){result.badFilename={accepted:false,error:e.message}}
}finally{await rm(base,{recursive:true,force:true});}console.log(JSON.stringify(result,null,2));
