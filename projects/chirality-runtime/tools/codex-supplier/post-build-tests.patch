+#[tokio::test]
+async fn multi_agent_v2_deferred_followup_rechecks_authority_before_actual_start() {
+    let manager = thread_manager();
+    let phase_result = timeout(Duration::from_secs(5), async {
+        let (mut session, mut turn) = make_session_and_context().await;
+        let mut config = turn.config.as_ref().clone();
+        let _ = config.features.enable(Feature::MultiAgentV2);
+        set_turn_config(&mut turn, config);
+        let root = manager
+            .start_thread(StartThreadOptions::new((*turn.config).clone()))
+            .await
+            .map_err(|error| format!("root thread failed to start: {error}"))?;
+        session.services.agent_control = manager.agent_control();
+        session.thread_id = root.thread_id;
+        let live = Arc::new(std::sync::atomic::AtomicBool::new(true));
+        let live_for_check = Arc::clone(&live);
+        let (events_tx, mut events) = tokio::sync::mpsc::unbounded_channel();
+        session
+            .services
+            .agent_control
+            .configure_chirality_native_family(ChiralityNativeFamilyConfig {
+                supplier_generation: "supplier-generation".to_string(),
+                root_thread_id: root.thread_id,
+                inherited_tools: vec![],
+                inherited_tools_digest: "tool-digest".to_string(),
+                authority_check: Arc::new(move || {
+                    let live = Arc::clone(&live_for_check);
+                    Box::pin(async move { live.load(std::sync::atomic::Ordering::SeqCst) })
+                }),
+                event_sink: Arc::new(move |event| {
+                    let events_tx = events_tx.clone();
+                    Box::pin(async move { events_tx.send(event).is_ok() })
+                }),
+                role_basis_digest: Arc::new(|body| format!("role:{}", body.len())),
+            })
+            .map_err(|error| format!("private family failed to configure: {error}"))?;
+        turn.turn_metadata_state
+            .set_root_turn_id(turn.sub_id.clone());
+        session
+            .services
+            .agent_control
+            .chirality_native_turn_started(root.thread_id, &turn.sub_id)
+            .await
+            .map_err(|error| format!("private root turn failed to start: {error}"))?;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let created_gate = manager.gate_next_thread_created_before_initial_submission();
+        let spawn = AbortOnDropHandle::new(tokio::spawn({
+            let session = Arc::clone(&session);
+            let turn = Arc::clone(&turn);
+            async move {
+                SpawnAgentHandlerV2::default()
+                    .handle(invocation(
+                        session,
+                        turn,
+                        "spawn_agent",
+                        function_payload(json!({
+                            "message": "boot revocable worker",
+                            "task_name": "revocable_worker",
+                            "agent_type": "default",
+                            "fork_turns": "none"
+                        })),
+                    ))
+                    .await
+            }
+        }));
+        let (worker_thread_id, created_ack) = created_gate
+            .await
+            .map_err(|_| "private child creation gate closed".to_string())?;
+        let mut driver = PrivateChildLifecycleDriver::start(
+            &manager,
+            worker_thread_id,
+            session.services.agent_control.clone(),
+        )
+        .await?;
+        created_ack
+            .send(())
+            .map_err(|_| "private child creation acknowledgment closed".to_string())?;
+        let worker = manager
+            .get_thread(worker_thread_id)
+            .await
+            .map_err(|error| format!("private worker was not registered: {error}"))?;
+        let ForwardedChildLifecycle::Started {
+            thread_id,
+            turn_id,
+        } = driver.next().await?
+        else {
+            return Err("revocable worker emitted terminal before start".to_string());
+        };
+        if thread_id != worker_thread_id {
+            return Err("revocable worker started on the wrong thread".to_string());
+        }
+        spawn
+            .await
+            .map_err(|error| format!("revocable spawn task did not join: {error}"))?
+            .map_err(|error| format!("revocable spawn failed: {error}"))?;
+        if !matches!(
+            events.recv().await,
+            Some(ChiralityNativeLifecycleEvent::TurnStarted(association))
+                if association.child_thread_id == thread_id
+                    && association.child_turn_id == turn_id
+        ) {
+            return Err("revocable worker association did not use actual IDs".to_string());
+        }
+        let _ = worker
+            .session
+            .input_queue
+            .get_pending_input(&worker.session.active_turn)
+            .await;
+        worker
+            .session
+            .input_queue
+            .defer_mailbox_delivery_to_next_turn(&worker.session.active_turn, &turn_id)
+            .await;
+        let (mut activity, pending) = worker.session.input_queue.subscribe_activity(None).await;
+        if pending.is_some() {
+            return Err("revocation mailbox was not empty before deferred followup".to_string());
+        }
+        let followup = AbortOnDropHandle::new(tokio::spawn({
+            let session = Arc::clone(&session);
+            let turn = Arc::clone(&turn);
+            async move {
+                FollowupTaskHandlerV2
+                    .handle(invocation(
+                        session,
+                        turn,
+                        "followup_task",
+                        function_payload(json!({
+                            "target": thread_id.to_string(),
+                            "message": "must be rejected after revocation",
+                        })),
+                    ))
+                    .await
+            }
+        }));
+        activity
+            .changed()
+            .await
+            .map_err(|_| "revocation mailbox activity stream closed".to_string())?;
+        park_next_regular_turn_before_model(&worker).await;
+        live.store(false, std::sync::atomic::Ordering::SeqCst);
+        worker
+            .session
+            .abort_all_tasks(TurnAbortReason::Interrupted)
+            .await;
+        let ForwardedChildLifecycle::Rejected {
+            thread_id: rejected_thread_id,
+            turn_id: rejected_turn_id,
+            error,
+        } = driver.next().await?
+        else {
+            return Err("revoked family accepted the actual terminal".to_string());
+        };
+        if rejected_thread_id != thread_id
+            || rejected_turn_id != turn_id
+            || !error.contains("authority unavailable")
+        {
+            return Err(format!(
+                "unexpected revoked terminal result: thread={rejected_thread_id}, turn={rejected_turn_id}, error={error}"
+            ));
+        }
+        let followup_result = followup
+            .await
+            .map_err(|error| format!("revoked followup task did not join: {error}"))?;
+        if followup_result.is_ok() {
+            return Err("deferred followup succeeded after authority revocation".to_string());
+        }
+        if timeout(Duration::from_millis(200), driver.observations.recv())
+            .await
+            .is_ok()
+        {
+            return Err("revoked deferred work emitted another child lifecycle event".to_string());
+        }
+        driver.stop().await?;
+        Ok::<(), String>(())
+    })
+    .await
+    .map_err(|_| "revocation phase exceeded its whole-phase timeout".to_string())
+    .and_then(|result| result);
+
+    let shutdown = manager
+        .shutdown_all_threads_bounded(Duration::from_secs(5))
+        .await;
+    phase_result.expect("deferred followup should recheck authority before actual start");
     assert_eq!(shutdown.submit_failed, Vec::<ThreadId>::new());
     assert_eq!(shutdown.timed_out, Vec::<ThreadId>::new());
 }
