(version 1)
(debug deny)
(deny default)
(allow process*)
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow file-read*)
(deny file-read* (subpath "/Users/ryan") (subpath "/private/tmp"))
(allow file-read*
  (subpath "/Users/ryan/.rustup/toolchains/1.97.1-aarch64-apple-darwin")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/source")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/target")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/tmp"))
(allow file-write*
  (literal "/dev/null")
  (literal "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home/.global-cache")
  (literal "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home/.package-cache")
  (literal "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home/.package-cache-mutate")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/target")
  (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/tmp"))
(deny file-write* (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home/git") (subpath "/private/tmp/chirality-supplier-root-directory-fix-20260911-01/cargo-home/registry"))
(deny network*)
(allow file-read-metadata
  (literal "/private/tmp")
  (literal "/private/tmp/chirality-supplier-root-directory-fix-20260911-01")
  (literal "/Users/ryan")
  (literal "/Users/ryan/.rustup")
  (literal "/Users/ryan/.rustup/toolchains"))
