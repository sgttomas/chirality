+    pub async fn revoke_chirality_private_identity_authority(&self) {
+        let mut transition = self.begin_identity_transition().await;
+        let previous_hard_failure = self.joined_identity.lock().ok().and_then(|publisher| {
+            match &publisher.snapshot.qualification {
+                JoinedIdentityQualification::Unavailable { reason }
+                    if matches!(reason.as_str(),
+                        "identity-reconciliation-required"
+                            | "identity-generation-exhausted"
+                            | "unclosed-config-input-owner") => Some(publisher.snapshot.clone()),
+                _ => None,
+            }
+        });
+        transition.mark_mutation_started();
+        if let Ok(mut publisher) = self.joined_identity.lock() {
+            publisher.private_authority_enabled = false;
+            if let Some(mut previous) = previous_hard_failure {
+                if previous.identity_generation != publisher.snapshot.identity_generation {
+                    previous.identity_generation = publisher.snapshot.identity_generation.clone();
