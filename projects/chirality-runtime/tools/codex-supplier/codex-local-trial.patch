+
+async fn write_queued_message(
+    writer: &mut (impl tokio::io::AsyncWrite + Unpin),
+    queued_message: QueuedOutgoingMessage,
+) -> IoResult<()> {
+    let mut serialized = Vec::new();
+    for message in std::iter::once(queued_message.message)
+        .chain(queued_message.following_messages)
+    {
+        let Some(json) = serialize_outgoing_message(message) else {
+            return Ok(());
+        };
+        serialized.extend_from_slice(json.as_bytes());
+        serialized.push(b'\n');
+    }
+    writer.write_all(&serialized).await?;
+    if let Some(write_complete_tx) = queued_message.write_complete_tx {
+        let _ = write_complete_tx.send(());
+    }
     Ok(())
 }
 
