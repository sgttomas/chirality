+    async fn route_chirality_native_communication_owned(
+        self,
+        state: Arc<ThreadManagerState>,
+        agent_id: ThreadId,
+        communication: InterAgentCommunication,
+        context: AgentCommunicationContext,
+        parent_turn_id: Option<String>,
+        root_turn_id: Option<String>,
+        family: Arc<ChiralityNativeFamily>,
+        mut reservation: Option<ChiralityNativeReservation>,
+        mut queued_reply: Option<tokio::sync::oneshot::Sender<CodexResult<String>>>,
+    ) -> CodexResult<String> {
+        let communication_for_log =
+            crate::agent_communication::logging_enabled().then(|| communication.clone());
+        let (admission_tx, admission_rx) = tokio::sync::oneshot::channel();
+        if let Some(reservation) = reservation.as_mut() {
+            let mut ledger = family.state.lock().unwrap_or_else(|p| p.into_inner());
+            if let Some(pending) = ledger.pending.get_mut(&reservation.id) { pending.mailbox = true; }
+            reservation.accepted = true;
+        }
+        let enqueued = state.send_inter_agent_communication_routed(
+            agent_id, communication, parent_turn_id.clone(), root_turn_id.clone(), Some(admission_tx),
+        ).await;
+        let (communication_id, routing_rx) = match enqueued {
+            Ok(enqueued) => enqueued,
+            Err(error) => {
+                // send failed: the operation was not admitted to the queue.
+                if let Some(reservation) = reservation.as_mut() { reservation.accepted = false; }
+                if let Some(reply) = queued_reply.take() { let _ = reply.send(Err(CodexErr::InternalAgentDied)); }
+                return Err(error);
+            }
+        };
+        // Queued inert mail must not keep ThreadManager -> Session -> queue alive.
+        drop(state);
+        if let Some(reply) = queued_reply.take() { let _ = reply.send(Ok(communication_id.clone())); }
+        if let Some(communication) = communication_for_log {
+            crate::agent_communication::emit_agent_communication_send(
+                &communication_id, &context, &communication, agent_id,
+            );
+        }
+        // An inert queue-only item waits here without an executable reservation.
+        // The exact queue item asks for admission only at a real consumption boundary.
+        let (proposed, grant) = admission_rx.await.map_err(|_| CodexErr::InternalAgentDied)?;
+        let admitted = async {
+            // Deferred trigger mail needs the same fresh check as lazy queue-only
+            // admission. An old reservation does not survive authority revocation.
+            if !family.authority_is_live().await {
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest("private mailbox authority unavailable".to_string()));
+            }
+            if !self.chirality_native_family().is_some_and(|current| Arc::ptr_eq(&current, &family)) {
+                return Err(CodexErr::InvalidRequest("private queued mail family replaced".to_string()));
+            }
+            if reservation.is_none() {
+                reservation = self.reserve_chirality_native_submission(
+                    Some(context.sender_thread_id()), parent_turn_id.as_deref(), root_turn_id.as_deref(), Some(agent_id),
+                ).await?;
+            }
+            let active = reservation.as_mut().ok_or_else(|| CodexErr::InvalidRequest("private queued mail admission unavailable".to_string()))?;
+            if !Arc::ptr_eq(&active.family, &family) {
+                return Err(CodexErr::InvalidRequest("private queued mail family changed".to_string()));
+            }
+            let turn_id = match &proposed {
+                TurnInputSubmission::Started { turn_id } | TurnInputSubmission::Steered { turn_id } => turn_id,
+                TurnInputSubmission::NotSubmitted { .. } => return Err(CodexErr::InvalidRequest("private mailbox delivery unavailable".to_string())),
+            };
+            let mut ledger = family.state.lock().unwrap_or_else(|p| p.into_inner());
+            let key = (agent_id, turn_id.clone());
+            if ledger.retired || ledger.settling || ledger.settled || ledger.finished_turns.contains(&key)
+                || (agent_id == family.config.root_thread_id
+                    && (!matches!(proposed, TurnInputSubmission::Steered { .. })
+                        || ledger.root_turn_id.as_deref() != Some(turn_id)))
+            {
+                return Err(CodexErr::InvalidRequest("private mailbox turn admission unavailable".to_string()));
+            }
+            let pending = ledger.pending.get(&active.id).ok_or_else(|| CodexErr::InvalidRequest("private mailbox reservation unavailable".to_string()))?;
+            if matches!(proposed, TurnInputSubmission::Started { .. }) {
+                let mismatched = ledger.associations.get(&key).is_some_and(|association|
+                    association.association.parent_thread_id != pending.parent_thread_id
+                        || association.association.parent_turn_id != pending.parent_turn_id)
+                    || ledger.pending.iter().any(|(id, other)| *id != active.id
+                        && other.target_thread_id == Some(agent_id)
+                        && other.routed_turn_id.as_deref() == Some(turn_id)
+                        && (other.parent_thread_id != pending.parent_thread_id || other.parent_turn_id != pending.parent_turn_id));
+                if mismatched { return Err(CodexErr::InvalidRequest("private coalesced mailbox ancestry mismatch".to_string())); }
+            }
+            let pending = ledger.pending.get_mut(&active.id).unwrap();
+            pending.routed_turn_id = Some(turn_id.clone());
+            pending.mailbox = true;
+            active.accepted = true;
+            Ok(())
+        }.await;
+        if let Err(error) = admitted {
+            // The queue removes rejected mail before it can create or enter a turn.
+            // A preexisting admitted reservation cannot be reported as never submitted.
+            let _ = grant.send(Err(CodexErr::InvalidRequest(error.to_string())));
+            return Err(error);
+        }
+        if grant.send(Ok(())).is_err() {
+            return Err(CodexErr::InternalAgentDied);
+        }
+        let routing = routing_rx.await.unwrap_or(Err(CodexErr::InternalAgentDied))?;
+        self.complete_chirality_native_submission(&mut reservation, agent_id, &routing).await?;
+        Ok(communication_id)
+    }
+
+    pub(crate) async fn chirality_native_turn_started(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+    ) -> CodexResult<()> {
+        let Some(family) = self.chirality_native_family() else {
+            return Ok(());
+        };
+        if !family.authority_is_live().await {
+            family.retire().await;
+            return Err(CodexErr::InvalidRequest(
+                "private native authority unavailable".to_string(),
+            ));
+        }
+        let event = {
+            let mut state = family.state.lock().unwrap_or_else(|poison| poison.into_inner());
+            if state.retired || state.settling || state.settled {
+                return Err(CodexErr::InvalidRequest(
+                    "private native family unavailable".to_string(),
+                ));
+            }
+            if thread_id == family.config.root_thread_id {
+                match state.root_turn_id.as_deref() {
+                    None => state.root_turn_id = Some(turn_id.to_string()),
+                    Some(existing) if existing == turn_id => {}
+                    Some(_) => {
+                        state.retired = true;
+                        return Err(CodexErr::InvalidRequest(
+                            "private native root turn changed while family active".to_string(),
+                        ));
+                    }
+                }
+                None
+            } else if let Some(association) = state
+                .associations
+                .get_mut(&(thread_id, turn_id.to_string()))
+            {
+                if association.announcement == ChiralityNativeAnnouncementState::Awaiting {
+                    association.announcement = ChiralityNativeAnnouncementState::Emitting;
+                    let event = ChiralityNativeLifecycleEvent::TurnStarted(
+                        association.association.clone(),
+                    );
+                    state.lifecycle_writes_inflight += 1;
+                    Some(event)
+                } else {
+                    None
+                }
+            } else {
+                let key = (thread_id, turn_id.to_string());
+                if state.finished_turns.contains(&key)
+                    || !state.pending.values().any(|pending| pending.target_thread_id == Some(thread_id))
+                {
+                    return Err(CodexErr::InvalidRequest("private native child turn was not reserved".to_string()));
+                }
+                state.observed_starts.entry(key).or_insert(None);
+                None
+            }
+        };
+        family.changed.notify_waiters();
+        if let Some(event) = event
+        {
+            let key = match &event {
+                ChiralityNativeLifecycleEvent::TurnStarted(association) => {
+                    (association.child_thread_id, association.child_turn_id.clone())
+                }
+                _ => unreachable!(),
+            };
+            if !family.emit(event.clone()).await {
+                family.event_failed(&event);
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest(
+                    "private native start delivery failed".to_string(),
+                ));
+            }
+            if let Some(association) = family
+                .state
+                .lock()
+                .unwrap_or_else(|poison| poison.into_inner())
+                .associations
+                .get_mut(&key)
+            {
+                association.announcement = ChiralityNativeAnnouncementState::Announced;
+            }
+            family.event_delivered(&event);
+            family.changed.notify_waiters();
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn chirality_native_callback(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+        call_id: &str,
+        tool: &str,
+    ) -> CodexResult<Option<ChiralityNativeTurnAssociation>> {
+        let Some(family) = self.chirality_native_family() else {
+            return Ok(None);
+        };
+        if !family.authority_is_live().await {
+            family.retire().await;
+            return Err(CodexErr::InvalidRequest(
+                "private native authority unavailable".to_string(),
+            ));
+        }
+        let inherited = family.config.inherited_tools.iter().any(|candidate| {
+            matches!(candidate, DynamicToolSpec::Function(function) if function.name == tool)
+        });
+        if !inherited {
+            return Ok(None);
+        }
+        if thread_id == family.config.root_thread_id {
+            return Ok(None);
+        }
+        loop {
+            if !family.authority_is_live().await {
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest(
+                    "private native authority unavailable".to_string(),
+                ));
+            }
+            let notified = family.changed.notified();
+            {
+                let mut state = family.state.lock().unwrap_or_else(|poison| poison.into_inner());
+                if state.retired || state.settling || state.settled {
+                    return Err(CodexErr::InvalidRequest(
+                        "private native association unavailable".to_string(),
+                    ));
+                }
+                let waiting_for_announcement = if let Some(association) = state
+                    .associations
+                    .get_mut(&(thread_id, turn_id.to_string()))
+                {
+                    if association.announcement == ChiralityNativeAnnouncementState::Announced {
+                        if !association.callbacks.insert(call_id.to_string()) {
+                            return Err(CodexErr::InvalidRequest(
+                                "private native callback unavailable".to_string(),
+                            ));
+                        }
+                        return Ok(Some(association.association.clone()));
+                    }
+                    true
+                } else {
+                    false
+                };
+                if !waiting_for_announcement
+                    && !state.observed_starts.contains_key(&(thread_id, turn_id.to_string()))
+                {
+                        return Err(CodexErr::InvalidRequest(
+                            "private native association unavailable".to_string(),
+                        ));
+                }
+            }
+            notified.await;
+        }
+    }
+
+    pub(crate) async fn chirality_native_callback_is_live(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+        call_id: &str,
+    ) -> bool {
+        let Some(family) = self.chirality_native_family() else {
+            return true;
+        };
+        if !family.authority_is_live().await {
+            family.retire().await;
+            return false;
+        }
+        family
+            .state
+            .lock()
+            .unwrap_or_else(|poison| poison.into_inner())
+            .associations
+            .get(&(thread_id, turn_id.to_string()))
+            .is_some_and(|association| association.callbacks.contains(call_id))
+    }
+
+    pub(crate) async fn chirality_native_callback_finished(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+        call_id: &str,
+    ) {
+        let Some(family) = self.chirality_native_family() else {
+            return;
+        };
+        let mut state = family.state.lock().unwrap_or_else(|poison| poison.into_inner());
+        if let Some(association) = state
+            .associations
+            .get_mut(&(thread_id, turn_id.to_string()))
+        {
+            association.callbacks.remove(call_id);
+        }
+        family.changed.notify_waiters();
+    }
+
+    pub(crate) async fn chirality_native_turn_finished(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+        reason: ChiralityNativeTerminalReason,
+    ) -> CodexResult<()> {
+        let Some(family) = self.chirality_native_family() else {
+            return Ok(());
+        };
+        if !family.authority_is_live().await {
+            family.retire().await;
+            return Err(CodexErr::InvalidRequest(
+                "private native authority unavailable".to_string(),
+            ));
+        }
+        let terminal = loop {
+            if !family.authority_is_live().await {
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest(
+                    "private native authority unavailable".to_string(),
+                ));
+            }
+            let notified = family.changed.notified();
+            let result = {
+                let mut state = family.state.lock().unwrap_or_else(|poison| poison.into_inner());
+                if thread_id == family.config.root_thread_id
+                    && state.root_turn_id.as_deref() == Some(turn_id)
+                {
+                    state.primary_finished = true;
+                    (!state.pending.values().any(|pending| {
+                        pending.parent_thread_id == thread_id
+                            && pending.parent_turn_id == turn_id
+                    }) && !state.associations.values().any(|association| {
+                        association.association.parent_thread_id == thread_id
+                            && association.association.parent_turn_id == turn_id
+                            && association.announcement
+                                != ChiralityNativeAnnouncementState::Announced
+                    }))
+                    .then_some(None)
+                } else {
+                    let key = (thread_id, turn_id.to_string());
+                    if !state.associations.contains_key(&key)
+                        && let Some(terminal) = state.observed_starts.get_mut(&key)
+                    {
+                        if terminal.is_some() {
+                            return Err(CodexErr::InvalidRequest("private native terminal already observed".to_string()));
+                        }
+                        *terminal = Some(reason.clone());
+                        family.changed.notify_waiters();
+                        return Ok(());
+                    }
+                    let Some(association) = state.associations.get(&key) else {
+                        return Err(CodexErr::InvalidRequest(
+                            "private native terminal association unavailable".to_string(),
+                        ));
+                    };
+                    if association.announcement != ChiralityNativeAnnouncementState::Announced
+                        || !association.callbacks.is_empty()
+                        || state.pending.values().any(|pending| {
+                            pending.target_thread_id == Some(thread_id)
+                                && (!pending.mailbox || pending.routed_turn_id.as_deref() == Some(turn_id))
+                        })
+                        || state.pending.values().any(|pending| {
+                            pending.parent_thread_id == thread_id
+                                && pending.parent_turn_id == turn_id
+                        })
+                        || state.associations.values().any(|child| {
+                            child.association.parent_thread_id == thread_id
+                                && child.association.parent_turn_id == turn_id
+                                && child.announcement
+                                    != ChiralityNativeAnnouncementState::Announced
+                        })
+                    {
+                        None
+                    } else {
+                        let association = state.associations.remove(&key).unwrap().association;
+                        state.finished_turns.insert(key);
+                        state.lifecycle_writes_inflight += 1;
+                        let terminal = ChiralityNativeLifecycleEvent::TurnFinished {
+                            supplier_generation: association.supplier_generation,
+                            association_id: association.association_id,
+                            child_thread_id: association.child_thread_id,
+                            child_turn_id: association.child_turn_id,
+                            reason: reason.clone(),
+                        };
+                        Some(Some(terminal))
+                    }
+                }
+            };
+            if let Some(result) = result {
+                break result;
+            }
+            notified.await;
+        };
+        family.changed.notify_waiters();
+        if let Some(event) = terminal {
+            if !family.emit(event.clone()).await {
+                family.event_failed(&event);
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest(
+                    "private native terminal delivery failed".to_string(),
+                ));
+            }
+            family.event_delivered(&event);
+        }
+        let settled = {
+            let mut state = family.state.lock().unwrap_or_else(|poison| poison.into_inner());
+            family.settlement_event_locked(&mut state)
+        };
+        if let Some(event) = settled {
+            if !family.emit(event.clone()).await {
+                family.retire().await;
+                return Err(CodexErr::InvalidRequest(
+                    "private native settlement delivery failed".to_string(),
+                ));
+            }
+            family.event_delivered(&event);
+        }
+        Ok(())
     }
 
