+#[test]
+fn identity_admission_fd_claim_precedes_ownership_and_closes_once() {
+    use std::io::Write;
+    use std::os::fd::AsRawFd;
+    use std::os::unix::net::UnixStream;
+    unsafe extern "C" { fn fcntl(fd: i32, command: i32, ...) -> i32; }
+    const F_GETFD: i32 = 1;
+    let (reader, mut writer) = UnixStream::pair().unwrap();
+    writer.write_all(&[9; 32]).unwrap();
+    drop(writer);
+    let fd = reader.as_raw_fd();
+    std::mem::forget(reader);
+    let consumer = SecretConsumer::new();
+    assert!(consume_bootstrap_fd_for_test(&consumer, fd).is_ok());
+    assert_eq!(unsafe { fcntl(fd, F_GETFD) }, -1);
+    let (replacement, _peer) = UnixStream::pair().unwrap();
+    assert_eq!(consume_bootstrap_fd_for_test(&consumer, replacement.as_raw_fd()).err().unwrap().0,
+        "authority-secret-already-consumed");
+    assert_ne!(unsafe { fcntl(replacement.as_raw_fd(), F_GETFD) }, -1,
+        "re-entry must not touch a reused descriptor");
+    assert_eq!(consume_bootstrap_fd_for_test(&SecretConsumer::new(), -1).err().unwrap().0,
+        "authority-secret-missing");
+}
