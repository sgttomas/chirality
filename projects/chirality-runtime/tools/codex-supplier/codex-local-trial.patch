+        let generation = self.identity_generation.load(Ordering::Acquire);
+        let source = self
+            .identity_source
+            .read()
+            .map_err(|_| std::io::Error::other("identity source poisoned"))?
+            .clone();
+        let result = if let Some(source) = source {
+            let view = auth.capture_identity_config_view(
+                guard,
+                source.binding(),
+                Arc::clone(&self.identity_generation),
+            )?;
+            auth.with_identity_config_view(guard, view, Box::pin(future))
+                .await?
+        } else {
