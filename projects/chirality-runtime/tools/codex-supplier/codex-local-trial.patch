+                .is_some()
+            {
+                return Err(std::io::Error::other(
+                    "cloud source belongs to another manager",
+                ));
+            }
+        }
+        self.advance_identity_inputs()?;
+        let source = cloud_config_source(
+            Arc::clone(auth),
+            endpoint.clone(),
+            self.codex_home.clone(),
+            factory,
+        );
+        *self
+            .cloud_config_bundle
+            .write()
+            .map_err(|_| std::io::Error::other("cloud loader poisoned"))? = source.loader();
+        *self
+            .identity_source
+            .write()
+            .map_err(|_| std::io::Error::other("identity source poisoned"))? = Some(source);
+        *self
+            .identity_endpoint
+            .write()
+            .map_err(|_| std::io::Error::other("identity endpoint poisoned"))? = Some(endpoint);
+        *self
+            .identity_owner
+            .write()
+            .map_err(|_| std::io::Error::other("identity owner poisoned"))? =
+            Some(Arc::clone(auth));
+        Ok(())
+    }
