+fn identity_admission_secret_is_once_only_exact_and_zeroized() {
+    let consumer = SecretConsumer::new();
+    let (secret, cleared) = consumer.consume_with_zeroization_probe(Cursor::new([7_u8; 32]));
+    assert!(secret.is_ok() && cleared);
+    assert_eq!(consumer.consume(Cursor::new([7_u8; 32])).err().unwrap().0, "authority-secret-already-consumed");
+    for count in [31, 33] {
+        assert_eq!(SecretConsumer::new().consume(Cursor::new(vec![0; count])).err().unwrap().0, "authority-secret-length-invalid");
+    }
+    struct Broken;
+    impl Read for Broken { fn read(&mut self, _: &mut [u8]) -> io::Result<usize> { Err(io::Error::other("redacted")) } }
+    assert_eq!(SecretConsumer::new().consume(Broken).err().unwrap().0, "authority-secret-read-failed");
