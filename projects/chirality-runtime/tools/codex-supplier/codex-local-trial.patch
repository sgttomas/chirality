+}
+
+#[derive(Clone)]
+struct DirectionState {
+    next: Option<Sequence20>,
+    previous: String,
+    last: Option<Sequence20>,
+}
+
+impl DirectionState {
+    fn new() -> Self {
+        Self {
+            next: Some(Sequence20(FIRST_SEQUENCE.to_owned())),
+            previous: ZERO_TRANSCRIPT_MAC.to_owned(),
+            last: None,
+        }
+    }
+
+    fn advance(&mut self, envelope: &AuthorityEnvelope) {
+        self.previous = envelope.transcript_mac.clone();
+        self.last = Some(envelope.sequence.clone());
+        self.next = envelope.sequence.next().ok();
+    }
+
+    fn can_emit(&self, count: usize) -> bool {
+        let mut next = self.next.clone();
+        for _ in 0..count {
+            let Some(sequence) = next else {
+                return false;
+            };
+            next = sequence.next().ok();
+        }
+        true
+    }
+}
