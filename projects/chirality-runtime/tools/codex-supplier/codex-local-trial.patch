+fn effective_identity_policy_digest(
+    policy: &ManagedAuthPolicy,
+    forced: Option<ForcedLoginMethod>,
+    workspaces: Option<&[String]>,
+) -> String {
+    let methods = policy.allowed_login_methods(forced, workspaces);
+    let mut effective_workspaces = policy.effective_chatgpt_workspaces(workspaces);
+    if let Some(workspaces) = &mut effective_workspaces {
+        workspaces.sort();
+        workspaces.dedup();
+    }
+    format!(
+        "{:x}",
+        Sha256::digest(
+            serde_json::to_vec(&(methods, effective_workspaces)).expect("policy serialization")
+        )
+    )
+}
+
+impl JoinedIdentityPublisher {
+    fn new(auth: Option<&CodexAuth>, forced_workspaces: Option<&[String]>) -> Self {
+        let publisher_id = NEXT_JOINED_IDENTITY_PUBLISHER_ID.fetch_add(1, Ordering::Relaxed);
+        let mut publisher = Self {
+            publisher_id,
+            generation: 0,
+            principal_epoch: u64::from(auth.is_some()),
+            unclosed_config_owner: false,
+            policy_digest: effective_identity_policy_digest(
+                &ManagedAuthPolicy::default(),
+                None,
+                forced_workspaces,
+            ),
+            selected_provider: None,
+            provider_available: false,
+            private_provider_eligible: false,
+            private_authority_enabled: false,
+            forced_login_method: None,
+            managed_auth_policy: ManagedAuthPolicy::default(),
+            snapshot: JoinedIdentitySnapshot {
+                identity_generation: String::new(),
+                snapshot_digest: String::new(),
+                principal_kind: String::new(),
+                principal_id: None,
+                selected_workspace_id: None,
+                forced_chatgpt_workspace_ids: None,
+                selected_provider: None,
+                provider_available: false,
+                qualification: JoinedIdentityQualification::Unavailable {
+                    reason: String::new(),
+                },
+            },
+        };
+        publisher.snapshot = publisher.build_snapshot(auth, forced_workspaces);
+        publisher
+    }
+
+    fn build_snapshot(
+        &self,
+        auth: Option<&CodexAuth>,
+        forced_workspaces: Option<&[String]>,
+    ) -> JoinedIdentitySnapshot {
+        let (principal_kind, principal_id, auth_workspace_id, reason) = match auth {
+            None => ("none", None, None, "unauthenticated"),
+            Some(auth) => match auth.api_auth_mode() {
+                AuthMode::Chatgpt => (
+                    "chatgpt",
+                    auth.get_chatgpt_user_id(),
+                    auth.get_account_id(),
+                    "provider-qualification-pending",
+                ),
+                AuthMode::ApiKey => ("api-key", None, None, "api-key-identity-unsupported"),
+                AuthMode::ChatgptAuthTokens => (
+                    "external-chatgpt-tokens",
+                    auth.get_chatgpt_user_id(),
+                    auth.get_account_id(),
+                    "external-token-identity-unsupported",
+                ),
+                AuthMode::Headers => ("headers", None, None, "header-identity-unsupported"),
+                AuthMode::AgentIdentity => (
+                    "agent-identity",
+                    auth.get_chatgpt_user_id(),
+                    auth.get_account_id(),
+                    "agent-identity-qualification-pending",
+                ),
+                AuthMode::PersonalAccessToken => (
+                    "personal-access-token",
+                    auth.get_chatgpt_user_id(),
+                    auth.get_account_id(),
+                    "personal-access-token-identity-unsupported",
+                ),
+                AuthMode::BedrockApiKey => (
+                    "bedrock-api-key",
+                    None,
+                    None,
+                    "bedrock-identity-unsupported",
+                ),
+            },
+        };
+        // Workspace policy is a set. Canonicalize it before selecting a workspace or
+        // hashing the joined state so order-only and duplicate-only config rewrites
+        // cannot manufacture a new identity generation.
+        let forced_chatgpt_workspace_ids = forced_workspaces.map(|workspaces| {
+            let mut workspaces = workspaces.to_vec();
+            workspaces.sort();
+            workspaces.dedup();
+            workspaces
+        });
+        // The selected workspace is an authenticated principal claim. The
+        // forced list is an independent policy constraint and never substitutes
+        // for, or erases, the selected account.
+        let selected_workspace_id = auth_workspace_id;
+        let method_allowed = self.managed_auth_policy.allows_login_method(
+            ForcedLoginMethod::Chatgpt,
+            self.forced_login_method,
+            forced_chatgpt_workspace_ids.as_deref(),
+        );
+        let workspace_allowed = selected_workspace_id.as_ref().is_some_and(|workspace| {
+            self.managed_auth_policy
+                .effective_chatgpt_workspaces(forced_chatgpt_workspace_ids.as_deref())
+                .is_none_or(|allowed| allowed.contains(workspace))
+        });
+        let private_qualified = !self.unclosed_config_owner
+            && self.private_authority_enabled
+            && self.private_provider_eligible
+            && self.selected_provider.as_deref() == Some("openai")
+            && principal_kind == "chatgpt"
+            && principal_id.is_some()
+            && workspace_allowed
+            && method_allowed;
+        let reason = if self.unclosed_config_owner {
+            "unclosed-config-input-owner"
+        } else if reason == "provider-qualification-pending" && self.private_authority_enabled {
+            if !self.private_provider_eligible {
+                "private-provider-unsupported"
+            } else if !method_allowed {
+                "private-login-method-disallowed"
+            } else if !workspace_allowed {
+                "private-workspace-disallowed"
+            } else if principal_id.is_none() {
+                "private-principal-missing"
+            } else {
+                reason
+            }
+        } else {
+            reason
+        };
+        let provider_available = self.provider_available || private_qualified;
+        let digest_qualification = if private_qualified { "qualified" } else { reason };
+        let mut digest_input = Vec::new();
+        for value in [
+            principal_kind,
+            principal_id.as_deref().unwrap_or(""),
+            selected_workspace_id.as_deref().unwrap_or(""),
+            self.selected_provider.as_deref().unwrap_or(""),
+            if provider_available {
+                "available"
+            } else {
+                "unavailable"
+            },
+            digest_qualification,
+        ] {
+            digest_input.extend_from_slice(value.len().to_string().as_bytes());
+            digest_input.push(b':');
+            digest_input.extend_from_slice(value.as_bytes());
+            digest_input.push(b'|');
+        }
+        digest_input.extend_from_slice(self.principal_epoch.to_string().as_bytes());
+        digest_input.extend_from_slice(if self.private_authority_enabled {
+            b"|private-authority:enabled"
+        } else {
+            b"|private-authority:disabled"
+        });
+        digest_input.extend_from_slice(if self.private_provider_eligible {
+            b"|private-provider:eligible"
+        } else {
+            b"|private-provider:ineligible"
+        });
+        digest_input.extend_from_slice(b"|effective-policy:");
+        digest_input.extend_from_slice(self.policy_digest.as_bytes());
+        match forced_chatgpt_workspace_ids.as_deref() {
+            None => digest_input.extend_from_slice(b"|workspaces:none"),
+            Some(workspaces) => {
+                digest_input.extend_from_slice(b"|workspaces:some");
+                for workspace in workspaces {
+                    digest_input.push(b'|');
+                    digest_input.extend_from_slice(workspace.len().to_string().as_bytes());
+                    digest_input.push(b':');
+                    digest_input.extend_from_slice(workspace.as_bytes());
+                }
+            }
+        }
+        let snapshot_digest = format!("{:x}", Sha256::digest(digest_input));
+        JoinedIdentitySnapshot {
+            identity_generation: format!("j{}g{}", self.publisher_id, self.generation),
+            snapshot_digest,
+            principal_kind: principal_kind.to_string(),
+            principal_id: principal_id.clone(),
+            selected_workspace_id,
+            forced_chatgpt_workspace_ids,
+            selected_provider: self.selected_provider.clone(),
+            provider_available,
+            qualification: if private_qualified {
+                JoinedIdentityQualification::Qualified {
+                    principal_id: principal_id.expect("qualified principal"),
+                    provider_id: "openai".to_string(),
+                }
+            } else {
+                JoinedIdentityQualification::Unavailable {
+                    reason: reason.to_string(),
+                }
+            },
+        }
+    }
+
+    fn publish(
+        &mut self,
+        auth: Option<&CodexAuth>,
+        forced_workspaces: Option<&[String]>,
+        principal_changed: bool,
+    ) -> Option<JoinedIdentitySnapshot> {
+        if matches!(&self.snapshot.qualification, JoinedIdentityQualification::Unavailable { reason } if reason == "identity-generation-exhausted")
+        {
+            return None;
+        }
+        if principal_changed {
+            let Some(next) = self.principal_epoch.checked_add(1) else {
+                self.require_exhaustion();
+                return Some(self.snapshot.clone());
+            };
+            self.principal_epoch = next;
+        }
+        let candidate = self.build_snapshot(auth, forced_workspaces);
+        if candidate.snapshot_digest == self.snapshot.snapshot_digest {
+            return None;
+        }
+        let Some(next) = self.generation.checked_add(1) else {
+            self.require_exhaustion();
+            return Some(self.snapshot.clone());
+        };
+        self.generation = next;
+        self.snapshot = self.build_snapshot(auth, forced_workspaces);
+        Some(self.snapshot.clone())
+    }
+
+    fn mark_pending(&mut self) -> JoinedIdentitySnapshot {
+        let previous = self.snapshot.clone();
+        let mut pending = previous.clone();
+        pending.qualification = JoinedIdentityQualification::Unavailable {
+            reason: "identity-transition-pending".to_string(),
+        };
+        pending.snapshot_digest = format!(
+            "{:x}",
+            Sha256::digest(format!("{}|pending", previous.snapshot_digest).as_bytes())
+        );
+        self.snapshot = pending;
+        previous
+    }
+
+    fn restore(&mut self, previous: JoinedIdentitySnapshot) {
+        self.snapshot = previous;
+    }
+
+    fn require_reconciliation(&mut self) {
+        let Some(next) = self.generation.checked_add(1) else {
+            self.require_exhaustion();
+            return;
+        };
+        self.generation = next;
+        self.snapshot.identity_generation = format!("j{}g{}", self.publisher_id, self.generation);
+        self.snapshot.qualification = JoinedIdentityQualification::Unavailable {
+            reason: "identity-reconciliation-required".to_string(),
+        };
+        self.snapshot.snapshot_digest = format!(
+            "{:x}",
+            Sha256::digest(format!("{}|reconciliation", self.snapshot.snapshot_digest).as_bytes())
+        );
+    }
+
+    fn require_exhaustion(&mut self) {
+        self.snapshot.qualification = JoinedIdentityQualification::Unavailable {
+            reason: "identity-generation-exhausted".to_string(),
+        };
+        self.snapshot.snapshot_digest = format!(
+            "{:x}",
+            Sha256::digest(format!("{}|exhausted", self.snapshot.snapshot_digest).as_bytes())
+        );
+    }
+}
 
