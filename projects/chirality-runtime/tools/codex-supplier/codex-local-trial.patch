+fn chirality_native_server_notification(event: ChiralityNativeLifecycleEvent) -> ServerNotification {
+    match event {
+        ChiralityNativeLifecycleEvent::TurnStarted(event) => {
+            let selected_role = match event.selected_role {
+                CoreChiralityNativeSelectedRole::Configured { name, basis_digest } => {
+                    ChiralityNativeChildSelectedRole::Configured { name, basis_digest }
+                }
+                CoreChiralityNativeSelectedRole::Upstream => {
+                    ChiralityNativeChildSelectedRole::Upstream
+                }
+            };
+            ServerNotification::ChiralityNativeChildTurnStarted(
+                ChiralityNativeChildTurnStartedNotification {
+                    schema: "chirality-native-child-association/v1".to_string(),
+                    supplier_generation: event.supplier_generation,
+                    association_id: event.association_id,
+                    parent_thread_id: event.parent_thread_id.to_string(),
+                    parent_turn_id: event.parent_turn_id,
+                    child_thread_id: event.child_thread_id.to_string(),
+                    child_turn_id: event.child_turn_id,
+                    selected_role,
+                    inherited_tools_digest: event.inherited_tools_digest,
+                },
+            )
+        }
+        ChiralityNativeLifecycleEvent::TurnFinished {
+            supplier_generation,
+            association_id,
+            child_thread_id,
+            child_turn_id,
+            reason,
+        } => ServerNotification::ChiralityNativeChildTurnFinished(
+            ChiralityNativeChildTurnFinishedNotification {
+                schema: "chirality-native-child-terminal/v1".to_string(),
+                supplier_generation,
+                association_id,
+                child_thread_id: child_thread_id.to_string(),
+                child_turn_id,
+                reason: match reason {
+                    CoreChiralityNativeTerminalReason::Completed => {
+                        ChiralityNativeChildTerminalReason::Completed
+                    }
+                    CoreChiralityNativeTerminalReason::Cancelled => {
+                        ChiralityNativeChildTerminalReason::Cancelled
+                    }
+                    CoreChiralityNativeTerminalReason::Failed => {
+                        ChiralityNativeChildTerminalReason::Failed
+                    }
+                },
+            },
+        ),
+        ChiralityNativeLifecycleEvent::FamilySettled {
+            supplier_generation,
+            root_thread_id,
+            root_turn_id,
+        } => ServerNotification::ChiralityNativeChildFamilySettled(
+            ChiralityNativeChildFamilySettledNotification {
+                schema: "chirality-native-family-settled/v1".to_string(),
+                supplier_generation,
+                root_thread_id: root_thread_id.to_string(),
+                root_turn_id,
+            },
+        ),
+    }
