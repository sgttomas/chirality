+    #[cfg(test)]
+    pub(crate) fn state_for_test(&self) -> (bool, bool) {
+        self.authority
+            .as_ref()
+            .map(|authority| (authority.state.closed, authority.state.lease.is_some()))
+            .unwrap_or((true, false))
