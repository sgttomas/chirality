+    if !matches!(request.method.as_str(), "thread/start" | "thread/resume") {
+        return Err(invalid_request("Private native tools carrier unavailable"));
+    }
+    let carrier = serde_json::from_value::<
+        codex_app_server_protocol::ChiralityNativeToolsCarrier,
+    >(value)
+    .map_err(|_| invalid_request("Private native tools carrier unavailable"))?;
+    if carrier.schema != codex_app_server_protocol::CHIRALITY_NATIVE_TOOLS_SCHEMA {
+        return Err(invalid_request("Private native tools carrier unavailable"));
+    }
+    codex_app_server_protocol::validate_chirality_inheritable_tools(&carrier.inheritable_tools)
+        .map_err(|_| invalid_request("Private native tools carrier unavailable"))?;
+    Ok(Some(carrier))
