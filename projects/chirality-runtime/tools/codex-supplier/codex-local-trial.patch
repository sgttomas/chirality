+
+/// The real single/batch mutation boundary. The supplied future remains lazy until fenced.
+async fn run_identity_config_write<F, Fut>(
+    auth_manager: &Arc<codex_login::AuthManager>,
+    config_manager: &ConfigManager,
+    outgoing: &OutgoingMessageSender,
+    request_id: ConnectionRequestId,
+    write: F,
+) where
+    F: FnOnce() -> Fut,
+    Fut: std::future::Future<Output = Result<ClientResponsePayload, JSONRPCErrorError>>,
+{
+    if !config_manager.serialized_identity() {
+        // Public in-process callbacks may reenter this manager. Never hold the aggregate gate.
+        let result = write().await;
+        outgoing.send_identity_result(request_id, result).await;
+        return;
+    }
+    let mut transition = auth_manager.begin_identity_transition().await;
+    transition.defer_publication();
+    transition.mark_mutation_started();
+    let mut result = config_manager
+        .with_identity_config(auth_manager, &transition, write())
+        .await
+        .unwrap_or_else(|_| Err(internal_error("identity config source unavailable")));
+    if result
+        .as_ref()
+        .err()
+        .is_some_and(config_error_proves_no_write)
+    {
+        transition.finish_current_mutation_without_change();
+    } else {
+        let reconciled = config_manager
+            .reconcile_identity_state(auth_manager, &mut transition, None)
+            .await
+            .map_err(|_| internal_error("failed to reconcile effective identity config"));
+        if let Err(error) = reconciled {
+            result = Err(error);
+        }
+    }
+    transition.begin_output();
+    let enqueued = outgoing.send_identity_result(request_id, result).await;
+    transition.record_output_result(enqueued);
+}
+
+fn identity_affecting_config_key(key_path: &str) -> bool {
+    matches!(
+        key_path,
+        "model_provider"
+            | "forced_chatgpt_workspace_id"
+            | "forced_login_method"
+            | "managed_auth_policy"
+            | "profile"
+            | "profiles"
+            | "model_providers"
+            | "chatgpt_base_url"
+    ) || ["managed_auth_policy.", "model_providers.", "profiles."]
+        .iter()
+        .any(|prefix| key_path.starts_with(prefix))
+}
+
+fn config_error_proves_no_write(error: &JSONRPCErrorError) -> bool {
+    let expected = serde_json::to_value(ConfigWriteErrorCode::ConfigVersionConflict).ok();
+    error
+        .data
+        .as_ref()
+        .and_then(|data| data.get("config_write_error_code"))
+        == expected.as_ref()
 }
 
