+fn classify_private_method(payload: &str) -> PrivateMethodClassification {
+    let state = RefCell::new(PrivateProbeState::default());
+    let mut deserializer = serde_json::Deserializer::from_str(payload);
+    let parsed = PrivateProbeSeed(&state)
+        .deserialize(&mut deserializer)
+        .and_then(|()| deserializer.end());
+    let state = state.into_inner();
+    let contract_claim = state.contracts.iter().any(|value| {
+        value.as_deref().is_some_and(|value| {
+            value.starts_with("chirality-local-supplier-admission-authority/")
+        })
+    });
+    let operation_claim = state.body_ops.iter().any(|value| {
+        value
+            .as_deref()
+            .is_some_and(|value| value.starts_with("chirality/"))
+    });
+    let legacy_claim = state.legacy_methods.iter().any(|value| {
+        value
+            .as_deref()
+            .is_some_and(|value| value.starts_with("chirality/"))
+    });
+    let private_jsonrpc_method_claim = state.legacy_methods.iter().any(|value| {
+        value.as_deref() == Some("account/identitySnapshot")
+            || (value.as_deref() == Some("initialize")
+                && state.private_initialize_carriers > 0)
+    });
+    let private_jsonrpc_claim = private_jsonrpc_method_claim
+        || state.private_initialize_carriers > 0
+        || state.native_tools_carriers > 0;
+    let claims_private = contract_claim || operation_claim || legacy_claim || private_jsonrpc_claim;
+    if parsed.is_err() {
+        return if claims_private {
+            PrivateMethodClassification::Reject
+        } else {
+            PrivateMethodClassification::Public
+        };
+    }
+    if private_jsonrpc_claim {
+        if state.native_tools_carriers > 0 {
+            let exact_native_method = matches!(
+                state.legacy_methods.as_slice(),
+                [Some(method)] if method == "thread/start" || method == "thread/resume"
+            );
+            return if exact_native_method
+                && state.native_tools_carriers == 1
+                && state.private_initialize_carriers == 0
+                && !state.duplicate_private_params
+            {
+                PrivateMethodClassification::Public
+            } else {
+                PrivateMethodClassification::Reject
+            };
+        }
+        return if state.legacy_methods.len() == 1
+            && !state.duplicate_private_params
+            && state.private_initialize_carriers <= 1
+        {
+            PrivateMethodClassification::Public
+        } else {
+            PrivateMethodClassification::Reject
+        };
+    }
+    if legacy_claim {
+        return PrivateMethodClassification::Reject;
+    }
+    let exact_operation = matches!(
+        state.body_ops.as_slice(),
+        [Some(operation)]
+            if matches!(
+                operation.as_str(),
+                "chirality/admissionAcquire"
+                    | "chirality/admissionRelease"
+                    | "chirality/admissionAbort"
+            )
+    );
+    let exact_contract = matches!(
+        state.contracts.as_slice(),
+        [Some(contract)] if contract == PRIVATE_AUTHORITY_CONTRACT
+    );
+    if exact_contract && state.body_count == 1 && exact_operation {
+        PrivateMethodClassification::Private
+    } else if claims_private {
+        PrivateMethodClassification::Reject
+    } else {
+        PrivateMethodClassification::Public
     }
 }
 
