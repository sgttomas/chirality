+fn external_chatgpt_identity(user_id: &str, workspace_id: &str, nonce: &str) -> CodexAuth {
+    let header = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(br#"{"alg":"none"}"#);
+    let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(
+        serde_json::to_vec(&json!({
+            "https://api.openai.com/auth": {
+                "chatgpt_user_id": user_id,
+                "chatgpt_account_id": workspace_id,
+                "chatgpt_plan_type": "business"
+            },
+            "nonce": nonce
+        }))
+        .expect("identity payload"),
+    );
+    let token = format!("{header}.{payload}.sig");
+    CodexAuth::from_external_chatgpt_tokens(&token, workspace_id, Some("business"))
+        .expect("external ChatGPT identity")
+}
