+#[derive(Clone, Debug, Eq, PartialEq)]
+enum ForwardedChildLifecycle {
+    Started {
+        thread_id: ThreadId,
+        turn_id: String,
+    },
+    Finished {
+        thread_id: ThreadId,
+        turn_id: String,
+        reason: ChiralityNativeTerminalReason,
+    },
+    Rejected {
+        thread_id: ThreadId,
+        turn_id: String,
+        error: String,
+    },
+}
+
+/// Core-only analogue of App Server's lifecycle forwarding for private-family tests.
+///
+/// The pending startup prewarm keeps the real regular task parked immediately after
+/// `TurnStarted`, so the fixture can observe or abort it without making a model request.
+/// The driver forwards only lifecycle messages and deliberately leaves request/writer
+/// qualification to the existing App Server tests.
+struct PrivateChildLifecycleDriver {
+    thread_id: ThreadId,
+    observations: mpsc::UnboundedReceiver<ForwardedChildLifecycle>,
+    cancel: CancellationToken,
+    task: AbortOnDropHandle<()>,
+}
+
+async fn park_next_regular_turn_before_model(thread: &Arc<crate::CodexThread>) {
+    let blocked_prewarm = tokio::spawn(async {
+        std::future::pending::<codex_protocol::error::Result<ModelClientSession>>().await
+    });
+    thread
+        .session
+        .set_session_startup_prewarm(SessionStartupPrewarmHandle::new(
+            blocked_prewarm,
+            std::time::Instant::now(),
+            // This exceeds the process-level 300-second test bound, so the hold cannot
+            // expire into model work during the fixture.
+            Duration::from_secs(600),
+        ))
+        .await;
+}
+
+impl PrivateChildLifecycleDriver {
+    async fn start(
+        manager: &ThreadManager,
+        thread_id: ThreadId,
+        control: AgentControl,
+    ) -> Result<Self, String> {
+        let thread = manager
+            .get_thread(thread_id)
+            .await
+            .map_err(|error| format!("private child was not registered: {error}"))?;
+
+        park_next_regular_turn_before_model(&thread).await;
+
+        let cancel = CancellationToken::new();
+        let cancel_for_task = cancel.clone();
+        let (observations_tx, observations) = mpsc::unbounded_channel();
+        let task = AbortOnDropHandle::new(tokio::spawn(async move {
+            loop {
+                let event = tokio::select! {
+                    _ = cancel_for_task.cancelled() => break,
+                    event = thread.next_event() => match event {
+                        Ok(event) => event,
+                        Err(_) => break,
+                    },
+                };
+                let forwarded = match event.msg {
+                    EventMsg::TurnStarted(started) => {
+                        let turn_id = started.turn_id;
+                        control
+                            .chirality_native_turn_started(thread_id, &turn_id)
+                            .await
+                            .expect("actual private child start should be admitted");
+                        ForwardedChildLifecycle::Started { thread_id, turn_id }
+                    }
+                    EventMsg::TurnComplete(_) => {
+                        let turn_id = event.id;
+                        control
+                            .chirality_native_turn_finished(
+                                thread_id,
+                                &turn_id,
+                                ChiralityNativeTerminalReason::Completed,
+                            )
+                            .await
+                            .expect("actual private child completion should be admitted");
+                        ForwardedChildLifecycle::Finished {
+                            thread_id,
+                            turn_id,
+                            reason: ChiralityNativeTerminalReason::Completed,
+                        }
+                    }
+                    EventMsg::TurnAborted(_) => {
+                        let turn_id = event.id;
+                        match control
+                            .chirality_native_turn_finished(
+                                thread_id,
+                                &turn_id,
+                                ChiralityNativeTerminalReason::Cancelled,
+                            )
+                            .await
+                        {
+                            Ok(()) => ForwardedChildLifecycle::Finished {
+                                thread_id,
+                                turn_id,
+                                reason: ChiralityNativeTerminalReason::Cancelled,
+                            },
+                            Err(error) => ForwardedChildLifecycle::Rejected {
+                                thread_id,
+                                turn_id,
+                                error: error.to_string(),
+                            },
+                        }
+                    }
+                    _ => continue,
+                };
+                if observations_tx.send(forwarded).is_err() {
+                    break;
+                }
+            }
+        }));
+
+        Ok(Self {
+            thread_id,
+            observations,
+            cancel,
+            task,
+        })
+    }
+
+    async fn next(&mut self) -> Result<ForwardedChildLifecycle, String> {
+        timeout(Duration::from_secs(5), self.observations.recv())
+            .await
+            .map_err(|_| "private child lifecycle phase stalled".to_string())?
+            .ok_or_else(|| "private child lifecycle driver closed".to_string())
+    }
+
+    async fn stop(self) -> Result<(), String> {
+        self.cancel.cancel();
+        timeout(Duration::from_secs(5), self.task)
+            .await
+            .map_err(|_| "private child lifecycle driver did not stop".to_string())?
+            .map_err(|error| format!("private child lifecycle driver did not join: {error}"))
+    }
 }
 
