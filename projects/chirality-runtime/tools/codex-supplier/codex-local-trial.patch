+pub(crate) fn current_identity_binding(
+    auth_manager: &AuthManager,
+    supplier_generation: &str,
+) -> Option<IdentityBinding> {
+    let snapshot = auth_manager.joined_identity_snapshot();
+    let JoinedIdentityQualification::Qualified {
+        principal_id,
+        provider_id,
+    } = snapshot.qualification
+    else {
+        return None;
+    };
+    if provider_id != "openai" {
+        return None;
+    }
+    let provider_workspace_id = snapshot.selected_workspace_id?;
+    if [
+        supplier_generation,
+        snapshot.identity_generation.as_str(),
+        principal_id.as_str(),
+        provider_workspace_id.as_str(),
+    ]
+    .into_iter()
+    .any(|value| !is_wire_value(value))
+    {
+        return None;
+    }
+    let response = ChiralityIdentitySnapshotResponse {
+        schema: "chirality-supplier-account-identity-response/1".to_string(),
+        state: "available".to_string(),
+        supplier_generation: supplier_generation.to_string(),
+        identity_generation: snapshot.identity_generation,
+        account_user_id: principal_id,
+        provider_workspace_id,
+    };
+    let encoded = serde_json::to_vec(&response).ok()?;
+    Some(IdentityBinding {
+        identity_generation: response.identity_generation,
+        snapshot_digest: format!("{:x}", Sha256::digest(encoded)),
+    })
+}
