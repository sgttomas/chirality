+fn validate_native_tools_carrier_matches_root(
+    carrier: &ChiralityNativeToolsCarrier,
+    root_tools: &[DynamicToolSpec],
+) -> Result<(), String> {
+    for inherited in &carrier.inheritable_tools {
+        let matches = root_tools.iter().filter(|tool| match tool {
+            DynamicToolSpec::Function(function) => {
+                function.name == inherited.name
+                    && function.description == inherited.description
+                    && function.input_schema == inherited.input_schema
+            }
+            DynamicToolSpec::Namespace(_) => false,
+        });
+        if matches.count() != 1 {
+            return Err(format!(
+                "private inheritable tool does not exactly match a root dynamic tool: {}",
+                inherited.name
+            ));
+        }
+    }
+    Ok(())
+}
