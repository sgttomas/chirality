+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+#[serde(transparent)]
+pub(crate) struct Sequence20(pub(crate) String);
+
+impl Sequence20 {
+    pub(crate) fn parse(value: &Value) -> Result<Self, ProtocolError> {
+        let value = value.as_str().ok_or(ProtocolError("sequence-invalid"))?;
+        if value.len() != 20 || !value.bytes().all(|b| b.is_ascii_digit()) {
+            return Err(ProtocolError("sequence-invalid"));
+        }
+        let number = value.parse::<u64>().map_err(|_| ProtocolError("sequence-invalid"))?;
+        if number == 0 {
+            return Err(ProtocolError("sequence-invalid"));
+        }
+        Ok(Self(value.to_owned()))
+    }
+
+    pub(crate) fn number(&self) -> Result<u64, ProtocolError> {
+        Self::parse(&Value::String(self.0.clone()))?
+            .0
+            .parse()
+            .map_err(|_| ProtocolError("sequence-invalid"))
+    }
+
+    pub(crate) fn next(&self) -> Result<Self, ProtocolError> {
+        let next = self
+            .number()?
+            .checked_add(1)
+            .ok_or(ProtocolError("sequence-invalid"))?;
+        Ok(Self(format!("{next:020}")))
+    }
+}
