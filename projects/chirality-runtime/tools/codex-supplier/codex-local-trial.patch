+    session: &ConnectionSessionState,
+    outbound_initialized: Option<&AtomicBool>,
+) -> Result<Option<bool>, JSONRPCErrorError> {
+    let delivery_guard = AdmissionDeliveryGuard::new(admission);
+    let private_enable = auth_manager
+        .begin_chirality_private_identity_authority_enable()
+        .await
+        .map_err(|_| invalid_request("Private initialization unavailable"))?;
+    let outcome = initialize_processor
+        .initialize(
+            connection_id,
+            request_id,
+            params,
+            Some(response),
+            session,
+            outbound_initialized,
+        )
+        .await?;
+    let Some(private_session) = outcome.private_session else {
+        return Ok(None);
+    };
+    if private_enable
+        .commit_after_delivery_with(|| {
+            if session.initialize(private_session).is_err() {
+                return false;
+            }
+            session.mark_private_initialized();
+            if outcome.private_outbound_initialized
+                && let Some(outbound_initialized) = outbound_initialized
