+/// Owns only the cloud request's authorization and cache identity. No live auth aliases.
+/// Never serialize this type or use its request carrier as a principal snapshot.
+pub struct OwnedCloudAuthorization {
+    user: Option<String>,
+    account: Option<String>,
+    material: CloudRequestMaterial,
+}
+enum CloudRequestMaterial {
+    Ineligible,
+    Bearer { token: String, fedramp: bool },
+    Agent(AgentIdentityAuthRecord),
+}
+impl Debug for OwnedCloudAuthorization {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("OwnedCloudAuthorization(<redacted>)")
+    }
+}
+impl OwnedCloudAuthorization {
+    pub fn eligible(&self) -> bool {
+        !matches!(self.material, CloudRequestMaterial::Ineligible)
+    }
+    pub fn identity(&self) -> (Option<&str>, Option<&str>) {
+        (self.user.as_deref(), self.account.as_deref())
+    }
+    pub fn request_auth(&self) -> std::io::Result<CodexAuth> {
+        let (authorization, fedramp) = match &self.material {
+            CloudRequestMaterial::Ineligible => return Err(identity_view_error()),
+            CloudRequestMaterial::Bearer { token, fedramp } => {
+                (format!("Bearer {token}"), *fedramp)
+            }
+            CloudRequestMaterial::Agent(record) => (
+                codex_agent_identity::authorization_header_for_agent_task(
+                    codex_agent_identity::AgentIdentityKey {
+                        agent_runtime_id: &record.agent_runtime_id,
+                        private_key_pkcs8_base64: &record.agent_private_key,
+                    },
+                    record.task_id.as_deref().ok_or_else(identity_view_error)?,
+                )
+                .map_err(|_| identity_view_error())?,
+                record.chatgpt_account_is_fedramp,
+            ),
+        };
+        let mut headers = http::HeaderMap::new();
+        let mut value =
+            http::HeaderValue::from_str(&authorization).map_err(|_| identity_view_error())?;
+        value.set_sensitive(true);
+        headers.insert(http::header::AUTHORIZATION, value);
+        if let Some(account) = &self.account {
+            headers.insert(
+                "ChatGPT-Account-ID",
+                http::HeaderValue::from_str(account).map_err(|_| identity_view_error())?,
+            );
+        }
+        if fedramp {
+            headers.insert("X-OpenAI-Fedramp", http::HeaderValue::from_static("true"));
+        }
+        Ok(CodexAuth::Headers(AuthHeaders::new(headers)))
+    }
+    fn capture(auth: Option<&CodexAuth>) -> std::io::Result<Self> {
+        let mut result = Self {
+            user: None,
+            account: None,
+            material: CloudRequestMaterial::Ineligible,
+        };
+        let Some(auth) = auth else {
+            return Ok(result);
+        };
+        let allowed_plan = |plan: AccountPlanType| {
+            plan.is_business_like()
+                || plan.is_education_like()
+                || plan == AccountPlanType::Enterprise
+        };
+        match auth {
+            CodexAuth::Chatgpt(_) | CodexAuth::ChatgptAuthTokens(_) => {
+                // One state-lock read: all identity and credential fields come from this value.
+                let Some(tokens) = auth.get_current_auth_json().and_then(|value| value.tokens)
+                else {
+                    return Err(identity_view_error());
+                };
+                let plan = tokens
+                    .id_token
+                    .chatgpt_plan_type
+                    .clone()
+                    .map(AccountPlanType::from)
+                    .unwrap_or(AccountPlanType::Unknown);
+                if allowed_plan(plan) {
+                    result.user = tokens.id_token.chatgpt_user_id.clone();
+                    result.account = tokens.account_id;
+                    result.material = CloudRequestMaterial::Bearer {
+                        token: tokens.access_token,
+                        fedramp: tokens.id_token.is_fedramp_account(),
+                    };
+                }
+            }
+            CodexAuth::PersonalAccessToken(auth) if allowed_plan(auth.plan_type()) => {
+                result.user = Some(auth.chatgpt_user_id().to_owned());
+                result.account = Some(auth.account_id().to_owned());
+                result.material = CloudRequestMaterial::Bearer {
+                    token: auth.access_token().to_owned(),
+                    fedramp: auth.is_fedramp_account(),
+                };
+            }
+            CodexAuth::AgentIdentity(auth) if allowed_plan(auth.plan_type()) => {
+                let record = auth.record().clone();
+                result.user = Some(record.chatgpt_user_id.clone());
+                result.account = Some(record.account_id.clone());
+                result.material = CloudRequestMaterial::Agent(record);
+            }
+            _ => {}
+        }
+        Ok(result)
+    }
+}
