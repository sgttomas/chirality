+#[tokio::test]
+async fn chirality_native_settlement_waits_for_terminal_before_shared_enqueue() {
+    let control = AgentControl::default();
+    let root_thread_id = ThreadId::new();
+    let (events_tx, mut events) = tokio::sync::mpsc::unbounded_channel();
+    let first_terminal_may_enqueue = Arc::new(tokio::sync::Semaphore::new(0));
+    let writes = Arc::new(tokio::sync::Semaphore::new(0));
+    let terminal_count = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    control
+        .configure_chirality_native_family(ChiralityNativeFamilyConfig {
+            supplier_generation: "supplier-generation".to_string(),
+            root_thread_id,
+            inherited_tools: vec![],
+            inherited_tools_digest: "tool-digest".to_string(),
+            authority_check: Arc::new(|| Box::pin(async { true })),
+            event_sink: Arc::new({
+                let first_terminal_may_enqueue = Arc::clone(&first_terminal_may_enqueue);
+                let writes = Arc::clone(&writes);
+                let terminal_count = Arc::clone(&terminal_count);
+                move |event| {
+                    let events_tx = events_tx.clone();
+                    let first_terminal_may_enqueue = Arc::clone(&first_terminal_may_enqueue);
+                    let writes = Arc::clone(&writes);
+                    let terminal_count = Arc::clone(&terminal_count);
+                    Box::pin(async move {
+                        if matches!(event, ChiralityNativeLifecycleEvent::TurnFinished { .. })
+                            && terminal_count
+                                .fetch_add(1, std::sync::atomic::Ordering::SeqCst)
+                                == 0
+                            && first_terminal_may_enqueue.acquire().await.is_err()
+                        {
+                            return false;
+                        }
+                        events_tx.send(event).is_ok()
+                            && writes.acquire().await.is_ok_and(|permit| {
+                                permit.forget();
+                                true
+                            })
+                    })
+                }
+            }),
+            role_basis_digest: Arc::new(|body| format!("role:{}", body.len())),
+        })
+        .unwrap();
+    control
+        .chirality_native_turn_started(root_thread_id, "root-turn")
+        .await
+        .unwrap();
+
+    let mut children = Vec::new();
+    for suffix in ["one", "two"] {
+        let child_thread_id = ThreadId::new();
+        let turn_id = format!("child-turn-{suffix}");
+        let mut reservation = control
+            .reserve_chirality_native_submission(
+                Some(root_thread_id),
+                Some("root-turn"),
+                Some("root-turn"),
+                None,
+            )
+            .await
+            .unwrap();
+        AgentControl::set_chirality_native_reservation_child(
+            &mut reservation,
+            child_thread_id,
+            ChiralityNativeSelectedRole::Upstream,
+        )
+        .unwrap();
+        control
+            .chirality_native_turn_started(child_thread_id, &turn_id)
+            .await
+            .unwrap();
+        writes.add_permits(1);
+        control
+            .complete_chirality_native_submission(
+                &mut reservation,
+                child_thread_id,
+                &TurnInputSubmission::Started {
+                    turn_id: turn_id.clone(),
+                },
+            )
+            .await
+            .unwrap();
+        assert!(matches!(
+            timeout(Duration::from_secs(2), events.recv()).await.unwrap(),
+            Some(ChiralityNativeLifecycleEvent::TurnStarted(_))
+        ));
+        children.push((child_thread_id, turn_id));
+    }
+    control
+        .chirality_native_turn_finished(
+            root_thread_id,
+            "root-turn",
+            ChiralityNativeTerminalReason::Completed,
+        )
+        .await
+        .unwrap();
+
+    let first_control = control.clone();
+    let first = children[0].clone();
+    let first_terminal = tokio::spawn(async move {
+        first_control
+            .chirality_native_turn_finished(
+                first.0,
+                &first.1,
+                ChiralityNativeTerminalReason::Completed,
+            )
+            .await
+    });
+    timeout(Duration::from_secs(2), async {
+        while terminal_count.load(std::sync::atomic::Ordering::SeqCst) == 0 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("the first terminal should reach the pre-enqueue boundary");
+
+    let second_control = control.clone();
+    let second = children[1].clone();
+    let second_terminal = tokio::spawn(async move {
+        second_control
+            .chirality_native_turn_finished(
+                second.0,
+                &second.1,
+                ChiralityNativeTerminalReason::Completed,
+            )
+            .await
+    });
+    assert!(matches!(
+        timeout(Duration::from_secs(2), events.recv()).await.unwrap(),
+        Some(ChiralityNativeLifecycleEvent::TurnFinished { .. })
+    ));
+    writes.add_permits(1);
+    assert!(timeout(Duration::from_millis(25), events.recv()).await.is_err());
+
+    first_terminal_may_enqueue.add_permits(1);
+    assert!(matches!(
+        timeout(Duration::from_secs(2), events.recv()).await.unwrap(),
+        Some(ChiralityNativeLifecycleEvent::TurnFinished { .. })
+    ));
+    writes.add_permits(1);
+    assert!(matches!(
+        timeout(Duration::from_secs(2), events.recv()).await.unwrap(),
+        Some(ChiralityNativeLifecycleEvent::FamilySettled { .. })
+    ));
+    writes.add_permits(1);
+    first_terminal.await.unwrap().unwrap();
+    second_terminal.await.unwrap().unwrap();
+}
