+    pub(crate) fn establish_from_fd3(
+        &mut self,
+        connection_id: u64,
+        request: &ChiralityAdmissionAuthorityInitialize,
+        exact_supply_digest: &str,
+    ) -> Result<ChiralityAdmissionAuthorityInitializeResponse, ProtocolError> {
+        if self.authority.is_some() {
+            return Err(ProtocolError("authority-unavailable"));
+        }
+        #[cfg(test)]
+        if let Some(secret) = TEST_FD3_SECRET
+            .lock()
+            .map_err(|_| ProtocolError("authority-secret-read-failed"))?
+            .take()
+        {
+            return self.establish(
+                connection_id,
+                request,
+                exact_supply_digest,
+                AuthoritySecret::for_test(secret),
+            );
+        }
+        let secret = consume_bootstrap_fd3()?;
+        self.establish(connection_id, request, exact_supply_digest, secret)
+    }
+
+    fn establish(
+        &mut self,
+        connection_id: u64,
+        request: &ChiralityAdmissionAuthorityInitialize,
+        exact_supply_digest: &str,
+        secret: AuthoritySecret,
+    ) -> Result<ChiralityAdmissionAuthorityInitializeResponse, ProtocolError> {
+        if request.contract != AUTHORITY_CONTRACT {
+            return Err(ProtocolError("authority-unavailable"));
+        }
+        let challenge = supplier_challenge(
+            secret.bytes(),
+            &request.runtime_process_incarnation_id,
+            &request.supplier_generation,
+            &request.runtime_challenge,
+            exact_supply_digest,
+        )?;
+        let descriptor = ChiralityCapabilityDescriptor {
+            capability: "chirality.local-admission-authority".to_string(),
+            contract: AUTHORITY_CONTRACT.to_string(),
+            major: 1,
+            minor: 0,
+        };
+        let v4_descriptor = ChiralityIdentitySnapshotDescriptor {
+            capability: "account.identity-snapshot".to_string(),
+            contract: "chirality-supplier-account-identity/1".to_string(),
+            major: 1,
+            minor: 0,
+            method: "account/identitySnapshot".to_string(),
+        };
+        let proof = initialization_proof(
+            secret.bytes(),
+            &InitializationProofInput {
+                contract: &request.contract,
+                runtime_process_incarnation_id: &request.runtime_process_incarnation_id,
+                supplier_generation: &request.supplier_generation,
+                runtime_challenge: &request.runtime_challenge,
+                supplier_challenge: &challenge,
+                exact_supply_digest,
+                descriptor: (
+                    &descriptor.capability,
+                    &descriptor.contract,
+                    descriptor.major,
+                    descriptor.minor,
+                ),
+                v4_descriptor: (
+                    &v4_descriptor.capability,
+                    &v4_descriptor.contract,
+                    v4_descriptor.major,
+                    v4_descriptor.minor,
+                    &v4_descriptor.method,
+                ),
+            },
+        )?;
+        self.authority = Some(EnabledAuthority {
+            secret: Some(secret),
+            runtime_process_incarnation_id: request.runtime_process_incarnation_id.clone(),
+            supplier_generation: request.supplier_generation.clone(),
+            connection_id,
+            state: AuthorityState {
+                incoming: DirectionState::new(),
+                outgoing: DirectionState::new(),
+                lease: None,
+                next_lease: 1,
+                closed: false,
+            },
+            current_identity: None,
+            require_identity_binding: true,
+        });
+        Ok(ChiralityAdmissionAuthorityInitializeResponse {
+            contract: request.contract.clone(),
+            runtime_process_incarnation_id: request.runtime_process_incarnation_id.clone(),
+            supplier_generation: request.supplier_generation.clone(),
+            supplier_challenge: challenge,
+            descriptor,
+            v4_descriptor,
+            proof,
+        })
+    }
+
+    pub(crate) fn exact_current_executable_digest() -> Result<String, ProtocolError> {
+        let path = std::env::current_exe().map_err(|_| ProtocolError("authority-unavailable"))?;
+        let mut file = std::fs::File::open(path)
+            .map_err(|_| ProtocolError("authority-unavailable"))?;
+        let mut hash = Sha256::new();
+        let mut buffer = [0_u8; 64 * 1024];
+        loop {
+            let count = file
+                .read(&mut buffer)
+                .map_err(|_| ProtocolError("authority-unavailable"))?;
+            if count == 0 {
+                break;
+            }
+            hash.update(&buffer[..count]);
+        }
+        Ok(format!("{:x}", hash.finalize()))
+    }
