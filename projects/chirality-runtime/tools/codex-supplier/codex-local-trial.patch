+const RUNTIME_ID: &str = "11111111-1111-1111-1111-111111111111";
+const SUPPLIER: &str = "s";
+const DIGEST: &str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+const SECRET: [u8; 32] = [7; 32];
+
+fn signed(sequence: &str, previous: &str, body: Value) -> AuthorityEnvelope {
+    let mut value = AuthorityEnvelope {
+        contract: AUTHORITY_CONTRACT.into(), runtime_process_incarnation_id: RUNTIME_ID.into(),
+        supplier_generation: SUPPLIER.into(), direction: "runtime-to-supplier".into(),
+        sequence: Sequence20(sequence.into()), previous_transcript_mac: previous.into(), body,
+        transcript_mac: String::new(),
+    };
+    value.transcript_mac = transcript_mac(&SECRET, &value).unwrap();
+    value
+}
+
+fn acquire(sequence: &str, previous: &str, id: &str) -> AuthorityEnvelope {
+    signed(sequence, previous, json!({"kind":"request","op":"chirality/admissionAcquire",
+        "requestId":id,"operationId":"op1","v4":{"supplierGeneration":SUPPLIER,
+        "identityGeneration":"i","snapshotDigest":DIGEST}}))
+}
+
+fn raw(value: &AuthorityEnvelope) -> Vec<u8> { serde_json::to_vec(&value.to_value()).unwrap() }
+fn frames(values: Vec<AdmissionOutput>) -> Vec<Value> {
+    values.into_iter().map(|value| match value { AdmissionOutput::Frame(frame) => frame }).collect()
+}
+fn hex(bytes: &[u8]) -> String { bytes.iter().map(|byte| format!("{byte:02x}")).collect() }
