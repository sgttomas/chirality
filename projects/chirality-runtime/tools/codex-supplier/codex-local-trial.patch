+#[tokio::test]
+async fn identity_admission_private_pair_is_one_final_queue_item_before_public_output() {
+    let connection_id = ConnectionId(77);
+    let (writer_tx, mut writer_rx) = mpsc::channel(4);
+    let direct_writer = writer_tx.clone();
+    let mut connections = HashMap::new();
+    connections.insert(
+        connection_id,
+        OutboundConnectionState::new(
+            writer_tx,
+            Arc::new(AtomicBool::new(true)),
+            Arc::new(AtomicBool::new(true)),
+            Arc::new(RwLock::new(HashSet::new())),
+            None,
+        ),
+    );
+    let (ack_tx, mut ack_rx) = tokio::sync::oneshot::channel();
+    route_outgoing_envelope(
+        &mut connections,
+        OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::PrivateBatch(Box::new([json!({"frame":1}), json!({"frame":2})])),
+            write_complete_tx: Some(ack_tx),
+        },
+    ).await;
+    direct_writer.try_send(QueuedOutgoingMessage::new(app_server_notification(
+        ServerNotification::ConfigWarning(ConfigWarningNotification {
+            summary: "public-after-private-batch".to_owned(), details: None, path: None, range: None,
+        }),
+    ))).unwrap();
+
+    let private = writer_rx.recv().await.unwrap();
+    assert!(matches!(private.message, OutgoingMessage::PrivateEnvelope(ref value) if value == &json!({"frame":1})));
+    assert_eq!(private.following_messages.len(), 1);
+    assert!(matches!(&private.following_messages[0], OutgoingMessage::PrivateEnvelope(value) if value == &json!({"frame":2})));
+    assert!(ack_rx.try_recv().is_err(), "ack cannot precede final writer completion");
+    private.write_complete_tx.unwrap().send(()).unwrap();
+    assert_eq!(ack_rx.await, Ok(()));
+    assert!(matches!(writer_rx.recv().await.unwrap().message,
+        OutgoingMessage::AppServerNotification(_)), "public output cannot split the private pair");
+}
