+impl AuthManager {
+    fn commit_identity_parts(
+        &self,
+        transition: &mut IdentityTransitionGuard,
+        auth_update: Option<Option<CodexAuth>>,
+        workspace_update: Option<Option<Vec<String>>>,
+        provider_update: Option<(Option<String>, bool)>,
+        external_update: ExternalAuthUpdate,
+    ) -> bool {
+        assert!(
+            Arc::ptr_eq(&self.joined_identity, &transition.joined_identity),
+            "transition belongs to another manager"
+        );
+        if !transition.mutation_started {
+            transition.mark_mutation_started();
+        }
+        let Ok(mut publisher) = self.joined_identity.lock() else {
+            return false;
+        };
+        let Ok(mut cached) = self.inner.write() else {
+            return false;
+        };
+        let Ok(mut forced_workspaces) = self.forced_chatgpt_workspace_id.write() else {
+            return false;
+        };
+        let Ok(mut external_auth) = self.external_auth.write() else {
+            return false;
+        };
+
+        let mut auth_changed = false;
+        let mut auth_changed_for_refresh = false;
+        let mut semantic_identity_changed = false;
+        if let Some(new_auth) = auth_update {
+            auth_changed = !AuthManager::auths_equal(cached.auth.as_ref(), new_auth.as_ref());
+            auth_changed_for_refresh =
+                !AuthManager::auths_equal_for_refresh(cached.auth.as_ref(), new_auth.as_ref());
+            semantic_identity_changed =
+                !AuthManager::identity_semantics_equal(cached.auth.as_ref(), new_auth.as_ref());
+            if auth_changed_for_refresh {
+                cached.permanent_refresh_failure = None;
+            }
+            cached.auth = new_auth;
+        }
+        if let Some(workspaces) = workspace_update {
+            *forced_workspaces = workspaces;
+        }
+        if let Some((provider, available)) = provider_update {
+            publisher.selected_provider = provider;
+            publisher.provider_available = available;
+        }
+        match external_update {
+            ExternalAuthUpdate::Keep => {}
+            ExternalAuthUpdate::Replace(value) => *external_auth = value,
+        }
+
+        let policy = self
+            .managed_auth_policy
+            .read()
+            .unwrap_or_else(|err| err.into_inner());
+        let forced = self
+            .forced_login_method
+            .read()
+            .unwrap_or_else(|err| err.into_inner());
+        publisher.policy_digest =
+            effective_identity_policy_digest(&policy, *forced, forced_workspaces.as_deref());
+        drop(forced);
+        drop(policy);
+
+        transition.semantic_changed |= semantic_identity_changed;
+        transition.auth_revision_changed |= auth_changed_for_refresh;
+        if transition.defer_publication {
+            drop(external_auth);
+            drop(forced_workspaces);
+            drop(cached);
+            drop(publisher);
+            return auth_changed;
+        }
+        semantic_identity_changed = transition.semantic_changed;
+        // `mark_pending` deliberately changes the public digest before any side
+        // effect. Compare the rebuilt complete state with the saved authoritative
+        // pre-transition state so a semantically unchanged operation restores it
+        // exactly instead of advancing solely because it passed through pending.
+        let candidate =
+            publisher.build_snapshot(cached.auth.as_ref(), forced_workspaces.as_deref());
+        if !semantic_identity_changed
+            && transition
+                .previous_snapshot
+                .as_ref()
+                .is_some_and(|previous| previous.snapshot_digest == candidate.snapshot_digest)
+        {
+            if let Some(previous) = transition.previous_snapshot.take() {
+                publisher.restore(previous);
+            }
+            drop(external_auth);
+            drop(forced_workspaces);
+            drop(cached);
+            drop(publisher);
+            transition.committed = true;
+            if transition.auth_revision_changed {
+                self.auth_change_tx.send_modify(|revision| *revision += 1);
+            }
+            return auth_changed;
+        }
+
+        publisher.publish(
+            cached.auth.as_ref(),
+            forced_workspaces.as_deref(),
+            semantic_identity_changed,
+        );
+        drop(external_auth);
+        drop(forced_workspaces);
+        drop(cached);
+        drop(publisher);
+        transition.committed = true;
+        if transition.auth_revision_changed {
+            self.auth_change_tx.send_modify(|revision| *revision += 1);
+        }
+        auth_changed
+    }
 }
 
