 use serde_json::Value as JsonValue;
 use std::collections::HashMap;
 use std::path::PathBuf;
+
+pub const CHIRALITY_NATIVE_TOOLS_SCHEMA: &str = "chirality-native-tools/v1";
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(rename_all = "camelCase", export_to = "v2/")]
+pub struct ChiralityInheritableToolDefinition {
+    pub name: String,
+    pub description: String,
+    pub input_schema: JsonValue,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(rename_all = "camelCase", export_to = "v2/")]
+pub struct ChiralityNativeToolsCarrier {
+    pub schema: String,
+    pub inheritable_tools: Vec<ChiralityInheritableToolDefinition>,
+}
+
+pub fn validate_chirality_inheritable_tools(
+    tools: &[ChiralityInheritableToolDefinition],
+) -> Result<(), &'static str> {
+    const SCHEMA_KEYS: &[&str] = &[
+        "type",
+        "properties",
+        "required",
+        "additionalProperties",
+        "items",
+        "maxItems",
+        "minItems",
+        "maxLength",
+        "minLength",
+        "minimum",
+        "maximum",
+        "enum",
+        "description",
+        "title",
+    ];
+
+    fn valid_name(value: &str) -> bool {
+        let mut bytes = value.bytes();
+        matches!(bytes.next(), Some(byte) if byte.is_ascii_alphabetic())
+            && value.len() <= 64
+            && bytes.all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+    }
+
+    fn is_safe_integer(value: &JsonValue) -> bool {
+        const MAX_SAFE_INTEGER: i64 = 9_007_199_254_740_991;
+        let Some(number) = value.as_number() else {
+            return false;
+        };
+        if let Some(value) = number.as_i64() {
+            return value.unsigned_abs() <= MAX_SAFE_INTEGER as u64;
+        }
+        if let Some(value) = number.as_u64() {
+            return value <= MAX_SAFE_INTEGER as u64;
+        }
+        number.as_f64().is_some_and(|value| {
+            value.is_finite()
+                && value.fract() == 0.0
+                && value >= -(MAX_SAFE_INTEGER as f64)
+                && value <= MAX_SAFE_INTEGER as f64
+        })
+    }
+
+    fn inspect_schema(value: &JsonValue, depth: usize) -> Result<(), &'static str> {
+        if depth > 8 {
+            return Err("schema-depth");
+        }
+        let schema = value.as_object().ok_or("schema-object")?;
+        if schema.keys().any(|key| !SCHEMA_KEYS.contains(&key.as_str())) {
+            return Err("unknown-schema-key");
+        }
+        let kind = schema
+            .get("type")
+            .and_then(JsonValue::as_str)
+            .ok_or("schema-type")?;
+        if !matches!(
+            kind,
+            "object" | "array" | "string" | "number" | "integer" | "boolean" | "null"
+        ) {
+            return Err("schema-type");
+        }
+        for key in ["description", "title"] {
+            if let Some(value) = schema.get(key)
+                && !value.is_string()
+            {
+                return Err("schema-string");
+            }
+        }
+        if let Some(values) = schema.get("enum") {
+            let values = values.as_array().ok_or("schema-enum")?;
+            if values.len() > 64
+                || values.iter().any(|value| match value {
+                    JsonValue::Null | JsonValue::Bool(_) | JsonValue::String(_) => false,
+                    JsonValue::Number(_) => !is_safe_integer(value),
+                    JsonValue::Array(_) | JsonValue::Object(_) => true,
+                })
+            {
+                return Err("schema-enum");
+            }
+        }
+        for key in [
+            "maxItems",
+            "minItems",
+            "maxLength",
+            "minLength",
+            "minimum",
+            "maximum",
+        ] {
+            if let Some(value) = schema.get(key)
+                && !is_safe_integer(value)
+            {
+                return Err("schema-number");
+            }
+        }
+        match kind {
+            "object" => {
+                if schema.get("additionalProperties") != Some(&JsonValue::Bool(false)) {
+                    return Err("schema-additional-properties");
+                }
+                let properties = schema
+                    .get("properties")
+                    .map(|value| value.as_object().ok_or("schema-properties"))
+                    .transpose()?;
+                if properties.is_some_and(|properties| properties.len() > 64) {
+                    return Err("schema-properties");
+                }
+                if let Some(properties) = properties {
+                    for child in properties.values() {
+                        inspect_schema(child, depth + 1)?;
+                    }
+                }
+                if let Some(required) = schema.get("required") {
+                    let required = required.as_array().ok_or("schema-required")?;
+                    if required.iter().any(|key| {
+                        key.as_str()
+                            .is_none_or(|key| properties.is_none_or(|properties| !properties.contains_key(key)))
+                    }) {
+                        return Err("schema-required");
+                    }
+                }
+            }
+            "array" => inspect_schema(schema.get("items").ok_or("schema-items")?, depth + 1)?,
+            _ => {}
+        }
+        Ok(())
+    }
+
+    if tools.len() > 32 {
+        return Err("tool-count");
+    }
+    for tool in tools {
+        if !valid_name(&tool.name)
+            || tool.description.trim().is_empty()
+            || tool.description.len() > 4096
+            || serde_json::to_vec(&tool.input_schema)
+                .map_err(|_| "schema-json")?
+                .len()
+                > 16_384
+        {
+            return Err("tool-definition");
+        }
+        inspect_schema(&tool.input_schema, 0)?;
+    }
+    let mut names = tools.iter().map(|tool| tool.name.as_str()).collect::<Vec<_>>();
+    names.sort_unstable_by(|left, right| left.as_bytes().cmp(right.as_bytes()));
+    if names.windows(2).any(|pair| pair[0] == pair[1]) {
+        return Err("duplicate-tool-name");
+    }
+    Ok(())
+}
+
+/// Canonical byte encoder for the private inherited-definition subset.
+///
+/// The prefix and recursive value grammar are shared with the Runtime encoder.
+/// Tool definitions are sorted by name; JSON object members are sorted by their
+/// unsigned UTF-8 key bytes. JSON numbers are accepted only when their
+/// mathematical value is an integer in JavaScript's safe integer range.
+pub fn encode_chirality_inheritable_tools(
+    tools: &[ChiralityInheritableToolDefinition],
+) -> Result<Vec<u8>, &'static str> {
+    validate_chirality_inheritable_tools(tools)?;
+    fn push_len(out: &mut Vec<u8>, len: usize) {
+        out.extend_from_slice(len.to_string().as_bytes());
+    }
+
+    fn encode_string(out: &mut Vec<u8>, value: &str) {
+        out.push(b's');
+        push_len(out, value.len());
+        out.push(b':');
+        out.extend_from_slice(value.as_bytes());
+    }
+
+    fn safe_integer(number: &serde_json::Number) -> Result<i64, &'static str> {
+        const MAX_SAFE_INTEGER: i64 = 9_007_199_254_740_991;
+        if let Some(value) = number.as_i64() {
+            return (value.unsigned_abs() <= MAX_SAFE_INTEGER as u64)
+                .then_some(value)
+                .ok_or("unsafe-number");
+        }
+        if let Some(value) = number.as_u64() {
+            return (value <= MAX_SAFE_INTEGER as u64)
+                .then_some(value as i64)
+                .ok_or("unsafe-number");
+        }
+        let value = number.as_f64().ok_or("nonfinite-number")?;
+        if !value.is_finite()
+            || value.fract() != 0.0
+            || value < -(MAX_SAFE_INTEGER as f64)
+            || value > MAX_SAFE_INTEGER as f64
+        {
+            return Err("unsafe-number");
+        }
+        Ok(if value == 0.0 { 0 } else { value as i64 })
+    }
+
+    fn encode_value(out: &mut Vec<u8>, value: &JsonValue) -> Result<(), &'static str> {
+        match value {
+            JsonValue::Null => out.push(b'n'),
+            JsonValue::Bool(false) => out.push(b'f'),
+            JsonValue::Bool(true) => out.push(b't'),
+            JsonValue::Number(number) => {
+                out.push(b'i');
+                out.extend_from_slice(safe_integer(number)?.to_string().as_bytes());
+                out.push(b';');
+            }
+            JsonValue::String(value) => encode_string(out, value),
+            JsonValue::Array(values) => {
+                out.push(b'a');
+                push_len(out, values.len());
+                out.push(b':');
+                for value in values {
+                    encode_value(out, value)?;
+                }
+            }
+            JsonValue::Object(values) => {
+                out.push(b'o');
+                push_len(out, values.len());
+                out.push(b':');
+                let mut members = values.iter().collect::<Vec<_>>();
+                members.sort_by(|(left, _), (right, _)| left.as_bytes().cmp(right.as_bytes()));
+                for (key, value) in members {
+                    encode_string(out, key);
+                    encode_value(out, value)?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    let mut sorted = tools.iter().collect::<Vec<_>>();
+    sorted.sort_by(|left, right| left.name.as_bytes().cmp(right.name.as_bytes()));
+    if sorted.windows(2).any(|pair| pair[0].name == pair[1].name) {
+        return Err("duplicate-tool-name");
+    }
+
+    let mut out = Vec::new();
+    out.extend_from_slice(CHIRALITY_NATIVE_TOOLS_SCHEMA.as_bytes());
+    out.push(0);
+    out.push(b'a');
+    push_len(&mut out, sorted.len());
+    out.push(b':');
+    for tool in sorted {
+        out.extend_from_slice(b"o3:");
+        encode_string(&mut out, "description");
+        encode_string(&mut out, &tool.description);
+        encode_string(&mut out, "inputSchema");
+        encode_value(&mut out, &tool.input_schema)?;
+        encode_string(&mut out, "name");
+        encode_string(&mut out, &tool.name);
+    }
+    Ok(out)
+}
