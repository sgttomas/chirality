+pub(crate) fn parse_strict_json(raw: &[u8]) -> Result<Value, ProtocolError> {
+    if raw.len() > MAX_JSON_BYTES || std::str::from_utf8(raw).is_err() {
+        return Err(malformed());
+    }
+    let mut deserializer = serde_json::Deserializer::from_slice(raw);
+    let value = DuplicateAwareValue::deserialize(&mut deserializer).map_err(|_| malformed())?.0;
+    deserializer.end().map_err(|_| malformed())?;
+    fn finite_numbers(value: &Value) -> bool {
+        match value {
+            Value::Number(number) => number.as_f64().is_some_and(f64::is_finite),
+            Value::Array(values) => values.iter().all(finite_numbers),
+            // serde_json's arbitrary-precision deserializer represents a number
+            // that cannot become a finite f64 as this private marker map when
+            // visited through a custom Value visitor. Treat the marker as an
+            // invalid numeric token rather than ordinary caller JSON.
+            Value::Object(values) => {
+                !values.contains_key("$serde_json::private::Number")
+                    && values.values().all(finite_numbers)
+            }
+            _ => true,
+        }
+    }
+    if !finite_numbers(&value) {
+        return Err(malformed());
+    }
+    Ok(value)
+}
+
+fn exact_object<'a>(value: &'a Value, keys: &[&str]) -> Result<&'a Map<String, Value>, ProtocolError> {
+    let object = value.as_object().ok_or_else(malformed)?;
+    if object.len() != keys.len() || keys.iter().any(|key| !object.contains_key(*key)) {
+        return Err(malformed());
+    }
+    Ok(object)
+}
+
+fn printable(value: &Value) -> Result<&str, ProtocolError> {
+    let value = value.as_str().ok_or_else(malformed)?;
+    if value.is_empty() || value.len() > 128 || !value.bytes().all(|b| (0x21..=0x7e).contains(&b)) {
+        return Err(malformed());
+    }
+    Ok(value)
+}
+
+fn digest(value: &Value) -> Result<&str, ProtocolError> {
+    let value = value.as_str().ok_or_else(malformed)?;
+    if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {
+        return Err(malformed());
+    }
+    Ok(value)
+}
+
+fn uuid(value: &Value) -> Result<&str, ProtocolError> {
+    let value = value.as_str().ok_or_else(malformed)?;
+    let bytes = value.as_bytes();
+    if bytes.len() != 36
+        || ![8, 13, 18, 23].into_iter().all(|i| bytes[i] == b'-')
+        || bytes.iter().enumerate().any(|(i, b)| ![8, 13, 18, 23].contains(&i) && !(b.is_ascii_digit() || (b'a'..=b'f').contains(b)))
+    {
+        return Err(malformed());
+    }
+    Ok(value)
+}
+
+fn mac(value: &Value) -> Result<&str, ProtocolError> {
+    let value = value.as_str().ok_or(ProtocolError("transcript-invalid"))?;
+    if value.len() != 43 || !value.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-') {
+        return Err(ProtocolError("transcript-invalid"));
+    }
+    let decoded = URL_SAFE_NO_PAD.decode(value).map_err(|_| ProtocolError("transcript-invalid"))?;
+    if decoded.len() != 32 || URL_SAFE_NO_PAD.encode(decoded) != value {
+        return Err(ProtocolError("transcript-invalid"));
+    }
+    Ok(value)
+}
