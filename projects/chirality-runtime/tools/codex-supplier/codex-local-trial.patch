+            auth.initialize_resolved_identity_config(base, base.model_provider_id.clone())
+                .await;
+            return Ok(None);
+        }
+        let mut guard = auth.begin_identity_transition().await;
+        guard.defer_publication();
+        guard.mark_mutation_started();
+        let result = self
+            .reconcile_identity_state(auth, &mut guard, Some(base))
+            .await?;
+        *self
