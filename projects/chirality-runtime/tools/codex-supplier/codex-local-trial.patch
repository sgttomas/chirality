+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum CanonField {
+    Ascii(String),
+    Sequence(Sequence20),
+}
+
+fn u32be(value: usize) -> Result<[u8; 4], ProtocolError> {
+    Ok(u32::try_from(value).map_err(|_| malformed())?.to_be_bytes())
+}
+
+fn append_lp(out: &mut Vec<u8>, bytes: &[u8]) -> Result<(), ProtocolError> {
+    out.extend_from_slice(&u32be(bytes.len())?);
+    out.extend_from_slice(bytes);
+    Ok(())
+}
+
+pub(crate) fn canonical_bytes(domain: &str, fields: &[CanonField]) -> Result<Vec<u8>, ProtocolError> {
+    if domain.is_empty() || !domain.bytes().all(|b| (0x21..=0x7e).contains(&b)) {
+        return Err(malformed());
+    }
+    let mut out = b"chirality-local-admission-mac\0".to_vec();
+    out.push(1);
+    append_lp(&mut out, domain.as_bytes())?;
+    out.extend_from_slice(&u32be(fields.len())?);
+    for field in fields {
+        match field {
+            CanonField::Ascii(value) => {
+                if value.is_empty() || !value.bytes().all(|b| (0x21..=0x7e).contains(&b)) {
+                    return Err(malformed());
+                }
+                append_lp(&mut out, value.as_bytes())?;
+            }
+            CanonField::Sequence(value) => append_lp(&mut out, &value.number()?.to_be_bytes())?,
+        }
+    }
+    Ok(out)
+}
+
+fn ascii(value: &str) -> CanonField { CanonField::Ascii(value.to_owned()) }
+
+pub(crate) fn validate_body(value: &Value) -> Result<Vec<CanonField>, ProtocolError> {
+    let object = value.as_object().ok_or_else(malformed)?;
+    let kind = object.get("kind").and_then(Value::as_str).ok_or_else(malformed)?;
+    let op = object.get("op").and_then(Value::as_str).ok_or_else(malformed)?;
+    let keys: &[&str] = match (kind, op) {
+        ("request", "chirality/admissionAcquire") => &["kind", "op", "requestId", "operationId", "v4"],
+        ("request", "chirality/admissionRelease" | "chirality/admissionAbort") => &["kind", "op", "requestId", "leaseId", "disposition"],
+        ("result", "chirality/admissionAcquire") => &["kind", "op", "state", "requestId", "operationId", "leaseId", "supplierGeneration", "identityGeneration", "snapshotDigest"],
+        ("result", "chirality/admissionRelease" | "chirality/admissionAbort") => &["kind", "op", "state", "requestId", "leaseId", "disposition"],
+        ("result", "error") => &["kind", "op", "state", "requestId", "class", "reason"],
+        ("notification", "chirality/admissionAcquired") => &["kind", "op", "requestId", "operationId", "leaseId", "supplierGeneration", "identityGeneration", "snapshotDigest"],
+        ("notification", "chirality/admissionReleased" | "chirality/admissionAborted") => &["kind", "op", "requestId", "leaseId", "disposition"],
+        ("notification", "chirality/admissionRevoked") => &["kind", "op", "reason", "revokedThroughRuntimeSequence"],
+        _ => return Err(malformed()),
+    };
+    exact_object(value, keys)?;
+    let mut fields = vec![ascii(kind), ascii(op)];
+    match (kind, op) {
+        ("request", "chirality/admissionAcquire") => {
+            fields.push(ascii(printable(&object["requestId"])?));
+            fields.push(ascii(printable(&object["operationId"])?));
+            let v4 = exact_object(&object["v4"], &["supplierGeneration", "identityGeneration", "snapshotDigest"])?;
+            fields.push(ascii(printable(&v4["supplierGeneration"])?));
+            fields.push(ascii(printable(&v4["identityGeneration"])?));
+            fields.push(ascii(digest(&v4["snapshotDigest"])?));
+        }
+        ("request", "chirality/admissionRelease" | "chirality/admissionAbort") => {
+            fields.push(ascii(printable(&object["requestId"])?));
+            fields.push(ascii(printable(&object["leaseId"])?));
+            let expected = if op.ends_with("Release") { "worker-accepted" } else { "worker-not-accepted" };
+            if object["disposition"] != expected { return Err(malformed()); }
+            fields.push(ascii(expected));
+        }
+        ("result", "error") => {
+            if object["state"] != "error" { return Err(malformed()); }
+            fields.push(ascii("error"));
+            fields.push(ascii(match object.get("requestId") { Some(Value::Null) => "null", Some(v) => printable(v)?, None => return Err(malformed()) }));
+            let class = object["class"].as_str().ok_or_else(malformed)?;
+            let reason = object["reason"].as_str().ok_or_else(malformed)?;
+            let legal = matches!((class, reason),
+                ("unavailable", "authority-unavailable") | ("authorization", "authority-revoked") |
+                ("protocol", "generation-mismatch" | "sequence-invalid" | "transcript-invalid") |
+                ("stale", "snapshot-stale") | ("busy", "lease-busy") |
+                ("malformed", "lease-unknown" | "lease-state-invalid" | "request-malformed") |
+                ("internal", "internal-failure"));
+            if !legal { return Err(malformed()); }
+            fields.push(ascii(class)); fields.push(ascii(reason));
+        }
+        ("notification", "chirality/admissionRevoked") => {
+            let reason = object["reason"].as_str().ok_or_else(malformed)?;
+            if !matches!(reason, "authority-revoked" | "identity-transition" | "supplier-shutdown" | "protocol-failure") { return Err(malformed()); }
+            fields.push(ascii(reason));
+            fields.push(CanonField::Sequence(Sequence20::parse(&object["revokedThroughRuntimeSequence"])?));
+        }
+        _ => {
+            if kind == "result" {
+                let expected = if op == "chirality/admissionAcquire" { "acquired" } else if op == "chirality/admissionRelease" { "released" } else { "aborted" };
+                if object["state"] != expected { return Err(malformed()); }
+                fields.push(ascii(expected));
+            }
+            fields.push(ascii(printable(&object["requestId"])?));
+            if op == "chirality/admissionAcquire" || op == "chirality/admissionAcquired" {
+                fields.push(ascii(printable(&object["operationId"])?));
+                fields.push(ascii(printable(&object["leaseId"])?));
+                fields.push(ascii(printable(&object["supplierGeneration"])?));
+                fields.push(ascii(printable(&object["identityGeneration"])?));
+                fields.push(ascii(digest(&object["snapshotDigest"])?));
+            } else {
+                fields.push(ascii(printable(&object["leaseId"])?));
+                let expected = if op.ends_with("Release") || op.ends_with("Released") { "worker-accepted" } else { "worker-not-accepted" };
+                if object["disposition"] != expected { return Err(malformed()); }
+                fields.push(ascii(expected));
+            }
+        }
+    }
+    Ok(fields)
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct AuthorityEnvelope {
+    pub(crate) contract: String,
+    pub(crate) runtime_process_incarnation_id: String,
+    pub(crate) supplier_generation: String,
+    pub(crate) direction: String,
+    pub(crate) sequence: Sequence20,
+    pub(crate) previous_transcript_mac: String,
+    pub(crate) body: Value,
+    pub(crate) transcript_mac: String,
+}
+
+impl AuthorityEnvelope {
+    pub(crate) fn from_value(value: &Value) -> Result<Self, ProtocolError> {
+        let object = exact_object(value, &["contract", "runtimeProcessIncarnationId", "supplierGeneration", "direction", "sequence", "previousTranscriptMac", "body", "transcriptMac"])?;
+        if object["contract"] != AUTHORITY_CONTRACT { return Err(malformed()); }
+        let runtime_id = uuid(&object["runtimeProcessIncarnationId"])?;
+        let supplier = printable(&object["supplierGeneration"])?;
+        let direction = object["direction"].as_str().ok_or_else(malformed)?;
+        if !matches!(direction, "runtime-to-supplier" | "supplier-to-runtime") { return Err(malformed()); }
+        let sequence = Sequence20::parse(&object["sequence"])?;
+        let previous = mac(&object["previousTranscriptMac"])?;
+        let body_fields = validate_body(&object["body"])?;
+        let kind = object["body"]["kind"].as_str().ok_or_else(malformed)?;
+        if (direction == "runtime-to-supplier") != (kind == "request") { return Err(malformed()); }
+        let transcript = mac(&object["transcriptMac"])?;
+        let envelope = Self {
+            contract: AUTHORITY_CONTRACT.to_owned(), runtime_process_incarnation_id: runtime_id.to_owned(),
+            supplier_generation: supplier.to_owned(), direction: direction.to_owned(), sequence,
+            previous_transcript_mac: previous.to_owned(), body: object["body"].clone(), transcript_mac: transcript.to_owned(),
+        };
+        let _ = body_fields;
+        Ok(envelope)
+    }
+
+    pub(crate) fn to_value(&self) -> Value {
+        serde_json::json!({
+            "contract": self.contract,
+            "runtimeProcessIncarnationId": self.runtime_process_incarnation_id,
+            "supplierGeneration": self.supplier_generation,
+            "direction": self.direction,
+            "sequence": self.sequence.0,
+            "previousTranscriptMac": self.previous_transcript_mac,
+            "body": self.body,
+            "transcriptMac": self.transcript_mac,
+        })
+    }
+}
+
+fn hmac(secret: &[u8; 32], bytes: &[u8]) -> String {
+    let mut mac = Hmac::<Sha256>::new_from_slice(secret).expect("HMAC accepts a 32-byte key");
+    mac.update(bytes);
+    URL_SAFE_NO_PAD.encode(mac.finalize().into_bytes())
+}
+
+pub(crate) fn transcript_mac(secret: &[u8; 32], envelope: &AuthorityEnvelope) -> Result<String, ProtocolError> {
+    let mut fields = vec![
+        ascii(&envelope.contract), ascii(&envelope.runtime_process_incarnation_id), ascii(&envelope.supplier_generation),
+        ascii(&envelope.direction), CanonField::Sequence(envelope.sequence.clone()), ascii(&envelope.previous_transcript_mac),
+    ];
+    fields.extend(validate_body(&envelope.body)?);
+    Ok(hmac(secret, &canonical_bytes(&format!("transcript/{}", envelope.direction), &fields)?))
+}
+
+pub(crate) fn verify_transcript_mac(secret: &[u8; 32], envelope: &AuthorityEnvelope) -> Result<(), ProtocolError> {
+    let expected = transcript_mac(secret, envelope)?;
+    let expected = URL_SAFE_NO_PAD.decode(expected).map_err(|_| ProtocolError("transcript-invalid"))?;
+    let actual = URL_SAFE_NO_PAD.decode(&envelope.transcript_mac).map_err(|_| ProtocolError("transcript-invalid"))?;
+    let mut verifier = Hmac::<Sha256>::new_from_slice(secret).expect("HMAC accepts a 32-byte key");
+    verifier.update(&canonical_bytes(&format!("transcript/{}", envelope.direction), &{
+        let mut fields = vec![ascii(&envelope.contract), ascii(&envelope.runtime_process_incarnation_id), ascii(&envelope.supplier_generation), ascii(&envelope.direction), CanonField::Sequence(envelope.sequence.clone()), ascii(&envelope.previous_transcript_mac)];
+        fields.extend(validate_body(&envelope.body)?); fields
+    })?);
+    verifier.verify_slice(&actual).map_err(|_| ProtocolError("transcript-invalid"))?;
+    debug_assert_eq!(expected, actual);
+    Ok(())
+}
+
+pub(crate) struct InitializationProofInput<'a> {
+    pub(crate) contract: &'a str,
+    pub(crate) runtime_process_incarnation_id: &'a str,
+    pub(crate) supplier_generation: &'a str,
+    pub(crate) runtime_challenge: &'a str,
+    pub(crate) supplier_challenge: &'a str,
+    pub(crate) exact_supply_digest: &'a str,
+    pub(crate) descriptor: (&'a str, &'a str, u64, u64),
+    pub(crate) v4_descriptor: (&'a str, &'a str, u64, u64, &'a str),
+}
+
+pub(crate) fn initialization_proof(secret: &[u8; 32], input: &InitializationProofInput<'_>) -> Result<String, ProtocolError> {
+    if input.contract != AUTHORITY_CONTRACT { return Err(malformed()); }
+    uuid(&Value::String(input.runtime_process_incarnation_id.to_owned()))?;
+    printable(&Value::String(input.supplier_generation.to_owned()))?;
+    mac(&Value::String(input.runtime_challenge.to_owned()))?;
+    mac(&Value::String(input.supplier_challenge.to_owned()))?;
+    digest(&Value::String(input.exact_supply_digest.to_owned()))?;
+    for value in [input.descriptor.0, input.descriptor.1, input.v4_descriptor.0, input.v4_descriptor.1, input.v4_descriptor.4] {
+        printable(&Value::String(value.to_owned()))?;
+    }
+    if [
+        input.descriptor.2,
+        input.descriptor.3,
+        input.v4_descriptor.2,
+        input.v4_descriptor.3,
+    ]
+    .into_iter()
+    .any(|value| value > MAX_SAFE_INTEGER)
+    {
+        return Err(malformed());
+    }
+    let descriptor_major = input.descriptor.2.to_string();
+    let descriptor_minor = input.descriptor.3.to_string();
+    let v4_major = input.v4_descriptor.2.to_string();
+    let v4_minor = input.v4_descriptor.3.to_string();
+    let fields = [input.contract, input.runtime_process_incarnation_id, input.supplier_generation,
+        input.runtime_challenge, input.supplier_challenge, input.exact_supply_digest,
+        input.descriptor.0, input.descriptor.1, &descriptor_major, &descriptor_minor,
+        input.v4_descriptor.0, input.v4_descriptor.1, &v4_major, &v4_minor, input.v4_descriptor.4]
+        .into_iter().map(ascii).collect::<Vec<_>>();
+    Ok(hmac(secret, &canonical_bytes("initialize-proof", &fields)?))
+}
+
+pub(crate) fn supplier_challenge(
+    secret: &[u8; 32],
+    runtime_process_incarnation_id: &str,
+    supplier_generation: &str,
+    runtime_challenge: &str,
+    exact_supply_digest: &str,
+) -> Result<String, ProtocolError> {
+    uuid(&Value::String(runtime_process_incarnation_id.to_owned()))?;
+    printable(&Value::String(supplier_generation.to_owned()))?;
+    mac(&Value::String(runtime_challenge.to_owned()))?;
+    digest(&Value::String(exact_supply_digest.to_owned()))?;
+    let fields = [
+        runtime_process_incarnation_id,
+        supplier_generation,
+        runtime_challenge,
+        exact_supply_digest,
+    ]
+    .into_iter()
+    .map(ascii)
+    .collect::<Vec<_>>();
+    Ok(hmac(
+        secret,
+        &canonical_bytes("initialize-supplier-challenge", &fields)?,
+    ))
+}
+
+pub(crate) fn decode_private_request(
+    raw: &[u8],
+) -> Result<(String, AuthorityEnvelope), ProtocolError> {
+    let value = parse_strict_json(raw)?;
+    let envelope = AuthorityEnvelope::from_value(&value)?;
+    let method = printable(&envelope.body["op"])?;
+    if !matches!(method, "chirality/admissionAcquire" | "chirality/admissionRelease" | "chirality/admissionAbort") { return Err(malformed()); }
+    Ok((method.to_owned(), envelope))
+}
