+                                    &auth_manager,
+                                    held.as_mut().expect("owned guard"),
+                                    base_config.as_deref(),
+                                )
+                                .await
+                                .map(|_| ())
+                        } else {
+                            held.as_mut().expect("owned guard").resume_publication();
+                            let reloaded = auth_manager
+                                .reload_under_identity_transition(
+                                    held.as_mut().expect("owned guard"),
+                                )
+                                .await
+                                .map(|_| ());
+                            drop(held.take());
+                            // Ordinary public callbacks run after the persistence permit is released.
