+pub(crate) struct PrivateDeliveryPermit(mpsc::OwnedPermit<OutgoingEnvelope>);
+
+impl PrivateDeliveryPermit {
+    pub(crate) fn publish(
+        self,
+        connection_id: ConnectionId,
+        frames: Vec<serde_json::Value>,
+    ) -> Option<oneshot::Receiver<()>> {
+        let message = match frames.as_slice() {
+            [frame] => OutgoingMessage::PrivateEnvelope(frame.clone()),
+            [first, second] => {
+                OutgoingMessage::PrivateBatch(Box::new([first.clone(), second.clone()]))
+            }
+            _ => return None,
+        };
+        let (write_complete_tx, write_complete_rx) = oneshot::channel();
+        self.0.send(OutgoingEnvelope::ToConnection {
+            connection_id,
+            message,
+            write_complete_tx: Some(write_complete_tx),
+        });
+        Some(write_complete_rx)
+    }
+}
