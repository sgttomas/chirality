+fn chirality_native_test_control(
+) -> (
+    AgentControl,
+    ThreadId,
+    tokio::sync::mpsc::UnboundedReceiver<ChiralityNativeLifecycleEvent>,
+    Arc<tokio::sync::Semaphore>,
+    Arc<std::sync::atomic::AtomicBool>,
+) {
+    let control = AgentControl::default();
+    let root_thread_id = ThreadId::new();
+    let (events_tx, events_rx) = tokio::sync::mpsc::unbounded_channel();
+    let writes = Arc::new(tokio::sync::Semaphore::new(0));
+    let live = Arc::new(std::sync::atomic::AtomicBool::new(true));
+    let live_for_check = Arc::clone(&live);
+    let writes_for_sink = Arc::clone(&writes);
+    control
+        .configure_chirality_native_family(ChiralityNativeFamilyConfig {
+            supplier_generation: "supplier-generation".to_string(),
+            root_thread_id,
+            inherited_tools: vec![DynamicToolSpec::Function(
+                codex_protocol::dynamic_tools::DynamicToolFunctionSpec {
+                    name: "inherited_tool".to_string(),
+                    description: "inherited tool".to_string(),
+                    input_schema: serde_json::json!({
+                        "type": "object",
+                        "properties": {},
+                        "additionalProperties": false,
+                    }),
+                    defer_loading: false,
+                },
+            )],
+            inherited_tools_digest: "tool-digest".to_string(),
+            authority_check: Arc::new(move || {
+                let live = Arc::clone(&live_for_check);
+                Box::pin(async move { live.load(std::sync::atomic::Ordering::SeqCst) })
+            }),
+            event_sink: Arc::new(move |event| {
+                let events_tx = events_tx.clone();
+                let writes = Arc::clone(&writes_for_sink);
+                Box::pin(async move {
+                    events_tx.send(event).is_ok()
+                        && writes.acquire().await.is_ok_and(|permit| {
+                            permit.forget();
+                            true
+                        })
+                })
+            }),
+            role_basis_digest: Arc::new(|body| format!("role:{}", body.len())),
+        })
+        .unwrap();
+    (control, root_thread_id, events_rx, writes, live)
+}
