+    pub(crate) async fn process_raw_private(&self, connection_id: ConnectionId, raw: &[u8]) {
+        let supplier_generation = self
+            .identity_admission
+            .lock()
+            .await
+            .supplier_generation(connection_id.0)
+            .map(str::to_owned);
+        let identity = supplier_generation
+            .as_deref()
+            .and_then(|generation| self.current_private_identity_binding(generation));
+        let mut admission = self.identity_admission.lock().await;
+        admission.set_current_identity(connection_id.0, identity);
+        let prepared = admission.prepare_raw(connection_id.0, raw);
+        if prepared.is_empty() {
+            admission.activate(prepared);
+            return;
+        }
+        let Ok(permit) = self.outgoing.reserve_private_delivery().await else {
+            admission.delivery_failed();
+            return;
+        };
+        let expected_count = prepared.output_count();
+        let frames = admission
+            .activate(prepared)
+            .into_iter()
+            .map(|output| match output {
+                AdmissionOutput::Frame(frame) => frame,
+            })
+            .collect::<Vec<_>>();
+        debug_assert_eq!(frames.len(), expected_count);
+        let guard = AdmissionDeliveryGuard::new(&mut admission);
+        let Some(write_complete_rx) = permit.publish(connection_id, frames) else {
+            return;
+        };
+        if write_complete_rx.await.is_ok() {
+            guard.complete();
+        }
+    }
