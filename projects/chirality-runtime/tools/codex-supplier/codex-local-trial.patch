+    identity_admission: &Mutex<IdentityAdmissionCoordinator>,
+    auth_manager: &AuthManager,
+    connection_id: ConnectionId,
+) -> Result<OperationBinding, JSONRPCErrorError> {
+    let supplier_generation = identity_admission
+        .lock()
+        .await
+        .supplier_generation(connection_id.0)
+        .map(str::to_owned)
+        .ok_or_else(|| invalid_request("Private native tools carrier unavailable"))?;
+    let identity = current_identity_binding(auth_manager, &supplier_generation)
+        .ok_or_else(|| invalid_request("Private native tools carrier unavailable"))?;
+    identity_admission
+        .lock()
+        .await
+        .current_operation_binding(connection_id.0, &identity)
+        .ok_or_else(|| invalid_request("Private native tools carrier unavailable"))
