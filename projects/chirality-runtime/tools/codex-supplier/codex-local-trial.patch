+impl LoginPersistenceHook for AppLoginPersistenceHook {
+    fn commit(&self, persistence: LoginPersistenceFuture) -> LoginPersistenceFuture {
+        let auth_manager = Arc::clone(&self.auth_manager);
+        let state = Arc::clone(&self.state);
+        let config_manager = self.config_manager.clone();
+        let base_config = self.base_config.clone();
+        Box::pin(async move {
+            if state
+                .phase
+                .compare_exchange(0, 1, Ordering::AcqRel, Ordering::Acquire)
+                .is_err()
+            {
+                return Err(std::io::Error::other("login persistence already consumed"));
+            }
+            let owner_state = Arc::clone(&state);
+            let owner_future: LoginPersistenceFuture = Box::pin(async move {
+                let _settled = PersistenceOwnerFinished(Arc::clone(&owner_state));
+                let result = async {
+                    let predecessor = owner_state
+                        .predecessor
+                        .lock()
+                        .unwrap_or_else(|e| e.into_inner())
+                        .take();
+                    if let Some(predecessor) = predecessor {
+                        predecessor.wait_for_completion().await;
+                    }
+                    if !owner_state.registered.load(Ordering::Acquire)
+                        || owner_state.cancelled.load(Ordering::Acquire)
+                    {
+                        return Err(std::io::Error::new(
+                            std::io::ErrorKind::Interrupted,
+                            "login attempt was cancelled before credential persistence",
+                        ));
+                    }
+                    let mut transition = auth_manager.begin_identity_transition().await;
+                    if owner_state.cancelled.load(Ordering::Acquire) {
+                        transition.finish_without_change();
+                        return Err(std::io::Error::new(
+                            std::io::ErrorKind::Interrupted,
+                            "login attempt was replaced before credential persistence",
+                        ));
+                    }
