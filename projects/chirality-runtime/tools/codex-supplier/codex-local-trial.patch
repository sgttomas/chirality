+#[test]
+fn identity_admission_strict_json_sequence_and_union_are_closed() {
+    for bad in [br#"{"a":1,"a":2}"#.as_slice(), br#"{"a":1,"\u0061":2}"#, br#"{"n":1e999}"#] {
+        assert!(parse_strict_json(bad).is_err(), "accepted {}", String::from_utf8_lossy(bad));
+    }
+    assert!(parse_strict_json(&[0xff]).is_err());
+    for bad in [json!(0), json!("00000000000000000000"), json!("1"),
+        json!("+0000000000000000001"), json!("18446744073709551616")] {
+        assert!(Sequence20::parse(&bad).is_err());
+    }
+    assert_eq!(Sequence20::parse(&json!(FIRST_SEQUENCE)).unwrap().number().unwrap(), 1);
+    let max = Sequence20::parse(&json!("18446744073709551615")).unwrap();
+    assert!(max.next().is_err());
+    assert!(canonical_bytes("d", &[CanonField::Sequence(max)]).unwrap()
+        .ends_with(&[0,0,0,8,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff]));
+    assert!(validate_body(&json!({"kind":"result","op":"error","state":"error",
+        "requestId":null,"class":"busy","reason":"lease-busy"})).is_ok());
+    assert!(validate_body(&json!({"kind":"result","op":"error","state":"error",
+        "requestId":null,"class":"busy","reason":"authority-revoked"})).is_err());
+    assert!(validate_body(&json!({"kind":"request","op":"chirality/admissionRelease",
+        "requestId":"r","leaseId":"l","disposition":"worker-not-accepted"})).is_err());
+}
