+fn unavailable_reason(snapshot: &JoinedIdentitySnapshot) -> &str {
+    match &snapshot.qualification {
+        JoinedIdentityQualification::Unavailable { reason } => reason,
+        JoinedIdentityQualification::Qualified { .. } => {
