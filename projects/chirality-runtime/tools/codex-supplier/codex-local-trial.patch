+#[derive(Default)]
+struct LoginPersistenceState {
+    cancelled: AtomicBool,
+    registered: AtomicBool,
+    predecessor: StdMutex<Option<Arc<LoginPersistenceState>>>,
+    phase: AtomicU8,
+    settled: Notify,
+    retained_transition: StdMutex<Option<IdentityTransitionGuard>>,
+}
+
+impl LoginPersistenceState {
+    fn cancel(&self) {
+        self.cancelled.store(true, Ordering::Release);
+    }
+
+    async fn wait_if_running(&self) {
+        loop {
+            let notified = self.settled.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.phase.load(Ordering::Acquire) != 1 {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    async fn wait_for_completion(&self) {
+        loop {
+            let notified = self.settled.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.phase.load(Ordering::Acquire) == 3 {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    fn completion_released(&self) {
+        self.phase.store(3, Ordering::Release);
+        self.settled.notify_waiters();
+    }
+
+    fn finish(&self) {
+        self.phase.store(2, Ordering::Release);
+        self.settled.notify_waiters();
+    }
+
+    fn take_transition(&self) -> Option<IdentityTransitionGuard> {
+        self.retained_transition
+            .lock()
+            .unwrap_or_else(|err| err.into_inner())
+            .take()
+    }
+}
+
+struct PersistenceOwnerFinished(Arc<LoginPersistenceState>);
+impl Drop for PersistenceOwnerFinished {
+    fn drop(&mut self) {
+        self.0.finish();
+    }
+}
