+#[cfg(unix)]
+fn consume_bootstrap_fd(
+    consumer: &SecretConsumer,
+    raw_fd: std::os::fd::RawFd,
+) -> Result<AuthoritySecret, ProtocolError> {
+    use std::fs::File;
+    use std::os::fd::FromRawFd;
+
+    unsafe extern "C" {
+        fn close(fd: std::os::raw::c_int) -> std::os::raw::c_int;
+        fn dup(fd: std::os::raw::c_int) -> std::os::raw::c_int;
+    }
+
+    // Claim before examining the descriptor so re-entry cannot close a resource
+    // that has subsequently reused the same descriptor number.
+    consumer.claim()?;
+    // SAFETY: `dup` does not take ownership and returns a new owned descriptor on success.
+    let owned_fd = unsafe { dup(raw_fd) };
+    if owned_fd < 0 {
+        return Err(ProtocolError("authority-secret-missing"));
+    }
+    // SAFETY: this startup-exclusive consumer closes the original descriptor once;
+    // the duplicate remains independently owned.
+    if unsafe { close(raw_fd) } != 0 {
+        // SAFETY: `owned_fd` was returned by `dup` and has not been transferred yet.
+        let duplicate = unsafe { File::from_raw_fd(owned_fd) };
+        drop(duplicate);
+        return Err(ProtocolError("authority-secret-close-failed"));
+    }
+    // SAFETY: `owned_fd` is a valid owned duplicate and File closes it on every path.
+    let file = unsafe { File::from_raw_fd(owned_fd) };
+    consumer.consume_claimed(file)
+}
