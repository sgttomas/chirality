+    pub(crate) fn prepare_raw(&self, connection_id: u64, raw: &[u8]) -> PreparedAdmission {
+        let Some(authority) = self.authority.as_ref() else {
+            return Self::silent_terminal();
+        };
+        if authority.state.closed {
+            return Self::silent_terminal();
+        }
+        if authority.connection_id != connection_id {
+            return Self::terminal(authority.state.clone(), Vec::new());
+        }
+        if authority.require_identity_binding
+            && authority.state.lease.as_ref().is_some_and(|lease| {
+                authority.current_identity.as_ref().is_none_or(|identity| {
+                    lease.identity_generation != identity.identity_generation
+                        || lease.snapshot_digest != identity.snapshot_digest
+                })
+            })
+        {
+            return Self::prepare_failure(
+                authority,
+                authority.state.clone(),
+                None,
+                ProtocolError("snapshot-stale"),
+            );
+        }
+        let parsed = decode_private_request(raw);
+        let (method, envelope) = match parsed {
+            Ok(parsed) => parsed,
+            Err(error) => return Self::prepare_failure(authority, authority.state.clone(), None, error),
+        };
+        if envelope.runtime_process_incarnation_id != authority.runtime_process_incarnation_id
+            || envelope.supplier_generation != authority.supplier_generation
+        {
+            return Self::prepare_failure(
+                authority,
+                authority.state.clone(),
+                None,
+                ProtocolError("generation-mismatch"),
+            );
+        }
+        let expected = match authority.state.incoming.next.as_ref() {
+            Some(expected) => expected,
+            None => {
+                return Self::prepare_failure(
+                    authority,
+                    authority.state.clone(),
+                    None,
+                    ProtocolError("sequence-invalid"),
+                );
+            }
+        };
+        if envelope.direction != "runtime-to-supplier"
+            || &envelope.sequence != expected
+            || envelope.previous_transcript_mac != authority.state.incoming.previous
+        {
+            return Self::prepare_failure(
+                authority,
+                authority.state.clone(),
+                None,
+                ProtocolError("sequence-invalid"),
+            );
+        }
+        let Some(secret) = authority.secret.as_ref() else {
+            return Self::silent_terminal();
+        };
+        if let Err(error) = verify_transcript_mac(secret.bytes(), &envelope) {
+            return Self::prepare_failure(authority, authority.state.clone(), None, error);
+        }
+        let mut state = authority.state.clone();
+        state.incoming.advance(&envelope);
+        let request_id = envelope.body["requestId"].as_str().map(str::to_owned);
+        match Self::process_authenticated(authority, state.clone(), method, envelope) {
+            Ok(prepared) => prepared,
+            Err(error) => Self::prepare_failure(authority, state, request_id.as_deref(), error),
+        }
+    }
+
+    fn process_authenticated(
+        authority: &EnabledAuthority,
+        mut state: AuthorityState,
+        method: String,
+        envelope: AuthorityEnvelope,
+    ) -> Result<PreparedAdmission, ProtocolError> {
+        let body = envelope.body.as_object().ok_or(ProtocolError("request-malformed"))?;
+        let request_id = body["requestId"].as_str().ok_or(ProtocolError("request-malformed"))?;
+        let (result, notification_method, notification) = match method.as_str() {
+            "chirality/admissionAcquire" => {
+                if state.lease.is_some() {
+                    return Self::error_result(authority, state, Some(request_id), "busy", "lease-busy");
+                }
+                if !state.outgoing.can_emit(2) {
+                    return Err(ProtocolError("sequence-invalid"));
+                }
+                let operation_id = body["operationId"].as_str().ok_or(ProtocolError("request-malformed"))?;
+                let v4 = body["v4"].as_object().ok_or(ProtocolError("request-malformed"))?;
+                if v4["supplierGeneration"].as_str() != Some(authority.supplier_generation.as_str()) { return Err(ProtocolError("generation-mismatch")); }
+                if authority.require_identity_binding {
+                    let current = authority
+                        .current_identity
+                        .as_ref()
+                        .ok_or(ProtocolError("snapshot-stale"))?;
+                    if v4["identityGeneration"].as_str()
+                        != Some(current.identity_generation.as_str())
+                        || v4["snapshotDigest"].as_str()
+                            != Some(current.snapshot_digest.as_str())
+                    {
+                        return Err(ProtocolError("snapshot-stale"));
+                    }
+                }
+                let lease_id = format!("lease-{:020}", state.next_lease);
+                let common = serde_json::json!({"requestId":request_id,"operationId":operation_id,"leaseId":lease_id,
+                    "supplierGeneration":v4["supplierGeneration"],"identityGeneration":v4["identityGeneration"],"snapshotDigest":v4["snapshotDigest"]});
+                state.next_lease = state.next_lease.checked_add(1).ok_or(ProtocolError("internal-failure"))?;
+                let current = authority.current_identity.clone().unwrap_or_else(|| IdentityBinding {
+                    identity_generation: v4["identityGeneration"]
+                        .as_str()
+                        .unwrap_or_default()
+                        .to_string(),
+                    snapshot_digest: v4["snapshotDigest"]
+                        .as_str()
+                        .unwrap_or_default()
+                        .to_string(),
+                });
+                state.lease = Some(AuthorityLease {
+                    lease_id: lease_id.clone(),
+                    operation_id: operation_id.to_owned(),
+                    identity_generation: current.identity_generation,
+                    snapshot_digest: current.snapshot_digest,
+                });
+                (merge(serde_json::json!({"kind":"result","op":"chirality/admissionAcquire","state":"acquired"}), &common),
+                    "chirality/admissionAcquired", merge(serde_json::json!({"kind":"notification","op":"chirality/admissionAcquired"}), &common))
+            }
+            "chirality/admissionRelease" | "chirality/admissionAbort" => {
+                let lease_id = body["leaseId"].as_str().ok_or(ProtocolError("request-malformed"))?;
+                let Some(held) = state.lease.as_ref() else { return Self::error_result(authority, state, Some(request_id), "malformed", "lease-unknown"); };
+                if held.lease_id != lease_id { return Self::error_result(authority, state, Some(request_id), "malformed", "lease-unknown"); }
+                if !state.outgoing.can_emit(2) {
+                    return Err(ProtocolError("sequence-invalid"));
+                }
+                let release = method.ends_with("Release");
+                let (state, notification_method) = if release { ("released", "chirality/admissionReleased") } else { ("aborted", "chirality/admissionAborted") };
+                let common = serde_json::json!({"requestId":request_id,"leaseId":lease_id,"disposition":body["disposition"]});
+                // The transition is staged before either frame becomes visible.
+                // The caller publishes this state only after reserving one writer batch.
+                (merge(serde_json::json!({"kind":"result","op":method,"state":state}), &common), notification_method,
+                    merge(serde_json::json!({"kind":"notification","op":notification_method}), &common))
+            }
+            _ => return Err(ProtocolError("request-malformed")),
+        };
+        let result_envelope = Self::encode(authority, &mut state, result)?;
+        let notification_envelope = Self::encode(authority, &mut state, notification)?;
+        if method != "chirality/admissionAcquire" {
+            state.lease = None;
+        }
+        let _ = notification_method;
+        Ok(PreparedAdmission {
+            outputs: vec![
+                AdmissionOutput::Frame(result_envelope.to_value()),
+                AdmissionOutput::Frame(notification_envelope.to_value()),
+            ],
+            state: Some(state),
+            terminal: false,
+        })
+    }
+
+    fn error_result(
+        authority: &EnabledAuthority,
+        mut state: AuthorityState,
+        request_id: Option<&str>,
+        class: &str,
+        reason: &str,
+    ) -> Result<PreparedAdmission, ProtocolError> {
+        let body = serde_json::json!({"kind":"result","op":"error","state":"error","requestId":request_id,"class":class,"reason":reason});
+        let envelope = Self::encode(authority, &mut state, body)?;
+        Ok(PreparedAdmission {
+            outputs: vec![AdmissionOutput::Frame(envelope.to_value())],
+            state: Some(state),
+            terminal: false,
+        })
+    }
+
+    fn encode(
+        authority: &EnabledAuthority,
+        state: &mut AuthorityState,
+        body: Value,
+    ) -> Result<AuthorityEnvelope, ProtocolError> {
+        let sequence = state.outgoing.next.clone().ok_or(ProtocolError("sequence-invalid"))?;
+        let mut envelope = AuthorityEnvelope {
+            contract: AUTHORITY_CONTRACT.to_owned(), runtime_process_incarnation_id: authority.runtime_process_incarnation_id.clone(),
+            supplier_generation: authority.supplier_generation.clone(), direction: "supplier-to-runtime".to_owned(), sequence,
+            previous_transcript_mac: state.outgoing.previous.clone(), body, transcript_mac: String::new(),
+        };
+        let secret = authority.secret.as_ref().ok_or(ProtocolError("authority-revoked"))?;
+        envelope.transcript_mac = transcript_mac(secret.bytes(), &envelope)?;
+        state.outgoing.advance(&envelope);
+        Ok(envelope)
+    }
+
+    fn prepare_failure(
+        authority: &EnabledAuthority,
+        mut state: AuthorityState,
+        request_id: Option<&str>,
+        error: ProtocolError,
+    ) -> PreparedAdmission {
+        let Some(last_runtime_sequence) = state.incoming.last.clone() else {
+            return Self::terminal(state, Vec::new());
+        };
+        if !state.outgoing.can_emit(1) {
+            return Self::terminal(state, Vec::new());
+        }
+        let (class, reason) = match error.0 {
+            "generation-mismatch" => ("protocol", "generation-mismatch"),
+            "sequence-invalid" => ("protocol", "sequence-invalid"),
+            "transcript-invalid" => ("protocol", "transcript-invalid"),
+            "internal-failure" => ("internal", "internal-failure"),
+            "snapshot-stale" => ("stale", "snapshot-stale"),
+            _ => ("malformed", "request-malformed"),
+        };
+        let error_body = serde_json::json!({
+            "kind":"result","op":"error","state":"error","requestId":request_id,
+            "class":class,"reason":reason
+        });
+        let Ok(error_envelope) = Self::encode(authority, &mut state, error_body) else {
+            return Self::terminal(state, Vec::new());
+        };
+        let mut outputs = vec![AdmissionOutput::Frame(error_envelope.to_value())];
+        if state.outgoing.can_emit(1) {
+            let revoke_body = serde_json::json!({
+                "kind":"notification","op":"chirality/admissionRevoked",
+                "reason":"protocol-failure",
+                "revokedThroughRuntimeSequence":last_runtime_sequence.0
+            });
+            if let Ok(revoke) = Self::encode(authority, &mut state, revoke_body) {
+                outputs.push(AdmissionOutput::Frame(revoke.to_value()));
+            }
+        }
+        Self::terminal(state, outputs)
+    }
+
+    pub(crate) fn prepare_revoke(&self, reason: &'static str) -> PreparedAdmission {
+        let Some(authority) = self.authority.as_ref() else {
+            return Self::silent_terminal();
+        };
+        let mut state = authority.state.clone();
+        let Some(last_runtime_sequence) = state.incoming.last.clone() else {
+            return Self::terminal(state, Vec::new());
+        };
+        if !state.outgoing.can_emit(1) {
+            return Self::terminal(state, Vec::new());
+        }
+        let body = serde_json::json!({
+            "kind":"notification","op":"chirality/admissionRevoked",
+            "reason":reason,"revokedThroughRuntimeSequence":last_runtime_sequence.0
+        });
+        let outputs = Self::encode(authority, &mut state, body)
+            .map(|envelope| vec![AdmissionOutput::Frame(envelope.to_value())])
+            .unwrap_or_default();
+        Self::terminal(state, outputs)
+    }
+
+    fn terminal(mut state: AuthorityState, outputs: Vec<AdmissionOutput>) -> PreparedAdmission {
+        state.closed = true;
+        state.lease = None;
+        PreparedAdmission {
+            outputs,
+            state: Some(state),
+            terminal: true,
+        }
+    }
+
+    fn silent_terminal() -> PreparedAdmission {
+        PreparedAdmission {
+            outputs: Vec::new(),
+            state: None,
+            terminal: true,
+        }
+    }
+
+    pub(crate) fn activate(&mut self, prepared: PreparedAdmission) -> Vec<AdmissionOutput> {
+        if let Some(authority) = self.authority.as_mut()
+            && let Some(state) = prepared.state
+        {
+            authority.state = state;
+            if prepared.terminal {
+                authority.secret = None;
+            }
+        }
+        prepared.outputs
+    }
+
+    pub(crate) fn delivery_failed(&mut self) {
+        if let Some(authority) = self.authority.as_mut() {
+            authority.state.closed = true;
+            authority.state.lease = None;
+            authority.secret = None;
+        }
+    }
+
+    pub(crate) fn connection_closed(&mut self, connection_id: u64) {
+        if self
+            .authority
+            .as_ref()
+            .is_some_and(|authority| authority.connection_id == connection_id)
+        {
+            self.delivery_failed();
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn process_raw_for_test(
+        &mut self,
+        connection_id: u64,
+        raw: &[u8],
+    ) -> Vec<AdmissionOutput> {
+        let prepared = self.prepare_raw(connection_id, raw);
+        self.activate(prepared)
+    }
