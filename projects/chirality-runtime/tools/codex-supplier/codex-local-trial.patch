+#[cfg(test)]
+mod chirality_native_tools_tests {
+    use super::*;
+    use serde::Deserialize;
+    use serde_json::json;
+
+    const RUNTIME_FIXTURE: &str = include_str!(
+        "../../../tests/fixtures/codex-native-tools-v1.json"
+    );
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct RuntimeVector {
+        name: String,
+        #[serde(default)]
+        input: Option<Vec<ChiralityInheritableToolDefinition>>,
+        #[serde(default)]
+        input_encoding: Option<JsonValue>,
+        encoded_hex: String,
+        sha256: String,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct RuntimeRejection {
+        name: String,
+        #[serde(default)]
+        input: Option<Vec<ChiralityInheritableToolDefinition>>,
+        #[serde(default)]
+        input_encoding: Option<JsonValue>,
+        expected: String,
+    }
+
+    #[derive(Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct RuntimeFixture {
+        schema: String,
+        input: Vec<ChiralityInheritableToolDefinition>,
+        encoded_hex: String,
+        sha256: String,
+        vectors: Vec<RuntimeVector>,
+        rejections: Vec<RuntimeRejection>,
+    }
+
+    fn tool(name: &str, description: &str, input_schema: JsonValue) -> ChiralityInheritableToolDefinition {
+        ChiralityInheritableToolDefinition {
+            name: name.to_string(),
+            description: description.to_string(),
+            input_schema,
+        }
+    }
+
+    fn decode_hex(value: &str) -> Vec<u8> {
+        value
+            .as_bytes()
+            .chunks_exact(2)
+            .map(|pair| {
+                let digit = |byte: u8| match byte {
+                    b'0'..=b'9' => byte - b'0',
+                    b'a'..=b'f' => byte - b'a' + 10,
+                    _ => panic!("invalid fixture hex"),
+                };
+                digit(pair[0]) << 4 | digit(pair[1])
+            })
+            .collect()
+    }
+
+    fn fixture() -> RuntimeFixture {
+        serde_json::from_str(RUNTIME_FIXTURE).expect("Runtime fixture must remain valid JSON")
+    }
+
+    fn recipe_input(recipe: &JsonValue) -> Option<Vec<ChiralityInheritableToolDefinition>> {
+        let kind = recipe.get("kind")?.as_str()?;
+        let mut input: Vec<ChiralityInheritableToolDefinition> =
+            serde_json::from_value(recipe.get("input")?.clone()).ok()?;
+        match kind {
+            "replace-value" => {
+                let semantic = recipe.pointer("/value/semantic")?.as_str()?;
+                let value = match semantic {
+                    "negative-zero" => json!(-0.0),
+                    // These values deliberately have no serde_json representation. They are
+                    // covered by the Runtime host-domain fixture and cannot reach this Rust API.
+                    "nonfinite-number" | "unpaired-utf16-code-unit" | "non-plain-object" => {
+                        return None;
+                    }
+                    _ => panic!("unknown replace-value recipe: {semantic}"),
+                };
+                replace_recipe_value(&mut input, recipe.get("path")?, value);
+            }
+            "nest-array-schema" => {
+                let depth = recipe.get("depth")?.as_u64()? as usize;
+                let mut value = recipe.get("leaf")?.clone();
+                for _ in 0..depth {
+                    value = json!({"type":"array","items":value});
+                }
+                replace_recipe_value(&mut input, recipe.get("path")?, value);
+            }
+            "generate-indexed-object" => {
+                let count = recipe.get("count")?.as_u64()? as usize;
+                let prefix = recipe.get("keyPrefix")?.as_str()?;
+                let item = recipe.get("item")?.clone();
+                let value = JsonValue::Object(
+                    (0..count)
+                        .map(|index| (format!("{prefix}{index}"), item.clone()))
+                        .collect(),
+                );
+                replace_recipe_value(&mut input, recipe.get("path")?, value);
+            }
+            "generate-integer-range" => {
+                let start = recipe.get("start")?.as_i64()?;
+                let count = recipe.get("count")?.as_u64()? as usize;
+                let value = JsonValue::Array((0..count).map(|offset| json!(start + offset as i64)).collect());
+                replace_recipe_value(&mut input, recipe.get("path")?, value);
+            }
+            "repeat-ascii-string" => {
+                let byte = recipe.get("byte")?.as_str()?;
+                assert_eq!(byte.len(), 1);
+                let len = recipe.get("byteLength")?.as_u64()? as usize;
+                replace_recipe_value(&mut input, recipe.get("path")?, json!(byte.repeat(len)));
+            }
+            _ => panic!("unknown fixture recipe: {kind}"),
+        }
+        Some(input)
+    }
+
+    fn replace_recipe_value(
+        input: &mut Vec<ChiralityInheritableToolDefinition>,
+        path: &JsonValue,
+        value: JsonValue,
+    ) {
+        let mut wire = serde_json::to_value(&*input).unwrap();
+        let mut current = &mut wire;
+        for component in path.as_array().unwrap() {
+            current = match component {
+                JsonValue::Number(index) => &mut current.as_array_mut().unwrap()[index.as_u64().unwrap() as usize],
+                JsonValue::String(key) => current.as_object_mut().unwrap().get_mut(key).unwrap(),
+                _ => panic!("invalid fixture path component"),
+            };
+        }
+        *current = value;
+        *input = serde_json::from_value(wire).unwrap();
+    }
+
+    #[test]
+    fn native_tools_encoder_matches_runtime_empty_and_integral_decimal_vectors() {
+        assert_eq!(
+            encode_chirality_inheritable_tools(&[]).unwrap(),
+            decode_hex("63686972616c6974792d6e61746976652d746f6f6c732f76310061303a")
+        );
+        let encoded = encode_chirality_inheritable_tools(&[tool(
+            "x",
+            "integral decimal spelling",
+            json!({"type":"number","enum":[1.0]}),
+        )])
+        .unwrap();
+        assert_eq!(
+            encoded,
+            decode_hex("63686972616c6974792d6e61746976652d746f6f6c732f76310061313a6f333a7331313a6465736372697074696f6e7332353a696e74656772616c20646563696d616c207370656c6c696e677331313a696e707574536368656d616f323a73343a656e756d61313a69313b73343a7479706573363a6e756d62657273343a6e616d6573313a78")
+        );
+    }
+
+    #[test]
+    fn native_tools_encoder_rejects_fractional_unsafe_duplicate_and_unknown_schema() {
+        for tools in [
+            vec![tool("x", "x", json!({"type":"number","minimum":1.5}))],
+            vec![tool("x", "x", json!({"type":"integer","maximum":9007199254740992_u64}))],
+            vec![tool("x", "x", json!({"type":"string","unknown":true}))],
+            vec![
+                tool("x", "first", json!({"type":"object","properties":{},"additionalProperties":false})),
+                tool("x", "second", json!({"type":"object","properties":{},"additionalProperties":false})),
+            ],
+        ] {
+            assert!(encode_chirality_inheritable_tools(&tools).is_err());
+        }
+    }
+
+    #[test]
+    fn native_tools_encoder_matches_every_runtime_fixture_byte_vector() {
+        let fixture = fixture();
+        assert_eq!(fixture.schema, CHIRALITY_NATIVE_TOOLS_SCHEMA);
+        assert_eq!(
+            encode_chirality_inheritable_tools(&fixture.input).unwrap(),
+            decode_hex(&fixture.encoded_hex),
+            "primary vector whose accepted SHA-256 is {}",
+            fixture.sha256,
+        );
+        for vector in fixture.vectors {
+            let input = vector
+                .input
+                .or_else(|| vector.input_encoding.as_ref().and_then(recipe_input))
+                .unwrap_or_else(|| panic!("Rust-representable positive vector {}", vector.name));
+            assert_eq!(
+                encode_chirality_inheritable_tools(&input).unwrap(),
+                decode_hex(&vector.encoded_hex),
+                "vector {} whose accepted SHA-256 is {}",
+                vector.name,
+                vector.sha256,
+            );
+        }
+    }
+
+    #[test]
+    fn native_tools_encoder_rejects_every_runtime_fixture_recipe_representable_in_rust() {
+        let fixture = fixture();
+        let mut host_only = Vec::new();
+        for rejection in fixture.rejections {
+            assert_eq!(rejection.expected, "reject");
+            let input = rejection
+                .input
+                .or_else(|| rejection.input_encoding.as_ref().and_then(recipe_input));
+            match input {
+                Some(input) => assert!(
+                    encode_chirality_inheritable_tools(&input).is_err(),
+                    "fixture rejection {} was accepted",
+                    rejection.name,
+                ),
+                None => host_only.push(rejection.name),
+            }
+        }
+        assert_eq!(
+            host_only,
+            ["nonfinite-number", "unpaired-surrogate", "non-plain-object"],
+            "only Runtime host-domain values without a serde_json representation may be skipped",
+        );
+    }
+}
 
