+#[derive(Clone)]
+pub struct IdentityConfigView {
+    owner: Arc<Mutex<JoinedIdentityPublisher>>,
+    operation: Weak<AtomicBool>,
+    source: IdentityConfigSourceBinding,
+    source_generation: u64,
+    inputs: Arc<AtomicU64>,
+    input_generation: u64,
+    authorization: Arc<OwnedCloudAuthorization>,
+}
+fn identity_view_error() -> std::io::Error {
+    std::io::Error::other("identity config view is unavailable or stale")
+}
+tokio::task_local! { static IDENTITY_CONFIG_VIEW: IdentityConfigView; }
+impl IdentityConfigView {
+    pub fn validate(
+        &self,
+        manager: &AuthManager,
+        source: &IdentityConfigSourceBinding,
+    ) -> std::io::Result<()> {
+        if !Arc::ptr_eq(&self.owner, &manager.joined_identity)
+            || !Arc::ptr_eq(&source.owner, &self.owner)
+            || !Arc::ptr_eq(&source.service, &self.source.service)
+            || self.source_generation != source.generation.load(Ordering::Acquire)
+            || self.input_generation != self.inputs.load(Ordering::Acquire)
+            || !self
+                .operation
+                .upgrade()
+                .is_some_and(|live| live.load(Ordering::Acquire))
+        {
+            return Err(identity_view_error());
+        }
+        Ok(())
+    }
+    pub fn authorization(&self) -> &OwnedCloudAuthorization {
+        &self.authorization
+    }
+}
+
+impl AuthManager {
+    pub fn check_identity_guard(&self, guard: &IdentityTransitionGuard) -> std::io::Result<()> {
+        if Arc::ptr_eq(&self.joined_identity, &guard.joined_identity)
+            && guard.operation_live.load(Ordering::Acquire)
+        {
+            Ok(())
+        } else {
+            Err(identity_view_error())
+        }
+    }
+    pub fn new_identity_config_source(&self) -> IdentityConfigSourceBinding {
+        IdentityConfigSourceBinding {
+            owner: Arc::clone(&self.joined_identity),
+            service: Arc::new(()),
+            generation: Arc::new(AtomicU64::new(0)),
+        }
+    }
+    pub fn capture_identity_config_view(
+        &self,
+        guard: &IdentityTransitionGuard,
+        source: &IdentityConfigSourceBinding,
+        inputs: Arc<AtomicU64>,
+    ) -> std::io::Result<IdentityConfigView> {
+        self.check_identity_guard(guard)?;
+        if !Arc::ptr_eq(&source.owner, &self.joined_identity) {
+            return Err(identity_view_error());
+        }
+        let cached = self.inner.read().map_err(|_| identity_view_error())?;
+        let view = IdentityConfigView {
+            owner: Arc::clone(&self.joined_identity),
+            operation: Arc::downgrade(&guard.operation_live),
+            source: source.clone(),
+            source_generation: source.generation.load(Ordering::Acquire),
+            input_generation: inputs.load(Ordering::Acquire),
+            inputs,
+            authorization: Arc::new(OwnedCloudAuthorization::capture(cached.auth.as_ref())?),
+        };
+        view.validate(self, source)?;
+        Ok(view)
+    }
+    pub async fn with_identity_config_view<T>(
+        &self,
+        guard: &IdentityTransitionGuard,
+        view: IdentityConfigView,
+        future: impl Future<Output = T>,
+    ) -> std::io::Result<T> {
+        self.check_identity_guard(guard)?;
+        if !view
+            .operation
+            .upgrade()
+            .is_some_and(|live| Arc::ptr_eq(&live, &guard.operation_live))
+        {
+            return Err(identity_view_error());
+        }
+        view.validate(self, &view.source)?;
+        let result = IDENTITY_CONFIG_VIEW
+            .scope(view.clone(), Box::pin(future))
+            .await;
+        view.validate(self, &view.source)?;
+        Ok(result)
+    }
+    pub fn current_identity_config_view(
+        &self,
+        source: &IdentityConfigSourceBinding,
+    ) -> std::io::Result<Option<IdentityConfigView>> {
+        match IDENTITY_CONFIG_VIEW.try_with(Clone::clone) {
+            Err(_) => Ok(None),
+            Ok(view) => {
+                view.validate(self, source)?;
+                Ok(Some(view))
+            }
+        }
+    }
+    pub async fn register_unclosed_config_input_owner(&self) {
+        let mut guard = self.begin_identity_transition().await;
+        guard.mark_mutation_started();
+        self.joined_identity
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .unclosed_config_owner = true;
+        self.commit_identity_parts(&mut guard, None, None, None, ExternalAuthUpdate::Keep);
+    }
+}
+
+/// Exclusive ownership of an identity-affecting transition. Callers that combine
+/// storage/config work with auth publication retain this guard through their
+/// response and success notifications.
+pub struct IdentityTransitionGuard {
+    _permit: OwnedMutexGuard<()>,
+    operation_live: Arc<AtomicBool>,
+    joined_identity: Arc<Mutex<JoinedIdentityPublisher>>,
+    mutation_started: bool,
+    committed: bool,
+    previous_snapshot: Option<JoinedIdentitySnapshot>,
+    defer_publication: bool,
+    semantic_changed: bool,
+    auth_revision_changed: bool,
+    delivery_pending: bool,
+}
+
+/// Owns a private-authority enable transition across the initialize response's
+/// final-writer acknowledgement. Until [`Self::complete`] is called, dropping
+/// this value clears the staged enablement and fences the joined identity.
+pub struct PrivateIdentityAuthorityEnableTransition<'a> {
+    manager: &'a AuthManager,
+    transition: Option<IdentityTransitionGuard>,
+    armed: bool,
+}
+
+impl PrivateIdentityAuthorityEnableTransition<'_> {
+    /// Publishes the already-staged enablement after the initialize response is
+    /// known to have reached the final writer. This performs no async work.
+    pub fn commit_after_delivery(&mut self) -> std::io::Result<JoinedIdentitySnapshot> {
+        let transition = self.transition.as_mut().ok_or_else(identity_view_error)?;
+        transition.resume_publication();
+        self.manager.commit_identity_parts(
+            transition,
+            None,
+            None,
+            None,
+            ExternalAuthUpdate::Keep,
+        );
+        if !transition.committed {
+            return Err(identity_view_error());
+        }
+        let publisher = self
+            .manager
+            .joined_identity
+            .lock()
+            .map_err(|_| identity_view_error())?;
+        if !publisher.private_authority_enabled
+            || matches!(publisher.snapshot.qualification,
+                JoinedIdentityQualification::Unavailable { ref reason }
+                    if reason == "identity-transition-pending")
+        {
+            return Err(identity_view_error());
+        }
+        Ok(publisher.snapshot.clone())
+    }
+
+    /// Publishes and runs the owning connection's no-await finalization while
+    /// rollback remains armed. Returning `false` leaves the transition fenced.
+    pub fn commit_after_delivery_with(
+        mut self,
+        finish_connection: impl FnOnce() -> bool,
+    ) -> std::io::Result<JoinedIdentitySnapshot> {
+        let snapshot = self.commit_after_delivery()?;
+        if !finish_connection() {
+            return Err(identity_view_error());
+        }
+        self.armed = false;
+        Ok(snapshot)
+    }
+
+    /// Disarms rollback after the owning connection has installed its claimed
+    /// session state and marked private mode live.
+    pub fn complete(mut self) {
+        self.armed = false;
+    }
+}
+
+impl Drop for PrivateIdentityAuthorityEnableTransition<'_> {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        let Some(transition) = self.transition.as_mut() else {
+            return;
+        };
+        if let Ok(mut publisher) = self.manager.joined_identity.lock() {
+            publisher.private_authority_enabled = false;
+            let previous_hard_failure = transition.previous_snapshot.as_ref().is_some_and(
+                |snapshot| matches!(&snapshot.qualification,
+                    JoinedIdentityQualification::Unavailable { reason }
+                        if matches!(reason.as_str(),
+                            "identity-reconciliation-required"
+                                | "identity-generation-exhausted"
+                                | "unclosed-config-input-owner")),
+            );
+            if previous_hard_failure {
+                if let Some(previous) = transition.previous_snapshot.take() {
+                    publisher.restore(previous);
+                    transition.committed = true;
+                }
+            } else {
+                transition.committed = false;
+            }
+        }
+    }
+}
+
+enum ExternalAuthUpdate {
+    Keep,
+    Replace(Option<Arc<dyn ExternalAuth>>),
+}
+
+impl IdentityTransitionGuard {
+    /// Closes admission before an identity-affecting side effect starts.
+    pub fn mark_mutation_started(&mut self) {
+        if self.mutation_started {
+            return;
+        }
+        if let Ok(mut publisher) = self.joined_identity.lock() {
+            self.previous_snapshot = Some(publisher.mark_pending());
+            self.mutation_started = true;
+        }
+    }
+
+    /// Keeps intermediate auth/config commits hidden until the complete joined reload.
+    pub fn defer_publication(&mut self) {
+        self.defer_publication = true;
+    }
+    pub fn resume_publication(&mut self) {
+        self.defer_publication = false;
+    }
+
+    /// Marks an unsuccessful output release without rolling back committed inputs.
+    pub fn begin_output(&mut self) {
+        self.delivery_pending = true;
+    }
+
+    pub fn record_output_result(&mut self, enqueued: bool) {
+        self.delivery_pending = false;
+        if !enqueued {
+            if let Ok(mut publisher) = self.joined_identity.lock() {
+                publisher.require_reconciliation();
+            }
+            self.committed = true;
+        }
+    }
+
+    pub fn needs_reconciliation(&self) -> bool {
+        self.mutation_started && !self.committed
+    }
+
+    pub fn begin_next_mutation(&mut self) {
+        self.mutation_started = false;
+        self.committed = false;
+        self.previous_snapshot = None;
+        self.mark_mutation_started();
+    }
+
+    /// Restores the exact prior published state after a failure known to have
+    /// made no authoritative change.
+    pub fn finish_without_change(mut self) {
+        self.finish_current_mutation_without_change();
+    }
+
+    pub fn finish_current_mutation_without_change(&mut self) {
+        if let Some(previous) = self.previous_snapshot.take()
+            && let Ok(mut publisher) = self.joined_identity.lock()
+        {
+            publisher.restore(previous);
+        }
+        self.committed = true;
+    }
+}
+
+impl Drop for IdentityTransitionGuard {
+    fn drop(&mut self) {
+        self.operation_live.store(false, Ordering::Release);
+        if (self.delivery_pending || (self.mutation_started && !self.committed))
+            && let Ok(mut publisher) = self.joined_identity.lock()
+        {
+            publisher.require_reconciliation();
+        }
+    }
+}
