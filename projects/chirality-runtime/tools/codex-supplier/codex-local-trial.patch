+        std::hint::black_box(&mut self.0);
+    }
+}
+
+pub(crate) struct SecretConsumer {
+    consumed: AtomicBool,
+}
+
+impl SecretConsumer {
+    pub(crate) const fn new() -> Self { Self { consumed: AtomicBool::new(false) } }
+
+    fn claim(&self) -> Result<(), ProtocolError> {
+        if self
+            .consumed
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return Err(ProtocolError("authority-secret-already-consumed"));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn consume<R: Read>(&self, reader: R) -> Result<AuthoritySecret, ProtocolError> {
+        self.claim()?;
+        self.consume_claimed(reader)
+    }
+
+    fn consume_claimed<R: Read>(&self, reader: R) -> Result<AuthoritySecret, ProtocolError> {
+        self.consume_claimed_with_observer(reader, |_| {})
+    }
+
+    fn consume_claimed_with_observer<R, F>(
+        &self,
+        mut reader: R,
+        cleared: F,
+    ) -> Result<AuthoritySecret, ProtocolError>
+    where
+        R: Read,
+        F: FnOnce(&[u8; 33]),
+    {
+        let mut temporary = [0_u8; 33];
+        let result = (|| {
+            let mut read = 0;
+            while read < temporary.len() {
+                match reader.read(&mut temporary[read..]) {
+                    Ok(0) => break,
+                    Ok(count) => read += count,
+                    Err(_) => return Err(ProtocolError("authority-secret-read-failed")),
+                }
+            }
+            if read != 32 {
+                return Err(ProtocolError("authority-secret-length-invalid"));
+            }
+            let mut secret = [0_u8; 32];
+            secret.copy_from_slice(&temporary[..32]);
+            Ok(AuthoritySecret(secret))
+        })();
+        temporary.fill(0);
+        std::hint::black_box(&mut temporary);
+        cleared(&temporary);
+        result
+    }
+
+    #[cfg(test)]
+    pub(crate) fn consume_with_zeroization_probe<R: Read>(
+        &self,
+        reader: R,
+    ) -> (Result<AuthoritySecret, ProtocolError>, bool) {
+        use std::cell::Cell;
+
+        let cleared = Cell::new(false);
+        let result = self.claim().and_then(|()| {
+            self.consume_claimed_with_observer(reader, |temporary| {
+                cleared.set(temporary.iter().all(|byte| *byte == 0));
+            })
+        });
+        (result, cleared.get())
+    }
+}
