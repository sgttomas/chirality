+    pub(crate) fn live_lease_matches(
+        &self,
+        connection_id: u64,
+        identity: &IdentityBinding,
+    ) -> bool {
+        self.authority.as_ref().is_some_and(|authority| {
+            !authority.state.closed
+                && authority.connection_id == connection_id
+                && authority.state.lease.as_ref().is_some_and(|lease| {
+                    lease.identity_generation == identity.identity_generation
+                        && lease.snapshot_digest == identity.snapshot_digest
+                })
+        })
+    }
+
+    pub(crate) fn current_operation_binding(
+        &self,
+        connection_id: u64,
+        identity: &IdentityBinding,
+    ) -> Option<OperationBinding> {
+        let authority = self.authority.as_ref()?;
+        if authority.state.closed || authority.connection_id != connection_id {
+            return None;
+        }
+        let lease = authority.state.lease.as_ref()?;
+        (lease.identity_generation == identity.identity_generation
+            && lease.snapshot_digest == identity.snapshot_digest)
+            .then(|| OperationBinding {
+                supplier_generation: authority.supplier_generation.clone(),
+                lease_id: lease.lease_id.clone(),
+                operation_id: lease.operation_id.clone(),
+                identity: identity.clone(),
+            })
+    }
+
+    pub(crate) fn live_operation_matches(
+        &self,
+        connection_id: u64,
+        binding: &OperationBinding,
+    ) -> bool {
+        self.authority.as_ref().is_some_and(|authority| {
+            !authority.state.closed
+                && authority.connection_id == connection_id
+                && authority.supplier_generation == binding.supplier_generation
+                && authority.state.lease.as_ref().is_some_and(|lease| {
+                    lease.lease_id == binding.lease_id
+                        && lease.operation_id == binding.operation_id
+                        && lease.identity_generation == binding.identity.identity_generation
+                        && lease.snapshot_digest == binding.identity.snapshot_digest
+                })
+        })
+    }
