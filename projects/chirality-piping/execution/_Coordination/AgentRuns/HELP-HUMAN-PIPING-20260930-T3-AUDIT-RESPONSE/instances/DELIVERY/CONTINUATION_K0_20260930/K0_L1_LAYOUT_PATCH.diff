+    const fn row<T>(id: u64) -> [u64; 15] {
+        let a0 = array::<T>(0);
+        let a1 = array::<T>(1);
+        let a3 = array::<T>(3);
+        let a17 = array::<T>(17);
+        let a512 = array::<T>(512);
+        let a4096 = array::<T>(4096);
+        [id, size_of::<T>() as u64, align_of::<T>() as u64,
+         a0[0], a0[1], a1[0], a1[1], a3[0], a3[1],
+         a17[0], a17[1], a512[0], a512[1], a4096[0], a4096[1]]
+    }
