+    const fn array<T>(count: usize) -> [u64; 2] {
+        match Layout::array::<T>(count) {
+            Ok(layout) => [layout.size() as u64, layout.align() as u64],
+            Err(_) => panic!("K0 array-layout overflow"),
+        }
+    }
+    // ID, type size/alignment; requested array size/alignment at capacities
