+    // Derived from pinned alloc/sync.rs ArcInner repr(C, align(2)) and its
+    // layout helper. This is an explicit source derivation, not size_of of a
+    // mirrored private stdlib type. AtomicUsize layout is the actual target's.
+    const fn arc_layout<T>(id: u64) -> [u64; 3] {
+        let header = Layout::new::<[std::sync::atomic::AtomicUsize; 2]>();
+        match header.extend(Layout::new::<T>()) {
+            Ok((layout, _)) => {
+                let layout = layout.pad_to_align();
+                [id, layout.size() as u64, layout.align() as u64]
+            }
+            Err(_) => panic!("K0 Arc-layout overflow"),
+        }
+    }
