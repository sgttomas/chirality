"loads.seismic\",\n      \"label\": \"Seismic static-g fields\",\n      \"group\": \"Loads\",\n      \"vocabularyRows\": [\n        7\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Choose gravity acceleration or an axis factor in the selected case field editor.\",\n      \"requires\": \"load\",\n      \"route\": {\n        \"surface\": \"inspector\",\n        \"inspectorView\": \"task\",\n        \"focusTestId\": \"editor-intent-field\"\n      }\n    },\n    {\n      \"id\": \"loads.combinations\",\n      \"label\": \"Combinations\",\n      \"group\": \"Loads\",\n      \"vocabularyRows\": [\n        8\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Create mechanics, subtraction or range-envelope combinations.\",\n      \"route\": {\n        \"surface\": \"loads\",\n        \"focusTestId\": \"load-manager-create-combination-id\"\n      }\n    },\n    {\n      \"id\": \"loads.self-weight\",\n      \"label\": \"Generate self-weight\",\n      \"group\": \"Loads\",\n      \"vocabularyRows\": [\n        22\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Generate a reviewed load-case batch from selected pipes, entered mass inputs and explicit gravity.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"self-weight-plan\"\n      }\n    },\n    {\n      \"id\": \"edit.remove\",\n      \"label\": \"Remove selected entity\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        1,\n        2,\n        18\n      ],\n      \"status\": \"partial\",\n      \"description\": \"Review removal of a node, pipe, support, material, section or component. References can block application.\",\n      \"requires\": \"removable\",\n      \"route\": {\n        \"surface\": \"inspector\",\n        \"inspectorView\": \"properties\",\n        \"focusTestId\": \"\"\n      }\n    },\n    {\n      \"id\": \"edit.copy\",\n      \"label\": \"Copy\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        20\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Select explicit pipe sources and enter the transformation, units and identities. Attached entities can block application.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"geometry-tools\"\n      }\n    },\n    {\n      \"id\": \"edit.rotate\",\n      \"label\": \"Rotate\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        20\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Select explicit pipe sources and enter the transformation, units and identities. Attached entities can block application.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"geometry-tools\"\n      }\n    },\n    {\n      \"id\": \"edit.mirror\",\n      \"label\": \"Mirror\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        20\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Select explicit pipe sources and enter the transformation, units and identities. Attached entities can block application.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"geometry-tools\"\n      }\n    },\n    {\n      \"id\": \"edit.undo\",\n      \"label\": \"Undo\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        10\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Restore the previous session checkpoint (up to 25 edits).\",\n      \"history\": \"undo\"\n    },\n    {\n      \"id\": \"edit.redo\",\n      \"label\": \"Redo\",\n      \"group\": \"Edit\",\n      \"vocabularyRows\": [\n        10\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Restore the next session checkpoint.\",\n      \"history\": \"redo\"\n    },\n    {\n      \"id\": \"view.select\",\n      \"label\": \"Select / search model\",\n      \"group\": \"Select and View\",\n      \"vocabularyRows\": [\n        9\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Find an entity by name, ID, type or group.\",\n      \"route\": {\n        \"surface\": \"tree\",\n        \"focusTestId\": \"model-tree-filter-input\"\n      }\n    },\n    {\n      \"id\": \"view.units\",\n      \"label\": \"Display units\",\n      \"group\": \"Select and View\",\n      \"vocabularyRows\": [\n        24\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Select Entered, SI or US readout units. Editing stays in entered units; unavailable conversions are explained.\",\n      \"route\": {\n        \"surface\": \"viewport\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"display-unit-preference\"\n      }\n    },\n    {\n      \"id\": \"review.pending\",\n      \"label\": \"Pending changes and details\",\n      \"group\": \"Review\",\n      \"vocabularyRows\": [\n        11\n      ],\n      \"status\": \"supported\",\n      \"description\": \"Validate, review the diff and explicitly apply user-authored changes.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"workspace-section-operations\"\n      }\n    },\n    {\n      \"id\": \"review.agent\",\n      \"label\": \"Agent validate / preview / apply\",\n      \"group\": \"Review\",\n      \"vocabularyRows\": [\n        11\n      ],\n      \"status\": \"partial\",\n      \"description\": \"Import an offline proposal, validate and preview, then explicitly apply. Live provider integration remains held.\",\n      \"route\": {\n        \"surface\": \"operations\",\n        \"focusTestId\": \"\",\n        \"elementId\": \"offline-proposal-intake\"\n      }\n    }\n  ],\n  \"operation_schema\": {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"$id\": \"https://openpipestress.org/schemas/model_operation.schema.json\",\n    \"title\": \"OpenPipeStress Structured Model Operation Schema\",\n    \"description\": \"Strict JSON Schema 2020-12 contract for proposed model operations. Operations are the structured route for GUI and agent edit proposals and remain proposals until later validation, preview, and user review boundaries apply.\",\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\n      \"schema_version\",\n      \"deliverable_id\",\n      \"package_id\",\n      \"scope_item\",\n      \"objectives\",\n      \"operation_contract_status\",\n      \"operation_set\"\n    ],\n    \"properties\": {\n      \"schema_version\": {\n        \"type\": \"string\",\n        \"pattern\": \"^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n      },\n      \"deliverable_id\": {\n        \"const\": \"DEL-16-01\"\n      },\n      \"package_id\": {\n        \"const\": \"PKG-16\"\n      },\n      \"scope_item\": {\n        \"const\": \"SOW-069\"\n      },\n      \"objectives\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"contains\": {\n          \"const\": \"OBJ-015\"\n        },\n        \"items\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"OBJ-015\"\n          ]\n        }\n      },\n      \"operation_contract_status\": {\n        \"$ref\": \"#/$defs/OperationContractStatus\"\n      },\n      \"operation_set\": {\n        \"$ref\": \"#/$defs/OperationSet\"\n      }\n    },\n    \"$defs\": {\n      \"AssumptionRecord\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"assumption_id\",\n          \"statement\",\n          \"status\",\n          \"affected_refs\",\n          \"provenance\"\n        ],\n        \"properties\": {\n          \"assumption_id\": {\n            \"$ref\": \"#/$defs/Id\"\n          },\n          \"statement\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"unresolved\",\n              \"resolved\",\n              \"rejected\",\n              \"TBD\"\n            ]\n          },\n          \"affected_refs\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Reference\"\n            }\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          }\n        }\n      },\n      \"Checksum\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"algorithm\",\n          \"canonicalization\",\n          \"payload_ref\",\n          \"payload_scope\",\n          \"value\"\n        ],\n        \"properties\": {\n          \"algorithm\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"sha256\",\n              \"sha512\",\n              \"TBD\"\n            ]\n          },\n          \"canonicalization\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"JCS\",\n              \"NONE\",\n              \"TBD\"\n            ]\n          },\n          \"payload_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"payload_scope\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"operation_record\",\n              \"model_state_record\",\n              \"diff_preview\",\n              \"external_reference\",\n              \"TBD\"\n            ]\n          },\n          \"value\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      },\n      \"Diagnostic\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"code\",\n          \"class\",\n          \"severity\",\n          \"source\",\n          \"affected_object\",\n          \"message\",\n          \"remediation\",\n          \"provenance\"\n        ],\n        \"properties\": {\n          \"code\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"class\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"OPERATION_SCHEMA_BLOCKING\",\n              \"OPERATION_PRECONDITION_BLOCKING\",\n              \"CONSTRAINT_VALIDATION_BLOCKING\",\n              \"DIFF_PREVIEW_REQUIRED\",\n              \"UNIT_WARNING\",\n              \"PROVENANCE_WARNING\",\n              \"IP_BOUNDARY_WARNING\",\n              \"HUMAN_REVIEW_REQUIRED\",\n              \"TBD\"\n            ]\n          },\n          \"severity\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"info\",\n              \"warning\",\n              \"blocking\"\n            ]\n          },\n          \"source\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"affected_object\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"message\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"remediation\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          }\n        }\n      },\n      \"DiffPreviewRef\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"preview_ref\",\n          \"preview_status\",\n          \"checksum\",\n          \"provenance\"\n        ],\n        \"properties\": {\n          \"preview_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"preview_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"not_generated\",\n              \"generated\",\n              \"blocked_by_validation\",\n              \"TBD\"\n            ]\n          },\n          \"checksum\": {\n            \"$ref\": \"#/$defs/Checksum\"\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          }\n        }\n      },\n      \"Id\": {\n        \"type\": \"string\",\n        \"minLength\": 1,\n        \"pattern\": \"^[A-Za-z][A-Za-z0-9_.:-]*$\"\n      },\n      \"ModelOperationRecord\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"operation_id\",\n          \"operation_kind\",\n          \"operation_status\",\n          \"author_type\",\n          \"target_refs\",\n          \"preconditions\",\n          \"changes\",\n          \"validation\",\n          \"diagnostics\",\n          \"diff_preview_refs\",\n          \"assumptions\",\n          \"provenance\",\n          \"professional_boundary\"\n        ],\n        \"properties\": {\n          \"operation_id\": {\n            \"$ref\": \"#/$defs/Id\"\n          },\n          \"operation_kind\": {\n            \"$ref\": \"#/$defs/OperationKind\"\n          },\n          \"operation_status\": {\n            \"$ref\": \"#/$defs/OperationStatus\"\n          },\n          \"author_type\": {\n            \"$ref\": \"#/$defs/OperationAuthorType\"\n          },\n          \"target_refs\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Reference\"\n            }\n          },\n          \"preconditions\": {\n            \"$ref\": \"#/$defs/OperationPrecondition\"\n          },\n          \"changes\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n              \"$ref\": \"#/$defs/OperationChange\"\n            }\n          },\n          \"validation\": {\n            \"$ref\": \"#/$defs/OperationValidation\"\n          },\n          \"diagnostics\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Diagnostic\"\n            }\n          },\n          \"diff_preview_refs\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/DiffPreviewRef\"\n            }\n          },\n          \"assumptions\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/AssumptionRecord\"\n            }\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          },\n          \"professional_boundary\": {\n            \"$ref\": \"#/$defs/ProfessionalBoundary\"\n          }\n        }\n      },\n      \"OperationAuthorType\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"user\",\n          \"agent\",\n          \"import_adapter\",\n          \"project_template\",\n          \"TBD\"\n        ]\n      },\n      \"OperationChange\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"change_id\",\n          \"change_kind\",\n          \"target_object_type\",\n          \"target_ref\",\n          \"value_payload\",\n          \"unit_requirements\",\n          \"provenance\"\n        ],\n        \"properties\": {\n          \"change_id\": {\n            \"$ref\": \"#/$defs/Id\"\n          },\n          \"change_kind\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"add_object\",\n              \"remove_object\",\n              \"split_pipe_run\",\n              \"transform_pipe_run\",\n              \"assign_section\",\n              \"detach_section\",\n              \"delete_material\",\n              \"delete_section\",\n              \"delete_component\",\n              \"set_field\",\n              \"move_geometry\",\n              \"reconnect\",\n              \"update_constraint\",\n              \"update_load\",\n              \"update_support\",\n              \"attach_design_knowledge\",\n              \"TBD\"\n            ]\n          },\n          \"target_object_type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Node\",\n              \"Element\",\n              \"Component\",\n              \"Support\",\n              \"Load\",\n              \"Constraint\",\n              \"DesignKnowledgeRecord\",\n              \"ModelMetadata\",\n              \"TBD\"\n            ]\n          },\n          \"target_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"value_payload\": {\n            \"$ref\": \"#/$defs/OperationValuePayload\"\n          },\n          \"unit_requirements\": {\n            \"$ref\": \"#/$defs/UnitRequirements\"\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          }\n        }\n      },\n      \"OperationContractStatus\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"record_contract\",\n          \"mutation_route\",\n          \"direct_model_mutation_allowed\",\n          \"user_acceptance_boundary\",\n          \"diff_preview_binding\",\n          \"audit_trail_binding\"\n        ],\n        \"properties\": {\n          \"record_contract\": {\n            \"const\": \"schema_first_model_operation_records\"\n          },\n          \"mutation_route\": {\n            \"const\": \"structured_operations_only\"\n          },\n          \"direct_model_mutation_allowed\": {\n            \"const\": false\n          },\n          \"user_acceptance_boundary\": {\n            \"const\": \"downstream_user_acceptance_required\"\n          },\n          \"diff_preview_binding\": {\n            \"const\": \"downstream_DEL-16-02\"\n          },\n          \"audit_trail_binding\": {\n            \"const\": \"downstream_DEL-16-03\"\n          }\n        }\n      },\n      \"OperationKind\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"add\",\n          \"move\",\n          \"modify\",\n          \"delete\",\n          \"reconnect\",\n          \"constraint\",\n          \"load\",\n          \"support\",\n          \"design_knowledge\",\n          \"TBD\"\n        ]\n      },\n      \"OperationModelBasis\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"model_ref\",\n          \"canonical_model_role\",\n          \"physical_source_of_truth_ref\",\n          \"accepted_model_state_ref\",\n          \"accepted_model_state_hash\"\n        ],\n        \"properties\": {\n          \"model_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"canonical_model_role\": {\n            \"const\": \"physical_source_of_truth\"\n          },\n          \"physical_source_of_truth_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"accepted_model_state_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"accepted_model_state_hash\": {\n            \"$ref\": \"#/$defs/Checksum\"\n          }\n        }\n      },\n      \"OperationPrecondition\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"base_model_state_ref\",\n          \"required_current_hashes\",\n          \"required_refs\",\n          \"assumptions\"\n        ],\n        \"properties\": {\n          \"base_model_state_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"required_current_hashes\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"contains\": {\n              \"type\": \"object\",\n              \"required\": [\n                \"payload_scope\"\n              ],\n              \"properties\": {\n                \"payload_scope\": {\n                  \"const\": \"model_state_record\"\n                }\n              }\n            },\n            \"items\": {\n              \"$ref\": \"#/$defs/Checksum\"\n            }\n          },\n          \"required_refs\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Reference\"\n            }\n          },\n          \"assumptions\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/AssumptionRecord\"\n            }\n          }\n        }\n      },\n      \"OperationSet\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"operation_set_id\",\n          \"project_ref\",\n          \"model_ref\",\n          \"model_basis\",\n          \"operations\",\n          \"diagnostics\",\n          \"provenance\",\n          \"professional_boundary\"\n        ],\n        \"properties\": {\n          \"operation_set_id\": {\n            \"$ref\": \"#/$defs/Id\"\n          },\n          \"project_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"model_ref\": {\n            \"$ref\": \"#/$defs/Reference\"\n          },\n          \"model_basis\": {\n            \"$ref\": \"#/$defs/OperationModelBasis\"\n          },\n          \"operations\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n              \"$ref\": \"#/$defs/ModelOperationRecord\"\n            }\n          },\n          \"diagnostics\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Diagnostic\"\n            }\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          },\n          \"professional_boundary\": {\n            \"$ref\": \"#/$defs/ProfessionalBoundary\"\n          }\n        }\n      },\n      \"OperationStatus\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"proposed\",\n          \"schema_validated\",\n          \"blocked_by_diagnostics\",\n          \"ready_for_user_review\",\n          \"rejected\",\n          \"TBD\"\n        ]\n      },\n      \"OperationValidation\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"schema_validation\",\n          \"constraint_validation\",\n          \"unit_validation\",\n          \"diff_preview_status\",\n          \"application_status\"\n        ],\n        \"properties\": {\n          \"schema_validation\": {\n            \"$ref\": \"#/$defs/ValidationState\"\n          },\n          \"constraint_validation\": {\n            \"$ref\": \"#/$defs/ValidationState\"\n          },\n          \"unit_validation\": {\n            \"$ref\": \"#/$defs/ValidationState\"\n          },\n          \"diff_preview_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"not_generated\",\n              \"generated\",\n              \"blocked_by_validation\",\n              \"TBD\"\n            ]\n          },\n          \"application_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"not_applied\",\n              \"held_for_user_review\",\n              \"downstream_application_required\",\n              \"TBD\"\n            ]\n          }\n        }\n      },\n      \"OperationValuePayload\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"value_kind\",\n          \"scalar_values\",\n          \"quantity_values\",\n          \"reference_values\",\n          \"notes\"\n        ],\n        \"properties\": {\n          \"value_kind\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"text\",\n              \"quantity\",\n              \"reference_list\",\n              \"structured_patch\",\n              \"TBD\"\n            ]\n          },\n          \"scalar_values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"quantity_values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Quantity\"\n            }\n          },\n          \"reference_values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/$defs/Reference\"\n            }\n          },\n          \"structured_values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\"\n            }\n          },\n          \"notes\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      },\n      \"PrivacyClassification\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"public_metadata\",\n          \"invented_public_example\",\n          \"private_project_data\",\n          \"owner_project_metadata_private\",\n          \"protected_suspected\",\n          \"redacted\",\n          \"TBD\"\n        ]\n      },\n      \"ProfessionalBoundary\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"human_review_required\",\n          \"software_makes_compliance_claim\",\n          \"software_makes_certification_claim\",\n          \"software_makes_sealing_claim\",\n          \"software_makes_approval_claim\",\n          \"software_makes_authentication_claim\"\n        ],\n        \"properties\": {\n          \"human_review_required\": {\n            \"const\": true\n          },\n          \"software_makes_compliance_claim\": {\n            \"const\": false\n          },\n          \"software_makes_certification_claim\": {\n            \"const\": false\n          },\n          \"software_makes_sealing_claim\": {\n            \"const\": false\n          },\n          \"software_makes_approval_claim\": {\n            \"const\": false\n          },\n          \"software_makes_authentication_claim\": {\n            \"const\": false\n          }\n        }\n      },\n      \"Provenance\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"source_name\",\n          \"source_location\",\n          \"source_license\",\n          \"contributor\",\n          \"contributor_certification\",\n          \"redistribution_status\",\n          \"review_status\",\n          \"privacy_classification\"\n        ],\n        \"properties\": {\n          \"source_name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"source_location\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"source_license\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"contributor\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"contributor_certification\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"redistribution_status\": {\n            \"$ref\": \"#/$defs/RedistributionStatus\"\n          },\n          \"review_status\": {\n            \"$ref\": \"#/$defs/ReviewStatus\"\n          },\n          \"privacy_classification\": {\n            \"$ref\": \"#/$defs/PrivacyClassification\"\n          }\n        }\n      },\n      \"Quantity\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"value\",\n          \"unit\",\n          \"dimension\",\n          \"provenance\"\n        ],\n        \"properties\": {\n          \"value\": {\n            \"type\": \"number\"\n          },\n          \"unit\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"dimension\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"dimensionless\",\n              \"length\",\n              \"mass\",\n              \"time\",\n              \"temperature\",\n              \"temperature_interval\",\n              \"angle\",\n              \"rotation\",\n              \"force\",\n              \"force_per_length\",\n              \"moment\",\n              \"pressure\",\n              \"stress\",\n              \"area\",\n              \"volume\",\n              \"density\",\n              \"linear_stiffness\",\n              \"rotational_stiffness\",\n              \"displacement\",\n              \"velocity\",\n              \"acceleration\",\n              \"thermal_conductivity\",\n              \"specific_heat\",\n              \"thermal_expansion_coefficient\",\n              \"second_moment_area\",\n              \"section_modulus\",\n              \"mass_per_length\",\n              \"volume_per_length\",\n              \"slope\",\n              \"TBD\"\n            ]\n          },\n          \"provenance\": {\n            \"$ref\": \"#/$defs/Provenance\"\n          }\n        }\n      },\n      \"RedistributionStatus\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"public_permissive\",\n          \"private_only\",\n          \"unknown\",\n          \"protected_suspected\",\n          \"invented_non_engineering_example\",\n          \"TBD\"\n        ]\n      },\n      \"Reference\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"object_type\",\n          \"ref\"\n        ],\n        \"properties\": {\n          \"object_type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Project\",\n              \"Model\",\n              \"ModelState\",\n              \"ModelOperation\",\n              \"Node\",\n              \"Element\",\n              \"Component\",\n              \"Support\",\n              \"Load\",\n              \"Constraint\",\n              \"DesignKnowledgeRecord\",\n              \"Diagnostic\",\n              \"DiffPreview\",\n              \"ExternalReference\",\n              \"TBD\"\n            ]\n          },\n          \"ref\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"label\": {\n            \"type\": \"