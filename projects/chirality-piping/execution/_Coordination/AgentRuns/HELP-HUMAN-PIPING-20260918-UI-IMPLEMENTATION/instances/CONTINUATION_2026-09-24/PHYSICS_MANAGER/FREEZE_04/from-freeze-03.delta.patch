+                        .unwrap()
+                        .position;
+                    let j = input
+                        .model
+                        .nodes
+                        .iter()
+                        .find(|n| n.id == pipe.to)
+                        .unwrap()
+                        .position;
+                    let length =
+                        ((j.x - i.x).powi(2) + (j.y - i.y).powi(2) + (j.z - i.z).powi(2)).sqrt();
+                    for (end, node) in [("i", &pipe.from), ("j", &pipe.to)] {
+                        let mut nodal = load.clone();
+                        nodal.id = format!("{}:historical-nodal-{end}", load.id);
