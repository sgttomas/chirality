+I4P_INVALID = ("G7", "SOURCE_PREVIEW_PHYSICS_EVIDENCE_INVALID")
+I4P_NEEDS = ("admitted", False, "needs_recompute")
+I4P_CARRIER = _set(["carrier_evidence"], {})
