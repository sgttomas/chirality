+pub(super) fn finite_norm(values: [f64; 3]) -> Result<f64, ReceiptError> {
+    let squared = values[0] * values[0] + values[1] * values[1] + values[2] * values[2];
+    let value = squared.sqrt();
+    if !squared.is_finite()
+        || !value.is_finite()
+        || values.iter().any(|x| *x != 0.0 && x * x == 0.0)
+    {
+        return Err(bad("derived norm range"));
+    }
+    Ok(value)
+}
