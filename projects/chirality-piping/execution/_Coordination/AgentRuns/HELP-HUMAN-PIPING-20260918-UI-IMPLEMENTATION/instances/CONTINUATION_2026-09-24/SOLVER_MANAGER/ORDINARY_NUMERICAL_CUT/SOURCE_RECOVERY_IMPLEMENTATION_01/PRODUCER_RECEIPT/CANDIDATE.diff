+        let receipt_sha256 = hash("source_blocks_receipt_v1", &body)?;
+        Ok(Self {
+            body,
+            receipt_sha256,
+        })
+    }
+    pub(super) fn into_wire(self) -> Value {
+        json!({"body":self.body,"receipt_sha256":self.receipt_sha256})
