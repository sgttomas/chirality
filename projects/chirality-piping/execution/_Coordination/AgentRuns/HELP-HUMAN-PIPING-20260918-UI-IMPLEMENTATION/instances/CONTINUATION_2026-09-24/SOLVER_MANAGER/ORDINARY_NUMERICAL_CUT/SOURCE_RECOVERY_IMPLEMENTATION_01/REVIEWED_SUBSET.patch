+fn unit(u: FunctionalUnit) -> Result<&'static str, ReceiptError> {
+    Ok(match u {
+        FunctionalUnit::Newton => "N",
+        FunctionalUnit::NewtonMetre => "N*m",
+        FunctionalUnit::Metre => "m",
+        FunctionalUnit::Millimetre => "mm",
