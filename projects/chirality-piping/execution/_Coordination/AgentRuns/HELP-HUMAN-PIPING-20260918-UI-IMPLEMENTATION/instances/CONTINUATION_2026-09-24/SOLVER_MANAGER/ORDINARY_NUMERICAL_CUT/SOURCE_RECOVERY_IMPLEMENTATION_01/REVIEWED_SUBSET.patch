+    for case in ("n05", "n06", "multicase"):
+        for mode in ("dense_scrutiny", "sparse_interactive"):
+            name = f"{case}-{mode}"
+            yield name, read_received(RECEIVED / f"{name}.raw.json"), {
+                "request": read_received(RECEIVED / f"{name}.request.json"), "solver_mode": mode,
+            }
