+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum MemberEnd {
+    I,
+    J,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum FunctionalUnit {
+    Newton,
+    NewtonMetre,
+    Metre,
+    Millimetre,
+    Radian,
+    Dimensionless,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum FunctionalConvention {
+    NodeOnElement,
+    SectionLocal,
+    SpringOnStructure,
+    SupportOnStructure,
+    SourceEquilibrium,
+    DeclaredAffine,
+}
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+pub enum FunctionalQuantity {
+    NodeDisplacement {
+        node: String,
+        dof: usize,
+    },
+    MemberEnd {
+        member: String,
+        end: MemberEnd,
+        row: u8,
+    },
+    MemberSection {
+        member: String,
+        station_bits: u64,
+        component: u8,
+    },
+    GroundSpring {
+        support: String,
+        dof: usize,
+    },
+    SupportAction {
+        support: String,
+        node: usize,
+        component: u8,
+    },
+    SourceReaction {
