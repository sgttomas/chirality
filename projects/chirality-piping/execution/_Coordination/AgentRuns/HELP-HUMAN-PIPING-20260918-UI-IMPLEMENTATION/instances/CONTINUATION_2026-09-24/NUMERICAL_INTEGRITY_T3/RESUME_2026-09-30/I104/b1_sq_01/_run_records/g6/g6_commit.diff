+macro_rules! entries {
+    ($($name:ident: $input:expr, $label:literal, [$($mode:ident => $value:expr),+];)+) => {
+        $(
+            mod $name {
+                use super::*;
+                $(
+                    mod $mode {
+                        use super::*;
+                        #[test]
+                        #[ignore]
+                        fn direct() {
+                            measure($label, $input, $value, Route::Direct);
+                        }
+                        #[test]
+                        #[ignore]
+                        fn ordinary() {
+                            measure($label, $input, $value, Route::Ordinary);
+                        }
+                    }
+                )+
+            }
+        )+
+    };
+}
