+// ---- RV123 (RV-P2 round 1), scratch only: exploratory exact-route variants ----
+/// The preview twin of an exact raw: 0.1.0, no contract, G authored as the exact route's Ĝ bits,
+/// no ν or basis, no pressure regions.
+fn rv123_preview_twin(exact: &Value) -> Value {
+    let mut raw = exact.clone();
+    let m = &mut raw["model"];
+    m["schema_version"] = json!("0.1.0");
+    m.as_object_mut().unwrap().remove("pressure_contract");
+    for material in m["materials"].as_array_mut().unwrap() {
+        let e = material["elastic_modulus"]["value"].as_f64().unwrap();
+        if let Some(nu) = material["poisson_ratio"]["value"].as_f64() {
+            material["shear_modulus"] = json!({"value": derived_g(e, nu), "unit": "Pa"});
+        }
+        let o = material.as_object_mut().unwrap();
+        o.remove("poisson_ratio");
+        o.remove("constitutive_basis");
+    }
+    for case in m["load_cases"].as_array_mut().unwrap() {
+        case.as_object_mut().unwrap().remove("pressure_regions");
+    }
+    raw
+}
+fn rv123_variants() -> Vec<(&'static str, Value)> {
+    let mut v = Vec::new();
+    // V1: ν = 0.3, so Ĝ = RN64(2e11/2.6) is inexact and the source lane's G differs from Ĝ.
+    let mut x = m3x();
+    x["model"]["materials"][0]["poisson_ratio"] = json!({"value": 0.3, "unit": "1"});
+    v.push(("nu_0.3", x));
+    // V2: a second, collinear member with another section (two members, two sections).
+    let mut x = m3x();
+    let p = "invented_t3_p1_detection_input_no_library_data";
+    x["model"]["nodes"].as_array_mut().unwrap().push(json!({"id": "N2", "position": {"x": 2.0, "y": 4.0, "z": 4.0}, "provenance": p}));
+    x["model"]["pipe_segments"].as_array_mut().unwrap().push(json!({"id": "M2", "from": "N1", "to": "N2", "material": "mat:N",
+        "y_reference": {"x": 1, "y": 0, "z": 0}, "section": {"outside_diameter": {"value": 0.15, "unit": "m"}, "wall_thickness": {"value": 0.008, "unit": "m"}}, "provenance": p}));
+    v.push(("two_members", x.clone()));
+    // V2b: the same with its members authored in the other order.
+    let mut y = x.clone();
+    y["model"]["pipe_segments"].as_array_mut().unwrap().reverse();
+    v.push(("two_members_reversed", y));
+    // V3: an authored (redundant, wrong) G that the exact route ignores.
+    let mut x = m3x();
+    x["model"]["materials"][0]["shear_modulus"] = json!({"value": 8.1e10, "unit": "Pa"});
+    v.push(("redundant_g", x));
+    // V4: an unused second material without ν or basis.
+    let mut x = m3x();
+    x["model"]["materials"].as_array_mut().unwrap().push(json!({"id": "mat:unused", "elastic_modulus": {"value": 1.0e11, "unit": "Pa"}, "provenance": p}));
+    v.push(("unused_material", x));
+    // V5: ν = 0.3 with E in another unit (GPa).
+    let mut x = m3x();
+    x["model"]["materials"][0]["poisson_ratio"] = json!({"value": 0.3, "unit": "1"});
+    x["model"]["materials"][0]["elastic_modulus"] = json!({"value": 200.0, "unit": "GPa"});
+    v.push(("nu_0.3_gpa", x));
+    v
+}
+#[test]
+fn rv123_exact_variants_explore() {
+    for (name, raw) in rv123_variants() {
+        for mode in MODES {
+            let label = format!("{name} {}", mode.as_str());
+            let plain_bytes = plain(mode, &raw);
+            let plain_value: Value = serde_json::from_slice(&plain_bytes).unwrap();
+            let quality: Vec<String> = plain_value["numerical_quality"]["cases"].as_array().map(|c| c.iter().map(|c| c["solve_quality"].as_str().unwrap_or("?").to_owned()).collect()).unwrap_or_default();
+            let (_, retained, captured) = exact_w1(&raw, mode);
+            let fallback = retained.as_ref().err().map(|e| format!("{e:?}"));
+            let Some(successor) = captured else {
+                println!("RV123_VARIANT {label} contract={} mechanics={} quality={quality:?} successor=none w1={fallback:?}",
+                    plain_value["producer"]["semantic_contract_id"], plain_value["status"]["mechanics"]);
+                continue;
+            };
+            let statuses: Vec<String> = successor["retained_precision"]["body"]["cases"].as_array().unwrap().iter().map(|c| c["status"].as_str().unwrap().to_owned()).collect();
+            let st: Vec<&str> = statuses.iter().map(String::as_str).collect();
+            let checks = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| assert_exact_successor(&label, &successor, &plain_value, &st))).is_ok();
+            // The preview twin (G authored as Ĝ): the shared rows, and their spread against the exact route.
+            let twin = rv123_preview_twin(&raw);
+            let (_, twin_retained, twin_captured) = exact_w1(&twin, mode);
+            let mut summary = String::from("twin=none");
+            if let Some(t) = twin_captured {
+                let tr: std::collections::HashMap<String, f64> = t["results"].as_array().unwrap().iter().map(|r| (r["id"].as_str().unwrap().to_owned(), r["value"].as_f64().unwrap_or(f64::NAN))).collect();
+                let (mut shared, mut equal, mut worst) = (0, 0, (0.0f64, String::new()));
+                for r in successor["results"].as_array().unwrap() {
+                    let id = r["id"].as_str().unwrap();
+                    if let (Some(a), Some(b)) = (r["value"].as_f64(), tr.get(id)) {
+                        shared += 1;
+                        if a.to_bits() == b.to_bits() { equal += 1; continue; }
+                        let rel = (a - b).abs() / a.abs().max(b.abs()).max(f64::MIN_POSITIVE);
+                        if rel > worst.0 { worst = (rel, id.to_owned()); }
+                    }
+                }
+                let tstat: Vec<String> = t["retained_precision"]["body"]["cases"].as_array().unwrap().iter().map(|c| c["status"].as_str().unwrap().to_owned()).collect();
+                summary = format!("twin={tstat:?} twin_w1={:?} shared={shared} bit_equal={equal} worst_rel={:e} at {}", twin_retained.as_ref().err(), worst.0, worst.1);
+            }
+            let sections: Vec<String> = successor["contract_evidence"]["exact_cases"][0]["pipe_sections"].as_array().unwrap().iter()
+                .map(|s| format!("{}:[{:016x},{:016x},{:016x},{:016x}]", s["pipe_id"].as_str().unwrap(), num_bits(&s["As_m2"]), num_bits(&s["I_m4"]), num_bits(&s["J_m4"]), num_bits(&s["Z_m3"]))).collect();
+            let mats = successor["retained_precision"]["body"]["material_bases"][0]["materials"].clone();
+            let patched = open_pipe_stress_result_export::rv123_exact_reader::validate(&successor, None).map(|v| v.numerical_eligible).map_err(|e| (e.gate, e.code, e.detail));
+            println!("RV123_VARIANT {label} quality={quality:?} statuses={statuses:?} w1={fallback:?} b3d_checks={checks} patched_rs_g0_g7={patched:?} sections={sections:?} materials={mats} {summary}");
+        }
+    }
+}
