+fn pressure_kind(kind: &str) -> bool {
+    matches!(
+        kind,
+        "pipe_wall_endpoint_action_v2"
+            | "pipe_wall_axial_force_v2"
+            | "pipe_effective_axial_force_v2"
+            | "pipe_axial_membrane_stress_v2"
+            | "pipe_lame_radial_stress_v2"
+            | "pipe_lame_hoop_stress_v2"
+    )
+}
