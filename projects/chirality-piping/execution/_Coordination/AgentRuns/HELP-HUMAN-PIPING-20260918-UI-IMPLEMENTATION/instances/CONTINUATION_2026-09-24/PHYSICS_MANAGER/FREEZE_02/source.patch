+            result
+                .diagnostics
+                .iter()
+                .any(|d| d.code == code && (d.severity == "blocking" || d.severity == "failure")),
+            "expected targeted {code}; actual={:?}",
+            result.diagnostics
+        );
+        assert!(
+            !result
+                .results
+                .iter()
+                .any(|r| r.kind.starts_with("pipe_") && r.kind.ends_with("_v2")),
+            "invalid exact request published exact pressure rows"
+        );
+    }
