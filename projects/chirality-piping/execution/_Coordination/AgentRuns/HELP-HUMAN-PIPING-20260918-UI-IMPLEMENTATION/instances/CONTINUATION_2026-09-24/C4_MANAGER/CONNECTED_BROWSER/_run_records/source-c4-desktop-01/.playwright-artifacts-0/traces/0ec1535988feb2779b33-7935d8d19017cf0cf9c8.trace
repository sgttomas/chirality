orkspace-pane, the\n * .workspace-dock-body, or an explicitly bounded panel region (e.g. the\n * operation apply queue); panels grow with content instead of clipping it,\n * and form rows wrap (flex-wrap / auto-fit grids) rather than overflow.\n */\n\n/*\n * The design tokens (generated; see design/TOKENS_SOURCE.md). The workspace variables near the end\n * of this file are defined from them, so the dependency is declared here and every page that loads\n * this stylesheet receives the tokens with it. An @import has to precede every rule.\n */\n\n/* Generated from tokens.json (99 colour tokens, version 1.2). Do not edit by hand. */\n\n:root {\n  --font-ui: -apple-system, BlinkMacSystemFont, system-ui, \"SF Pro Text\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  --font-numeric: -apple-system, BlinkMacSystemFont, system-ui, \"SF Pro Text\", \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  --font-mono: ui-monospace, \"SF Mono\", Menlo, Monaco, Consolas, monospace;\n  --type-size-caption: 11px;\n  --type-size-chip: 12px;\n  --type-size-body: 13px;\n  --type-size-title: 15px;\n  --type-size-heading: 18px;\n  --type-size-figure: 22px;\n  --type-lineHeight-caption: 14px;\n  --type-lineHeight-chip: 16px;\n  --type-lineHeight-body: 18px;\n  --type-lineHeight-title: 20px;\n  --type-lineHeight-heading: 24px;\n  --type-lineHeight-figure: 28px;\n  --type-weight-regular: 400;\n  --type-weight-medium: 500;\n  --type-weight-semibold: 600;\n  --type-minimumRepeatedlyRead: 13px;\n  --type-letterSpacing-figure: -0.2px;\n  --space-0: 0px;\n  --space-1: 2px;\n  --space-2: 4px;\n  --space-3: 6px;\n  --space-4: 8px;\n  --space-5: 12px;\n  --space-6: 16px;\n  --space-7: 20px;\n  --space-8: 24px;\n  --space-9: 32px;\n  --space-10: 40px;\n  --radius-none: 0px;\n  --radius-control: 3px;\n  --radius-card: 6px;\n  --radius-sheet: 10px;\n  --radius-pill: 999px;\n  --border-width-hairline: 1px;\n  --border-width-strong: 1px;\n  --border-width-focusRing: 2px;\n  --border-width-selectio