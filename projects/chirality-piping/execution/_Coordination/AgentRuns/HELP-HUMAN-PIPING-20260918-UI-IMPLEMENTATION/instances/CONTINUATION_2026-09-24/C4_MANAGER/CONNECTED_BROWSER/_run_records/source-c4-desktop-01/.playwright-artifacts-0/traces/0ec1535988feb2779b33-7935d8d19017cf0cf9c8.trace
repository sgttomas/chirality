53e;\n    --mark-required: #fb817a;\n    --status-incompleteFill: #433215;\n    --status-incompleteInk: #efc876;\n    --status-solvedFill: #32363a;\n    --status-solvedInk: #d4d8dd;\n    --status-failedFill: #4b2724;\n    --status-failedInk: #ffaba3;\n    --status-reviewFill: #27353e;\n    --status-reviewInk: #a8d1ee;\n    --historical-tint: #322d25;\n    --historical-ink: #cec2af;\n    --displayOnly-border: #53595f;\n    --stale-stripe: #44484d;\n    --stale-band: #362c1c;\n    --stale-ink: #e9ca89;\n    --rail-captionFailed: #ffaba3;\n    --rail-captionStale: #e9ca89;\n    --rail-captionHistorical: #cec2af;\n    --canvas-bg: #191c1f;\n    --canvas-gridMajor: #2d3135;\n    --canvas-gridMinor: #222629;\n    --canvas-pipe: #757b81;\n    --canvas-pipeShade: #53595f;\n    --canvas-edge: #c7cbd0;\n    --canvas-edgeAlt: #2a2e33;\n    --canvas-glyph: #dbdee2;\n    --canvas-glyphFill: #34383d;\n    --canvas-label: #e5e8ec;\n    --canvas-labelBg: rgba(28,31,37,0.82);\n    --canvas-hint: rgba(46,50,54,0.92);\n    --canvas-vector: #c7cbd0;\n    --canvas-selection: #6dadff;\n    --canvas-hover: #5788c7;\n    --canvas-draft: #6dadff;\n    --canvas-proposalGhost: #ba93fb;\n    --canvas-deformGhost: #53595f;\n    --canvas-unsolved: #757b81;\n    --canvas-axisX: #f07f77;\n    --canvas-axisY: #73c076;\n    --canvas-axisZ: #70adfb;\n    --draft-bar: #6dadff;\n    --result-scale-1: #045c59;\n    --result-scale-2: #04706b;\n    --result-scale-3: #09847f;\n    --result-scale-4: #099993;\n    --result-scale-5: #24ada7;\n    --result-scale-6: #52bfb9;\n    --result-scale-7: #74d1cb;\n    --bar-track: #3c4045;\n    --cat-1: #d97230;\n    --cat-2: #c960aa;\n    --cat-3: #429c5a;\n    --cat-4: #6280da;\n    --cat-5: #db6686;\n    --cat-6: #089ac3;\n    --cat-7: #97902a;\n    --cat-8: #009298;\n    --elevation-1: 0 1px 2px rgba(0,0,0,0.40);\n    --elevation-2: 0 4px 12px rgba(0,0,0,0.50), 0 0 0 1px rgba(255,255,255,0.06);\n    --elevation-3: 0 12px 32px rgba(0,0,0,0.60), 0 0 0 1px rgba(255,255,255,0.08);\n  }\n}\n\n:root[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --surface-base: #1b1e22;\n  --surface-panel: #25282c;\n  --surface-raised: #2e3236;\n  --surface-sunken: #202327;\n  --surface-header: #292d31;\n  --surface-rowAlt: #272a2e;\n  --surface-canvas: #191c1f;\n  --text-primary: #e5e8ec;\n  --text-secondary: #acb2b7;\n  --text-muted: #878d93;\n  --text-disabled: #5f6469;\n  --text-inverse: #13161a;\n  --text-link: #87bafd;\n  --border-hairline: #393e42;\n  --border-strong: #53595f;\n  --border-focus: #70adfb;\n  --accent-fill: #4c94ec;\n  --accent-fillHover: #59a0f9;\n  --accent-text: #91c1ff;\n  --selection-band: #223e61;\n  --selection-bar: #65a7fa;\n  --hover-wash: rgba(255,255,255,0.06);\n  --pressed-wash: rgba(255,255,255,0.10);\n  --pressed-fill: #254974;\n  --pressed-ink: #a8ceff;\n  --disabled-fill: #2b2e32;\n  --focus-ring: #70adfb;\n  --scrim: rgba(0,0,0,0.55);\n  --proposal-new: #c4a4fe;\n  --proposal-band: #3b2f51;\n  --proposal-bar: #ba93fb;\n  --proposal-old: #878d93;\n  --mark-checked: #acb2b7;\n  --mark-checkedStale: #e9b452;\n  --mark-origin: #878d93;\n  --mark-attachment: #acb2b7;\n  --issue-blocking: #fb817a;\n  --issue-blockingTint: #4b2724;\n  --issue-warning: #e9b452;\n  --issue-warningTint: #433215;\n  --issue-info: #8fb7d4;\n  --issue-infoTint: #27353e;\n  --mark-required: #fb817a;\n  --status-incompleteFill: #433215;\n  --status-incompleteInk: #efc876;\n  --status-solvedFill: #32363a;\n  --status-solvedInk: #d4d8dd;\n  --status-failedFill: #4b2724;\n  --status-failedInk: #ffaba3;\n  --status-reviewFill: #27353e;\n  --status-reviewInk: #a8d1ee;\n  --historical-tint: #322d25;\n  --historical-ink: #cec2af;\n  --displayOnly-border: #53595f;\n  --stale-stripe: #44484d;\n  --stale-band: #362c1c;\n  --stale-ink: #e9ca89;\n  --rail-captionFailed: #ffaba3;\n  --rail-captionStale: #e9ca89;\n  --rail-captionHistorical: #cec2af;\n  --canvas-bg: #191c1f;\n  --canvas-gridMajor: #2d3135;\n  --canvas-gridMinor: #222629;\n  --canvas-pipe: #757b81;\n  --canvas-pipeShade: #53595f;\n  --canvas-edge: #c7cbd0;\n  --canvas-edgeAlt: #2a2e33;\n  --canvas-glyph: #dbdee2;\n  --canvas-glyphFill: #34383d;\n  --canvas-label: #e5e8ec;\n  --canvas-labelBg: rgba(28,31,37,0.82);\n  --canvas-hint: rgba(46,50,54,0.92);\n  --canvas-vector: #c7cbd0;\n  --canvas-selection: #6dadff;\n  --canvas-hover: #5788c7;\n  --canvas-draft: #6dadff;\n  --canvas-proposalGhost: #ba93fb;\n  --canvas-deformGhost: #53595f;\n  --canvas-unsolved: #757b81;\n  --canvas-axisX: #f07f77;\n  --canvas-axisY: #73c076;\n  --canvas-axisZ: #70adfb;\n  --draft-bar: #6dadff;\n  --result-scale-1: #045c59;\n  --result-scale-2: #04706b;\n  --result-scale-3: #09847f;\n  --result-scale-4: #099993;\n  --result-scale-5: #24ada7;\n  --result-scale-6: #52bfb9;\n  --result-scale-7: #74d1cb;\n  --bar-track: #3c4045;\n  --cat-1: #d97230;\n  --cat-2: #c960aa;\n  --cat-3: #429c5a;\n  --cat-4: #6280da;\n  --cat-5: #db6686;\n  --cat-6: #089ac3;\n  --cat-7: #97902a;\n  --cat-8: #009298;\n  --elevation-1: 0 1px 2px rgba(0,0,0,0.40);\n  --elevation-2: 0 4px 12px rgba(0,0,0,0.50), 0 0 0 1px rgba(255,255,255,0.06);\n  --elevation-3: 0 12px 32px rgba(0,0,0,0.60), 0 0 0 1px rgba(255,255,255,0.08);\n}\n\n:root {\n  color: #1d2424;\n  background: #ecefeb;\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-width: 1120px;\n  min-height: 760px;\n}\n\nbutton,\ninput,\ntextarea {\n  font: inherit;\n}\n\nbutton:focus-visible {\n  outline: 3px solid #f08c22;\n  outline-offset: 2px;\n}\n\n.loading-screen {\n  display: grid;\n  min-height: 100vh;\n  place-items: center;\n  color: #2d3837;\n}\n\n.app-shell {\n  display: grid;\n  grid-template-rows: auto auto auto 1fr auto;\n  height: 100vh;\n  min-height: 760px;\n}\n\n/* Tauri shell: the native OS menu bar replaces the in-DOM menu row, so one\n   fewer grid track keeps the workspace on the 1fr row. */\n\n.app-shell.native-menu {\n  grid-template-rows: auto auto 1fr auto;\n}\n\n.titlebar-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.titlebar-actions button,\n.project-index-picker button,\n.status-drawer-button,\n.drawer-header button,\n.ribbon-stop,\n.command-buttons button,\n.viewport-view-cube button {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.project-strip {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 34px;\n  padding: 6px 18px;\n  border-bottom: 1px solid #c8d0cb;\n  background: #f7f9f6;\n  color: #2d3837;\n  font-size: 12px;\n}\n\n.project-index-picker {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.workflow-ribbon {\n  display: grid;\n  grid-template-columns: minmax(520px, 1fr) minmax(300px, 0.7fr);\n  gap: 10px;\n  padding: 8px 18px;\n  border-bottom: 1px solid #c8d0cb;\n  background: #edf2ef;\n}\n\n.ribbon-stop-list {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  gap: 6px;\n}\n\n.ribbon-stop {\n  display: grid;\n  justify-items: start;\n  min-width: 0;\n  min-height: 42px;\n  border-color: #aeb9b3;\n}\n\n.ribbon-stop.active {\n  color: #ffffff;\n  background: #31403d;\n  border-color: #31403d;\n}\n\n.ribbon-stop span,\n.ribbon-stop small {\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.ribbon-stop small {\n  color: inherit;\n  opacity: 0.82;\n  font-size: 11px;\n}\n\n.ribbon-current-step {\n  min-width: 0;\n  padding: 7px 10px;\n  border: 1px solid #c8d0cb;\n  border-radius: 5px;\n  background: #fbfcfa;\n}\n\n.ribbon-current-step span {\n  display: block;\n  color: #63706c;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.ribbon-current-step strong,\n.ribbon-current-step p {\n  display: block;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.ribbon-current-step p {\n  margin: 2px 0 0;\n  color: #44504c;\n  font-size: 12px;\n}\n\n.ribbon-section-switcher {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin-top: 6px;\n}\n\n.ribbon-section-switcher button {\n  min-height: 24px;\n  padding: 3px 7px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #31403d;\n  background: #ffffff;\n  cursor: pointer;\n  font-size: 11px;\n}\n\n.ribbon-section-switcher button[aria-pressed=\"true\"] {\n  color: #ffffff;\n  background: #31403d;\n  border-color: #31403d;\n}\n\n/* CAD-shell menu bar (TP-R3UX-CADSHELL): a thin application menu bar that\n   replaces the workflow ribbon. The in-DOM menu is the tested navigation; the\n   native macOS menu mirrors these commands in the Tauri shell. */\n\n.app-menu-bar {\n  display: flex;\n  align-items: stretch;\n  gap: 2px;\n  padding: 3px 10px;\n  border-bottom: 1px solid var(--ui-divider);\n  background: var(--ui-surface);\n  /* Keep a closed menu below drawers; raise an open menu above the\n     click-catcher backdrop so its dropdowns continue to receive clicks. */\n  position: relative;\n  z-index: 20;\n}\n\n.app-menu-bar.menu-open {\n  z-index: 50;\n}\n\n.app-menu {\n  position: relative;\n}\n\n.app-menu-trigger {\n  min-height: 30px;\n  padding: 4px 12px;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: #263331;\n  background: transparent;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.app-menu-trigger:hover {\n  background: #dde6e1;\n}\n\n.app-menu-trigger.open {\n  color: #ffffff;\n  background: #31403d;\n  border-color: #31403d;\n}\n\n.app-menu-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 40;\n}\n\n.app-menu-dropdown {\n  position: absolute;\n  top: calc(100% + 3px);\n  left: 0;\n  z-index: 41;\n  display: flex;\n  flex-direction: column;\n  min-width: 232px;\n  padding: 5px;\n  border: 1px solid #b8c3bd;\n  border-radius: 6px;\n  background: #ffffff;\n  box-shadow: 0 10px 26px rgba(24, 35, 33, 0.22);\n}\n\n.app-menu-item {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 12px;\n  min-height: 30px;\n  padding: 5px 10px;\n  border: 0;\n  border-radius: 4px;\n  color: #263331;\n  background: transparent;\n  cursor: pointer;\n  font-size: 13px;\n  text-align: left;\n}\n\n.app-menu-item:hover:not(:disabled) {\n  background: #eef3f0;\n}\n\n.app-menu-item.active {\n  color: #ffffff;\n  background: #31403d;\n}\n\n.app-menu-item:disabled {\n  color: #9aa4a0;\n  cursor: not-allowed;\n}\n\n.app-menu-separator {\n  height: 1px;\n  margin: 4px 6px;\n  background: #dde3df;\n}\n\n/* Workspace dock: summoned from the View menu and collapsed by default so the\n   spatial core (tree | viewport | inspector) owns the full surface. */\n\n.workspace-dock-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 2px 4px 8px;\n  border-bottom: 1px solid #d6ded9;\n}\n\n.workspace-dock-header h2 {\n  margin: 0;\n  font-size: 14px;\n  font-weight: 700;\n  color: #263331;\n}\n\n.workspace-dock-header button {\n  min-height: 28px;\n  padding: 4px 10px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #31403d;\n  background: #ffffff;\n  cursor: pointer;\n  font-size: 12px;\n}\n\n.workspace-dock.collapsed {\n  display: none;\n}\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 9px;\n  min-height: 30px;\n  border: 1px solid #53635f;\n  border-radius: 4px;\n  color: #f8faf7;\n  background: #33423f;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n.project-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 42px;\n  padding: 8px 18px;\n  border-bottom: 1px solid #c8d0cb;\n  background: #f7f9f6;\n  color: #2d3837;\n  font-size: 12px;\n}\n\n.project-toolbar strong,\n.project-toolbar span {\n  overflow-wrap: anywhere;\n}\n\n.project-toolbar-actions {\n  display: flex;\n  flex-wrap: wrap;\n  flex: 0 0 auto;\n  gap: 8px;\n}\n\n.project-toolbar button {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.project-toolbar button:disabled {\n  color: #7b8580;\n  cursor: not-allowed;\n}\n\n.boundary-strip {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 8px;\n  min-height: 38px;\n  padding: 7px 18px;\n  border-bottom: 1px solid #c8d0cb;\n  background: #edf2ef;\n}\n\n.boundary-item {\n  display: grid;\n  grid-template-columns: 18px auto minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n  color: #2d3837;\n  font-size: 11px;\n}\n\n.boundary-item strong {\n  white-space: nowrap;\n}\n\n.boundary-item code {\n  min-width: 0;\n  overflow: hidden;\n  color: #4d5a56;\n  font-family: inherit;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* === 2. Workspace layout (TP-APP-R2-UXSHELL-001) === */\n\n.workspace {\n  /* Keep viewport, rail and dock layers below outer menus and drawers. */\n  isolation: isolate;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-height: 0;\n  padding: 8px;\n}\n\n/* Each core column scrolls independently; panels inside grow with content. */\n\n.workspace-pane {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  min-height: 0;\n  min-width: 0;\n  overflow-y: auto;\n  overflow-x: hidden;\n}\n\n.workspace-pane > .panel,\n.workspace-pane > .viewport-shell {\n  flex: 0 0 auto;\n}\n\n.workspace-pane-viewport > .viewport-shell {\n  flex: 1 1 auto;\n}\n\n.layout-mode-toggle,\n.entity-grid-tabs,\n.entity-grid-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.layout-mode-toggle {\n  margin-bottom: 8px;\n}\n\n.layout-mode-toggle button,\n.entity-grid-tabs button,\n.entity-grid-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  min-height: 30px;\n}\n\n.layout-mode-toggle button[aria-pressed=\"true\"],\n.entity-grid-tabs button[aria-pressed=\"true\"] {\n  border-color: #2d5b50;\n  color: #102b25;\n  background: #dcebe5;\n  box-shadow: inset 0 -2px 0 #2d5b50;\n}\n\n.entity-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 8px;\n  min-width: 0;\n}\n\n.entity-grid-tabs {\n  padding-bottom: 2px;\n}\n\n.entity-grid-tabs button {\n  padding: 5px 8px;\n  font-size: 12px;\n}\n\n.entity-grid-summary {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 8px;\n  align-items: center;\n  color: #4f5c58;\n  font-size: 12px;\n}\n\n.entity-grid-scroll {\n  min-width: 0;\n  max-height: 480px;\n  overflow: auto;\n  border: 1px solid #c8d0cb;\n  border-radius: 6px;\n  background: #ffffff;\n}\n\n.entity-grid table {\n  width: max-content;\n  min-width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\n\n.entity-grid th,\n.entity-grid td {\n  padding: 6px;\n  border-bottom: 1px solid #e1e7e3;\n  vertical-align: top;\n}\n\n.entity-grid thead th {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  color: #2d3835;\n  background: #eef3ef;\n  text-align: left;\n}\n\n.entity-grid tbody tr.active {\n  background: #e9f3ee;\n}\n\n.entity-grid th button {\n  max-width: 130px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.entity-grid input {\n  width: 120px;\n  min-width: 0;\n  padding: 5px 6px;\n  border: 1px solid #b9c5bf;\n  border-radius: 4px;\n  font: inherit;\n}\n\n.entity-grid input:focus {\n  border-color: #2d5b50;\n  outline: 2px solid rgba(45, 91, 80, 0.16);\n}\n\n.entity-grid-boundary,\n.entity-grid-queued {\n  margin: 0;\n}\n\n.entity-grid-queued {\n  color: #235344;\n  font-weight: 700;\n}\n\n/* Section dock: always-visible navigation + one scrolling section at a time. */\n\n.workspace-dock {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  flex: 0.85 1 0;\n  min-height: 210px;\n}\n\n.workspace-dock-body {\n  flex: 1 1 0;\n  min-height: 0;\n  overflow-y: auto;\n}\n\n.workspace-dock-section {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));\n  gap: 10px;\n  align-items: start;\n}\n\n.workspace-dock-section > .panel {\n  min-width: 0;\n}\n\n.workspace-dock-section > .review-apply-drawer {\n  min-width: 0;\n}\n\n/* Inactive sections stay mounted (state survives navigation) but are fully\n   hidden, including from the accessibility tree. */\n\n.workspace-dock-section.inactive {\n  display: none;\n}\n\n.status-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  min-height: 42px;\n  padding: 6px 18px;\n  border-top: 1px solid #c8d0cb;\n  background: #f7f9f6;\n}\n\n.status-pill-group,\n.status-bar-actions,\n.operation-status-chips {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 7px;\n}\n\n.status-pill,\n.operation-status-chips span,\n.operation-history-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 28px;\n  padding: 4px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  background: #ffffff;\n  color: #31403d;\n  font-size: 12px;\n}\n\n.status-pill code {\n  font-family: inherit;\n  font-size: 11px;\n  color: #53605c;\n}\n\n.status-drawer-button {\n  display: grid;\n  justify-items: start;\n}\n\n.status-drawer-button small {\n  color: #64716c;\n  font-size: 11px;\n}\n\n.issue-button {\n  min-width: 96px;\n  justify-items: center;\n  font-weight: 700;\n}\n\n.workspace-drawer {\n  position: fixed;\n  right: 18px;\n  bottom: 58px;\n  z-index: 30;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: min(760px, calc(100vw - 36px));\n  max-height: min(720px, calc(100vh - 120px));\n  overflow: auto;\n  padding: 12px;\n  border: 1px solid #aeb9b3;\n  border-radius: 6px;\n  background: #fbfcfa;\n  box-shadow: 0 18px 50px rgb(27 39 37 / 24%);\n}\n\n/* Keep diagnostic controls at content height; the bounded drawer owns scrolling. */\n\n.issues-drawer > .panel {\n  flex-shrink: 0;\n}\n\n.drawer-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.drawer-header span {\n  color: #63706c;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.drawer-header h2 {\n  margin: 2px 0 0;\n  font-size: 18px;\n}\n\n.boundary-grid,\n.drawer-panel-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 8px;\n}\n\n.storage-capability {\n  display: grid;\n  gap: 4px;\n  padding: 9px;\n  border: 1px solid #d9dfdb;\n  border-radius: 5px;\n  background: #f4f7f4;\n  font-size: 12px;\n}\n\n.issue-row {\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 5px;\n  background: #ffffff;\n}\n\n.issue-row p {\n  margin: 4px 0 0;\n  color: #44504c;\n}\n\n/* === 3. Panel primitives === */\n\n.panel,\n.viewport-shell {\n  min-height: 0;\n  overflow: hidden;\n  border: 1px solid #c8d0cb;\n  border-radius: 6px;\n  background: #fbfcfa;\n  box-shadow: 0 1px 2px rgb(27 39 37 / 8%);\n}\n\n.panel {\n  display: flex;\n  flex-direction: column;\n  padding: 12px;\n}\n\n.panel-title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  margin-bottom: 10px;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.model-tree {\n  overflow: auto;\n}\n\n/* Two-row layout: filter input + clear button on top, match summary below.\n   The single-row layout overlapped at the narrow tree-column width. */\n\n.model-tree-controls {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 32px;\n  align-items: center;\n  gap: 6px 8px;\n  margin-bottom: 10px;\n}\n\n.model-tree-controls > span {\n  grid-column: 1 / -1;\n}\n\n.model-tree-controls label {\n  display: grid;\n  grid-template-columns: 16px auto minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.model-tree-controls label span,\n.model-tree-controls > span {\n  color: #65716c;\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.model-tree-controls input {\n  min-width: 0;\n  min-height: 30px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  font-size: 12px;\n}\n\n.model-tree-controls button {\n  grid-row: 1;\n  grid-column: 2;\n  display: inline-grid;\n  width: 32px;\n  height: 30px;\n  place-items: center;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.model-tree-controls button:disabled {\n  color: #9aa39f;\n  cursor: not-allowed;\n}\n\n.tree-group h3 {\n  margin: 14px 0 6px;\n  color: #6b736f;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.tree-row {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  align-items: start;\n  gap: 7px;\n  width: 100%;\n  min-height: 42px;\n  padding: 7px;\n  border: 0;\n  border-radius: 4px;\n  color: #263331;\n  background: transparent;\n  text-align: left;\n  cursor: pointer;\n}\n\n.tree-row.active {\n  background: #dce8e2;\n}\n\n.tree-row strong,\n.tree-row small {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.tree-row strong {\n  font-size: 13px;\n}\n\n.tree-row small {\n  margin-top: 2px;\n  color: #68746f;\n  font-size: 11px;\n}\n\n.inspector h2,\n.agent-panel h2 {\n  margin: 0 0 10px;\n  font-size: 15px;\n  overflow-wrap: anywhere;\n}\n\n.inspector dl {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  overflow: auto;\n}\n\n.inspector dl div {\n  display: grid;\n  grid-template-columns: 100px minmax(0, 1fr);\n  gap: 8px;\n}\n\n.inspector dt {\n  color: #69736f;\n  font-size: 12px;\n}\n\n.inspector dd {\n  margin: 0;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.inspector {\n  overflow: auto;\n}\n\n.editor-intent {\n  display: grid;\n  gap: 9px;\n  margin-top: 14px;\n  padding-top: 12px;\n  border-top: 1px solid #d8dfdb;\n}\n\n.editor-intent[hidden], [role=\"tabpanel\"][hidden] { display: none !important; }\n\n.editor-intent h3 {\n  margin: 0;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.editor-intent-controls {\n  display: grid;\n  gap: 8px;\n}\n\n.editor-intent-controls label {\n  display: grid;\n  gap: 4px;\n}\n\n.editor-intent-controls label span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.editor-intent-controls input,\n.editor-intent-controls select {\n  min-width: 0;\n  min-height: 30px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  font-size: 12px;\n}\n\n.editor-intent-checkbox-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 6px;\n}\n\n.editor-intent-checkbox-grid label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 28px;\n  padding: 4px 6px;\n  border: 1px solid #d3d9d5;\n  border-radius: 4px;\n  background: #ffffff;\n  color: #34413e;\n  font-size: 12px;\n}\n\n.editor-intent-checkbox-grid input {\n  min-width: auto;\n  min-height: auto;\n  padding: 0;\n}\n\n.editor-intent-controls button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.editor-intent-controls button:disabled {\n  color: #9aa39f;\n  cursor: not-allowed;\n}\n\n.editor-intent-preview,\n.editor-intent-queue article {\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n}\n\n.editor-intent-meta,\n.editor-intent-queue {\n  display: grid;\n  gap: 7px;\n}\n\n.editor-intent-fact {\n  display: grid;\n  grid-template-columns: 92px minmax(0, 1fr);\n  gap: 8px;\n  padding: 5px 6px;\n  border: 1px solid #e1e6e3;\n  border-radius: 4px;\n  background: #f8faf8;\n}\n\n.editor-intent-fact span,\n.editor-intent-queue small,\n.editor-intent-queue span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.editor-intent-fact strong,\n.editor-intent-queue strong {\n  color: #25312f;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.editor-intent-queue article {\n  display: grid;\n  gap: 3px;\n}\n\n.editor-inline-validation {\n  display: grid;\n  gap: 4px;\n  min-height: 28px;\n  padding: 7px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n  color: #2d3837;\n  font-size: 12px;\n}\n\n.editor-inline-validation strong,\n.editor-inline-validation small {\n  overflow-wrap: anywhere;\n}\n\n.editor-inline-validation small {\n  color: #5f6c68;\n  font-size: 11px;\n}\n\n.inspector-context-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 8px;\n  margin: 8px 0 10px;\n}\n\n.inspector-context-card {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 5px;\n  background: #f7f9f6;\n  font-size: 12px;\n}\n\n.inspector-context-card > span {\n  color: #5f6c68;\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.inspector-context-card dl {\n  margin: 0;\n}\n\n.inspector-context-card dt,\n.inspector-context-card dd {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.required-flag {\n  color: #7c4d15;\n}\n\n.dual-unit-cell {\n  color: #5d6b66;\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n\n.viewport-shell {\n  display: grid;\n  grid-template-rows: auto minmax(520px, 1fr) auto auto;\n  min-height: 100%;\n  border-color: var(--ui-divider);\n  background: var(--ui-canvas);\n}\n\n.viewport-frame {\n  position: relative;\n  z-index: 1;\n  min-height: 520px;\n  overflow: hidden;\n}\n\n.viewport-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: start;\n  gap: 12px;\n  min-height: 36px;\n  padding: 9px 12px;\n  color: #31403d;\n  background: #edf2ef;\n  border-bottom: 1px solid #c8d0cb;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.viewport-canvas {\n  position: absolute;\n  inset: 0;\n  cursor: crosshair;\n}\n\n.viewport-canvas canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.viewport-fallback {\n  display: grid;\n  height: 100%;\n  min-height: 320px;\n  place-items: center;\n  padding: 24px;\n  color: var(--ui-muted);\n  background: var(--ui-canvas);\n  font-size: 13px;\n  text-align: center;\n}\n\n.viewport-selection-layer {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n.viewport-axis-triad,\n.viewport-view-cube,\n.viewport-scale-bar {\n  position: absolute;\n  z-index: 2;\n}\n\n.viewport-axis-triad,\n.viewport-scale-bar {\n  pointer-events: none;\n}\n\n.viewport-axis-triad {\n  left: 12px;\n  /* Position only (ROOT, slice B3): the shell sets the inset while its table strip lies over the canvas's foot. */\n  bottom: calc(12px + var(--viewport-presentation-bottom-inset, 0px));\n  width: 96px;\n  height: 96px;\n}\n\n.viewport-gizmo-host,\n.viewport-gizmo-host canvas {\n  width: 96px;\n  height: 96px;\n}\n\n.viewport-display-toggles {\n  display: flex;\n  gap: 4px;\n}\n\n.viewport-display-toggles button {\n  min-height: 24px;\n  padding: 2px 8px;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.viewport-display-toggles button[aria-pressed=\"true\"] {\n  color: #ffffff;\n  background: #31403d;\n  border-color: #31403d;\n}\n\n.viewport-view-cube {\n  top: 12px;\n  right: 12px;\n  display: grid;\n  grid-template-columns: repeat(3, auto);\n  gap: 4px;\n}\n\n.viewport-view-cube button {\n  min-height: 26px;\n  padding: 3px 7px;\n  font-size: 11px;\n}\n\n.viewport-view-cube button[aria-pressed=\"true\"] {\n  color: #ffffff;\n  background: #31403d;\n  border-color: #31403d;\n}\n\n.viewport-scale-bar {\n  right: 14px;\n  bottom: calc(14px + var(--viewport-presentation-bottom-inset, 0px));\n  min-width: 90px;\n  padding: 5px 8px 7px;\n  border-bottom: 4px solid var(--canvas-label);\n  color: var(--canvas-label);\n  background: var(--canvas-labelBg);\n  font-size: 12px;\n  font-weight: 700;\n  text-align: center;\n}\n\n.command-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 8px 10px;\n  border-top: 1px solid #c8d0cb;\n  border-bottom: 1px solid #c8d0cb;\n  background: #f7f9f6;\n  font-size: 12px;\n}\n\n.command-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.command-buttons button,\n.command-preview-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.command-buttons button.active,\n.command-buttons button[aria-pressed=\"true\"] {\n  color: #141f1d;\n  background: #fff4df;\n  border-color: #d57d16;\n  box-shadow: inset 0 0 0 1px rgba(213, 125, 22, 0.32);\n}\n\n.command-preview-button:disabled {\n  color: #7d8985;\n  background: #eef2ef;\n  cursor: not-allowed;\n}\n\n.command-active-tool {\n  flex: 1 1 220px;\n  min-width: 160px;\n  color: var(--ui-text);\n  font-size: 11px;\n  font-weight: 700;\n  overflow-wrap: anywhere;\n}\n\n.command-hint {\n  color: #5d6b66;\n  font-size: 11px;\n  font-style: italic;\n}\n\n.viewport-toolbar > span {\n  min-width: 0;\n}\n\n.viewport-deformation-status {\n  display: grid;\n  flex: 1 1 auto;\n  gap: 2px;\n  max-width: 58%;\n  padding-left: 10px;\n  border-left: 3px solid var(--ui-border);\n  color: var(--ui-text);\n}\n\n.viewport-deformation-status strong,\n.viewport-deformation-status small {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.viewport-deformation-status small {\n  color: var(--ui-muted);\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.viewport-deformation-status.available {\n  border-left: 3px solid var(--ui-accent);\n}\n\n.viewport-deformation-status.blocked {\n  border-left: 3px solid var(--ui-warning-border);\n}\n\n.viewport-select-target {\n  position: absolute;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  width: 58px;\n  height: 26px;\n  padding: 0 5px;\n  border: 1px solid rgba(46, 68, 62, 0.48);\n  border-radius: 4px;\n  color: #22312e;\n  background: rgba(255, 255, 255, 0.9);\n  box-shadow: 0 2px 8px rgba(35, 45, 42, 0.14);\n  cursor: pointer;\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 1;\n  pointer-events: auto;\n  transform: none;\n  visibility: hidden;\n  pointer-events: none;\n}\n\n.viewport-select-target[data-label-placed=\"true\"] {\n  visibility: visible;\n  pointer-events: auto;\n}\n\n.viewport-label-omissions { position: relative; }\n\n.viewport-label-omissions > div {\n  position: absolute; right: 0; top: 100%; z-index: 12;\n  width: 320px; max-height: 240px; overflow: auto;\n  padding: 8px; background: var(--ui-surface, white); border: 1px solid var(--ui-border);\n}\n\n.viewport-select-target span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.viewport-select-target.node {\n  border-color: rgba(47, 111, 115, 0.6);\n}\n\n.viewport-select-target.pipe {\n  border-color: rgba(79, 111, 115, 0.62);\n}\n\n.viewport-select-target.support {\n  border-color: rgba(107, 125, 73, 0.62);\n}\n\n.viewport-select-target.component {\n  border-color: rgba(135, 76, 98, 0.62);\n}\n\n.viewport-select-target.active,\n.viewport-select-target:focus-visible {\n  color: #141f1d;\n  background: #fff4df;\n  border-color: #d57d16;\n  outline: 2px solid rgba(213, 125, 22, 0.35);\n  outline-offset: 2px;\n}\n\n.viewport-intents {\n  position: relative;\n  z-index: 2;\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 10px;\n  padding: 10px 12px;\n  border-top: 1px solid #c8d0cb;\n  background: #fbfcfa;\n}\n\n.viewport-intents.collapsed {\n  display: none;\n}\n\n.viewport-intent-controls,\n.viewport-intent-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-content: start;\n  gap: 7px;\n}\n\nfieldset.viewport-intent-controls {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.viewport-node-form,\n.viewport-pipe-form {\n  display: grid;\n  gap: 7px;\n  width: 100%;\n}\n\n.viewport-node-form:not(.active),\n.viewport-pipe-form:not(.active) {\n  display: none;\n}\n\n.viewport-node-form {\n  grid-template-columns: minmax(96px, 1.2fr) minmax(96px, 1.2fr) repeat(3, minmax(52px, 0.7fr)) auto;\n}\n\n.viewport-pipe-form {\n  grid-template-columns: repeat(4, minmax(86px, 1fr));\n}\n\n.viewport-node-form label,\n.viewport-pipe-form label,\n.viewport-endpoint-field {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.viewport-node-form span,\n.viewport-pipe-form span {\n  color: #54615d;\n  font-size: 11px;\n}\n\n.viewport-node-form input,\n.viewport-pipe-form input,\n.viewport-pipe-form select {\n  width: 100%;\n  min-width: 0;\n  height: 30px;\n  padding: 5px 7px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n}\n\n.viewport-field-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  min-width: 0;\n  min-height: 18px;\n}\n\n.viewport-pipe-form .viewport-endpoint-pick {\n  align-self: center;\n  min-height: 20px;\n  padding: 1px 6px;\n  font-size: 10px;\n  line-height: 1;\n}\n\n.viewport-pipe-form .viewport-endpoint-pick[aria-pressed=\"true\"] {\n  color: #141f1d;\n  background: #fff4df;\n  border-color: #d57d16;\n}\n\n.viewport-intent-actions button,\n.viewport-node-form button,\n.viewport-pipe-form button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.viewport-node-form button,\n.viewport-pipe-form button {\n  align-self: end;\n  white-space: nowrap;\n}\n\n.viewport-node-form button:disabled,\n.viewport-pipe-form button:disabled {\n  color: #7d8985;\n  background: #eef2ef;\n  cursor: not-allowed;\n}\n\n.viewport-intent-list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 7px;\n  min-height: 30px;\n}\n\n.viewport-intent-list p {\n  grid-column: 1 / -1;\n  margin: 0;\n  color: #55625e;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.viewport-intent-list article {\n  display: grid;\n  gap: 2px;\n  padding: 7px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n  color: #2d3837;\n}\n\n.viewport-intent-list strong,\n.viewport-intent-list span,\n.viewport-intent-list small {\n  overflow-wrap: anywhere;\n}\n\n.viewport-intent-list strong {\n  font-size: 12px;\n}\n\n.viewport-intent-list span,\n.viewport-intent-list small {\n  color: #5f6c68;\n  font-size: 11px;\n}\n\n.agent-workbench-panel {\n  display: grid;\n  align-content: start;\n  gap: 12px;\n  min-height: 100%;\n}\n\n.agent-workbench-title {\n  display: grid;\n  grid-template-columns: 34px minmax(0, 1fr);\n  gap: 10px;\n  align-items: start;\n}\n\n.agent-workbench-icon {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  place-items: center;\n  border: 1px solid #b8c3bd;\n  border-radius: 6px;\n  color: #213832;\n  background: #e3eee8;\n}\n\n.agent-workbench-title p {\n  margin: 2px 0 0;\n  color: #5a6763;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.agent-focus-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 7px;\n}\n\n.agent-focus-fact,\n.agent-proposal-summary {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  padding: 8px;\n  border: 1px solid #d5ddd8;\n  border-radius: 6px;\n  background: #fbfcfa;\n}\n\n.agent-focus-fact span,\n.agent-proposal-summary span,\n.agent-proposal-summary small {\n  color: #5f6c68;\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.agent-focus-fact strong,\n.agent-proposal-summary strong {\n  min-width: 0;\n  color: #25332f;\n  font-size: 12px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.agent-action-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 7px;\n}\n\n.agent-action-grid button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 34px;\n  padding: 6px 8px;\n  border: 1px solid #aeb9b3;\n  border-radius: 6px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.agent-action-grid button:disabled {\n  color: #83908b;\n  background: #edf1ee;\n  cursor: not-allowed;\n}\n\n.agent-action-grid button:not(:disabled):hover {\n  border-color: #2d5b50;\n  background: #e6f0eb;\n}\n\n@media (max-width: 1040px) {\n  .viewport-intents,\n  .viewport-node-form,\n  .viewport-pipe-form {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-height: 840px) {\n  .workspace {\n    gap: 8px;\n    padding: 8px 10px;\n  }\n\n\n\n\n\n  .workspace-dock {\n    flex: 1 1 0;\n    min-height: 300px;\n  }\n}\n\n.record-list,\n.diagnostic-list,\n.proposal-body,\n.operation-record-list,\n.report-list {\n  display: grid;\n  gap: 9px;\n  overflow: auto;\n}\n\n.report-actions {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 9px;\n}\n\n.report-export-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  font-size: 12px;\n  text-decoration: none;\n}\n\n.report-actions span {\n  min-width: 0;\n  color: #56635f;\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.report-actions > .controlled-export-control {\n  grid-column: 1 / -1;\n}\n\n.controlled-export-control {\n  display: grid;\n  gap: 6px;\n  min-width: 0;\n  max-width: 100%;\n  align-content: start;\n}\n\n.controlled-export-control > label {\n  display: flex;\n  gap: 7px;\n  align-items: flex-start;\n  min-width: 0;\n}\n\n.controlled-export-details {\n  min-width: 0;\n  max-width: 100%;\n}\n\n.controlled-export-details > summary {\n  width: max-content;\n  max-width: 100%;\n  cursor: pointer;\n  color: var(--ui-text);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.controlled-export-details > summary:focus-visible {\n  outline: 2px solid var(--ui-focus);\n  outline-offset: 2px;\n}\n\n.controlled-export-technical-details {\n  display: grid;\n  gap: 6px;\n  max-height: min(16rem, 35vh);\n  min-width: 0;\n  margin-top: 5px;\n  padding: 7px;\n  overflow: auto;\n  color: var(--ui-text);\n  background: var(--ui-raised);\n  border: 1px solid var(--ui-divider);\n  border-radius: 4px;\n}\n\n.controlled-export-technical-details pre {\n  min-width: 0;\n  max-width: 100%;\n  margin: 0;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  color: inherit;\n  font: 11px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n}\n\n.record-row,\n.diagnostic,\n.diff-list article,\n.proposal-section,\n.operation-record,\n.result-detail-panel,\n.diagnostic-detail-panel,\n.mechanics-gap-ledger,\n.gap-list article {\n  padding: 9px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n}\n\n.diagnostic {\n  width: 100%;\n  color: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.record-row strong,\n.diagnostic strong,\n.operation-record strong,\n.diff-list strong {\n  display: block;\n  font-size: 13px;\n}\n\n.record-row small,\n.operation-record small {\n  display: block;\n  margin-top: 2px;\n  color: #6b756f;\n  font-size: 11px;\n}\n\n.record-row p,\n.diagnostic p,\n.proposal-body p,\n.operation-record p,\n.diff-list p {\n  margin: 6px 0 0;\n  color: #3a4643;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.proposal-section {\n  display: grid;\n  gap: 8px;\n}\n\n.solve-panel {\n  min-height: 285px;\n}\n\n.rule-check-panel {\n  min-height: 350px;\n}\n\n.run-audit-panel {\n  min-height: 210px;\n}\n\n.comparison-panel {\n  min-height: 500px;\n}\n\n.handoff-panel {\n  min-height: 330px;\n}\n\n.results-panel {\n  min-height: 520px;\n}\n\n.agent-panel {\n  min-height: 300px;\n}\n\n.project-storage-panel {\n  min-height: 260px;\n}\n\n.project-validation-panel {\n  min-height: 310px;\n}\n\n.diff-preview-panel {\n  min-height: 300px;\n}\n\n.operation-ledger-panel {\n  min-height: 300px;\n}\n\n.export-review-panel {\n  min-height: 320px;\n}\n\n.native-package-panel {\n  min-height: 320px;\n}\n\n.load-case-manager-panel {\n  min-height: 430px;\n}\n\n.report-panel {\n  min-height: 360px;\n}\n\n.load-case-list,\n.load-primitive-list,\n.load-combination-list {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.load-case-row,\n.primitive-load-row,\n.combination-summary-row {\n  display: grid;\n  gap: 3px;\n  width: 100%;\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  text-align: left;\n  cursor: pointer;\n}\n\n.load-case-row.active,\n.primitive-load-row.active,\n.combination-summary-row.active {\n  border-color: #86aaa0;\n  background: #eef7f2;\n  outline: 2px solid rgba(76, 127, 109, 0.18);\n  outline-offset: -2px;\n}\n\n.load-combination-row {\n  display: grid;\n  gap: 3px;\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n}\n\n.load-case-row strong,\n.primitive-load-row strong,\n.load-combination-row strong,\n.combination-summary-row strong {\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.load-case-row small,\n.primitive-load-row small,\n.load-combination-row small,\n.combination-summary-row small {\n  color: #66736f;\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.combination-term-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 6px;\n}\n\n.combination-term-row {\n  min-height: 28px;\n  padding: 5px 7px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  font-size: 11px;\n  text-align: left;\n  cursor: pointer;\n  overflow-wrap: anywhere;\n}\n\n.combination-term-row.active {\n  border-color: #86aaa0;\n  background: #eef7f2;\n  outline: 2px solid rgba(76, 127, 109, 0.18);\n  outline-offset: -2px;\n}\n\n.load-magnitude-editor,\n.load-metadata-editor,\n.combination-basis-editor,\n.combination-factor-editor,\n.combination-term-create-editor,\n.load-case-create-editor,\n.primitive-load-create-editor {\n  display: grid;\n  gap: 8px;\n  margin: 2px 0 10px;\n  padding: 9px;\n  border: 1px solid #d8dfdb;\n  border-radius: 4px;\n  background: #f8faf8;\n}\n\n.load-editor-heading {\n  display: grid;\n  grid-template-columns: 16px minmax(0, 0.7fr) minmax(0, 1.3fr);\n  align-items: center;\n  gap: 6px;\n}\n\n.load-editor-heading strong,\n.load-editor-heading span,\n.load-edit-preview {\n  overflow-wrap: anywhere;\n}\n\n.load-editor-heading strong {\n  font-size: 12px;\n}\n\n.load-editor-heading span {\n  color: #66736f;\n  font-size: 11px;\n}\n\n.load-editor-controls,\n.load-metadata-controls,\n.combination-basis-controls,\n.combination-factor-controls,\n.combination-delete-controls,\n.load-case-delete-controls,\n.combination-create-controls,\n.combination-term-create-controls,\n.load-case-create-controls,\n.primitive-load-create-controls {\n  display: grid;\n  grid-template-columns: minmax(72px, 0.7fr) minmax(0, 1fr) auto;\n  align-items: end;\n  gap: 7px;\n}\n\n.load-metadata-controls {\n  grid-template-columns: minmax(72px, 0.7fr) minmax(92px, 0.8fr) minmax(0, 1fr) auto;\n}\n\n.load-case-create-controls {\n  grid-template-columns: minmax(92px, 0.8fr) minmax(120px, 1fr) minmax(110px, 0.8fr) minmax(86px, 0.7fr) minmax(0, 1.1fr) auto;\n}\n\n.combination-term-create-controls {\n  grid-template-columns: minmax(126px, 1fr) minmax(98px, 0.8fr) minmax(80px, 0.6fr) minmax(0, 1fr) auto;\n}\n\n.combination-create-controls {\n  grid-template-columns: minmax(118px, 0.9fr) minmax(130px, 1fr) minmax(92px, 0.7fr) minmax(104px, 0.8fr) minmax(74px, 0.5fr) minmax(0, 1fr) minmax(0, 1fr) auto;\n}\n\n.combination-delete-controls,\n.load-case-delete-controls {\n  grid-template-columns: minmax(0, 1fr) auto;\n}\n\n.primitive-load-create-controls {\n  grid-template-columns: minmax(94px, 0.8fr) minmax(122px, 1fr) minmax(98px, 0.8fr) minmax(86px, 0.7fr) minmax(86px, 0.7fr) minmax(0, 1fr) auto;\n}\n\n.load-editor-controls label,\n.load-metadata-controls label,\n.combination-basis-controls label,\n.combination-factor-controls label,\n.combination-delete-controls label,\n.load-case-delete-controls label,\n.combination-create-controls label,\n.combination-term-create-controls label,\n.load-case-create-controls label,\n.primitive-load-create-controls label {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.load-editor-controls span,\n.load-metadata-controls span,\n.combination-basis-controls span,\n.combination-factor-controls span,\n.combination-delete-controls span,\n.load-case-delete-controls span,\n.combination-create-controls span,\n.combination-term-create-controls span,\n.load-case-create-controls span,\n.primitive-load-create-controls span {\n  color: #54615d;\n  font-size: 11px;\n}\n\n.load-editor-controls input,\n.load-metadata-controls input,\n.load-metadata-controls select,\n.combination-basis-controls input,\n.combination-factor-controls input,\n.combination-delete-controls input,\n.load-case-delete-controls input,\n.combination-create-controls input,\n.combination-create-controls select,\n.combination-term-create-controls input,\n.combination-term-create-controls select,\n.load-case-create-controls input,\n.primitive-load-create-controls input,\n.primitive-load-create-controls select {\n  min-width: 0;\n  height: 30px;\n  padding: 5px 7px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n}\n\n.load-editor-controls button,\n.load-metadata-controls button,\n.combination-basis-controls button,\n.combination-factor-controls button,\n.combination-delete-controls button,\n.load-case-delete-controls button,\n.combination-create-controls button,\n.combination-term-create-controls button,\n.load-case-create-controls button,\n.primitive-load-create-controls button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.load-editor-controls button:disabled,\n.load-metadata-controls button:disabled,\n.combination-basis-controls button:disabled,\n.combination-factor-controls button:disabled,\n.combination-delete-controls button:disabled,\n.load-case-delete-controls button:disabled,\n.combination-create-controls button:disabled,\n.combination-term-create-controls button:disabled,\n.load-case-create-controls button:disabled,\n.primitive-load-create-controls button:disabled {\n  color: #7d8985;\n  background: #eef2ef;\n  cursor: not-allowed;\n}\n\n.comparison-summary {\n  display: grid;\n  gap: 6px;\n  margin-bottom: 8px;\n}\n\n.comparison-fact {\n  display: grid;\n  grid-template-columns: 82px minmax(0, 1fr);\n  gap: 8px;\n  padding: 5px 6px;\n  border: 1px solid #e1e6e3;\n  border-radius: 4px;\n  background: #f8faf8;\n}\n\n.comparison-fact span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.comparison-fact strong {\n  color: #25312f;\n  font-size: 12px;\n  font-weight: 650;\n  overflow-wrap: anywhere;\n}\n\n.comparison-table {\n  display: grid;\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow: auto;\n  font-size: 11px;\n}\n\n.comparison-delta-header,\n.comparison-delta-row {\n  display: grid;\n  grid-template-columns: minmax(145px, 1.5fr) minmax(72px, 0.75fr) minmax(96px, 0.9fr) minmax(70px, 0.6fr);\n  gap: 6px;\n  width: 100%;\n  border-bottom: 1px solid #e1e6e3;\n  text-align: left;\n}\n\n.comparison-delta-header {\n  padding: 5px;\n  color: #65716c;\n  font-weight: 700;\n}\n\n.comparison-delta-shell {\n  min-width: 0;\n}\n\n.comparison-delta-row {\n  align-items: start;\n  padding: 5px;\n  border: 0;\n  border-bottom: 1px solid #e1e6e3;\n  color: #25312f;\n  background: transparent;\n  font: inherit;\n  cursor: pointer;\n}\n\n.comparison-delta-row:hover,\n.comparison-delta-row:focus-visible {\n  background: #eef5f2;\n  outline: 2px solid #4c7f6d;\n  outline-offset: -2px;\n}\n\n.comparison-delta-row span {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.comparison-delta-row span:first-child {\n  font-weight: 700;\n}\n\n.comparison-delta-row small {\n  display: block;\n  margin-top: 3px;\n  color: #65716c;\n  font-weight: 400;\n}\n\n.proposal-section h3 {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin: 0;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.proposal-meta-grid,\n.proposal-flag-grid {\n  display: grid;\n  gap: 7px;\n}\n\n.proposal-fact,\n.proposal-flag {\n  display: grid;\n  grid-template-columns: 116px minmax(0, 1fr);\n  gap: 8px;\n  padding: 6px;\n  border: 1px solid #e1e6e3;\n  border-radius: 4px;\n  background: #f8faf8;\n}\n\n.proposal-fact span,\n.proposal-flag span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.proposal-fact strong,\n.proposal-flag strong {\n  color: #25312f;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.proposal-flag.false strong {\n  color: #2d5b50;\n}\n\n.record-row span {\n  display: block;\n  margin-top: 7px;\n  color: #56635f;\n  font-size: 11px;\n}\n\n.diagnostic.warning {\n  border-color: #e4c478;\n  background: #fff8e7;\n}\n\n.diagnostic.error,\n.diagnostic.blocking {\n  border-color: #d7a7a7;\n  background: #fff1f1;\n}\n\n.diagnostic.info {\n  border-color: #adc9d9;\n  background: #eef7fb;\n}\n\n.diagnostic.active {\n  outline: 2px solid #2d5b50;\n  outline-offset: -2px;\n}\n\n.status-grid {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n\n.readiness-summary {\n  display: grid;\n  gap: 7px;\n  margin-bottom: 12px;\n}\n\n.readiness-row {\n  display: grid;\n  grid-template-columns: 18px 112px minmax(0, 1fr);\n  align-items: center;\n  gap: 7px;\n  min-height: 34px;\n  padding: 7px;\n  border: 1px solid var(--ui-divider);\n  border-radius: 4px;\n  color: var(--ui-text);\n  background: var(--ui-raised);\n}\n\n.readiness-row span {\n  color: inherit;\n  font-size: 11px;\n}\n\n.readiness-row strong {\n  color: inherit;\n  font-size: 12px;\n  font-weight: 650;\n  overflow-wrap: anywhere;\n}\n\n.readiness-row.ok {\n  color: var(--ui-text);\n  border-color: var(--ui-divider);\n  background: var(--ui-raised);\n}\n\n.readiness-row.info {\n  color: var(--ui-info-text);\n  border-color: var(--ui-info-border);\n  background: var(--ui-info-surface);\n}\n\n.readiness-row.warning {\n  color: var(--ui-warning-text);\n  border-color: var(--ui-warning-border);\n  background: var(--ui-warning-surface);\n}\n\n.readiness-row.blocking {\n  color: var(--ui-error-text);\n  border-color: var(--ui-error-border);\n  background: var(--ui-error-surface);\n}\n\n.solver-mode-control {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n  margin: 8px 0 10px;\n}\n\n.mode-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-width: 0;\n  min-height: 34px;\n  padding: 6px 8px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n  font-size: 12px;\n  font-weight: 650;\n  white-space: nowrap;\n}\n\n.mode-button.active {\n  color: #141f1d;\n  background: #fff4df;\n  border-color: #d57d16;\n  box-shadow: inset 0 0 0 1px rgb(213 125 22 / 32%);\n}\n\n.mode-button:disabled {\n  color: #7d8985;\n  background: #eef2ef;\n  cursor: not-allowed;\n}\n\n.status-pill {\n  display: grid;\n  gap: 3px;\n  padding: 8px;\n  border: 1px solid #d8dfdb;\n  border-radius: 4px;\n  background: #f7f9f6;\n}\n\n.status-pill span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.status-pill strong {\n  color: #25312f;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.diagnostic-controls {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto 32px;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.diagnostic-controls label {\n  display: grid;\n  grid-template-columns: 16px auto minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.diagnostic-controls label span,\n.diagnostic-controls > span {\n  color: #65716c;\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.diagnostic-controls input {\n  min-width: 0;\n  min-height: 30px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  font-size: 12px;\n}\n\n.diagnostic-controls button {\n  display: inline-grid;\n  width: 32px;\n  height: 30px;\n  place-items: center;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.diagnostic-controls button:disabled {\n  color: #9aa39f;\n  cursor: not-allowed;\n}\n\n.diagnostic-severity-summary {\n  display: grid;\n  grid-column: 1 / -1;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 6px;\n}\n\n.diagnostic-severity-summary span {\n  min-width: 0;\n  padding: 5px 6px;\n  border: 1px solid #d8dfdb;\n  border-radius: 4px;\n  color: #65716c;\n  background: #f7f9f6;\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.diagnostic-severity-summary strong {\n  color: #25312f;\n}\n\n.result-groups {\n  display: grid;\n  gap: 10px;\n  overflow: auto;\n}\n\n.result-controls {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.result-family-row {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));\n  gap: 6px;\n}\n\n.result-family-row button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  min-width: 0;\n  min-height: 32px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.result-family-row button span {\n  overflow: hidden;\n  font-size: 11px;\n  font-weight: 700;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.result-family-row button strong {\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n}\n\n.result-family-row button.result-family-active {\n  border-color: #2d5b50;\n  color: #ffffff;\n  background: #2d5b50;\n}\n\n.result-filter-row,\n.result-page-row {\n  display: grid;\n  align-items: center;\n  gap: 8px;\n}\n\n.result-filter-row {\n  grid-template-columns: minmax(0, 1fr) auto 32px;\n}\n\n.result-page-row {\n  grid-template-columns: auto minmax(0, 1fr) auto;\n}\n\n.result-filter-row label {\n  display: grid;\n  grid-template-columns: 16px auto minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.result-page-size {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n}\n\n.result-filter-row label span,\n.result-filter-row > span,\n.result-page-size span,\n.result-page-row > span {\n  color: #65716c;\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.result-controls input,\n.result-controls select {\n  min-width: 0;\n  min-height: 30px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  font-size: 12px;\n}\n\n.result-filter-row button {\n  display: inline-grid;\n  width: 32px;\n  height: 30px;\n  place-items: center;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.result-page-actions {\n  display: inline-flex;\n  gap: 6px;\n}\n\n.result-page-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  min-height: 30px;\n  padding: 5px 8px;\n  border: 1px solid #c8d0cb;\n  border-radius: 4px;\n  color: #25312f;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.result-controls button:disabled {\n  color: #9aa39f;\n  cursor: not-allowed;\n}\n\n.result-group {\n  display: grid;\n  gap: 5px;\n}\n\n.result-group h3 {\n  margin: 0;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.result-group tbody tr {\n  cursor: pointer;\n}\n\n.selected-result-row {\n  background: #e8f1ed;\n  box-shadow: inset 3px 0 0 #2d5b50;\n}\n\n.result-detail-panel,\n.diagnostic-detail-panel,\n.mechanics-gap-ledger {\n  display: grid;\n  gap: 8px;\n}\n\n.result-detail-panel h3,\n.diagnostic-detail-panel h3,\n.mechanics-gap-ledger h3 {\n  margin: 0;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.result-detail-panel dl,\n.diagnostic-detail-panel dl {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n}\n\n.result-detail-panel dl div,\n.diagnostic-detail-panel dl div {\n  display: grid;\n  grid-template-columns: 116px minmax(0, 1fr);\n  gap: 8px;\n}\n\n.result-detail-panel dt,\n.diagnostic-detail-panel dt,\n.gap-list small {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.result-detail-panel dd,\n.diagnostic-detail-panel dd {\n  margin: 0;\n  color: #25312f;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.endpoint-pair {\n  display: grid;\n  gap: 6px;\n}\n\n.endpoint-pair h4 {\n  margin: 0;\n  color: #465450;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.gap-list {\n  display: grid;\n  gap: 7px;\n}\n\n.gap-list strong {\n  display: block;\n  font-size: 12px;\n}\n\n.gap-list small {\n  display: block;\n  margin-top: 2px;\n}\n\n.gap-list p {\n  margin: 5px 0 0;\n  color: #3a4643;\n  font-size: 12px;\n  line-height: 1.35;\n}\n\n.primary-action,\n.secondary-action,\n.review-action {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  min-height: 36px;\n  width: 100%;\n  border: 1px solid #22302d;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.primary-action {\n  color: #ffffff;\n  background: #2d5b50;\n}\n\n.secondary-action {\n  margin-bottom: 10px;\n  color: #24322f;\n  background: #e6eee9;\n}\n\n.review-action {\n  color: #63706b;\n  background: #eef1ef;\n  border-color: #cbd3ce;\n  cursor: not-allowed;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\n\nth,\ntd {\n  padding: 8px 6px;\n  border-bottom: 1px solid #dfe4e1;\n  text-align: left;\n  vertical-align: top;\n  overflow-wrap: anywhere;\n}\n\nth {\n  color: #59645f;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.muted {\n  margin: 0;\n  color: #68736f;\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.diff-list {\n  display: grid;\n  gap: 8px;\n}\n\n.diff-list small {\n  display: block;\n  margin-top: 2px;\n  color: #66716d;\n}\n\n.report-line {\n  display: grid;\n  gap: 3px;\n  padding: 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 4px;\n  background: #ffffff;\n}\n\n.report-line span {\n  color: #65716c;\n  font-size: 11px;\n}\n\n.report-line strong {\n  color: #25312f;\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.report-note {\n  display: block;\n  margin-top: 10px;\n  color: #65716c;\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n@media (max-width: 1320px) {\n  body {\n    min-width: 960px;\n  }\n\n\n\n  .workspace {\n    gap: 8px;\n    padding: 8px;\n  }\n\n  .workspace-dock {\n    min-height: 280px;\n  }\n\n  .workspace-dock-section {\n    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));\n  }\n}\n\n/* Let the dock body scroll within the workspace track as chrome grows. */\n\n.workspace-dock {\n  min-height: 0;\n}\n\n.operation-apply-panel .muted {\n  margin-bottom: 8px;\n}\n\n/* The apply queue can grow long during authoring; bound it and let the queue\n   scroll inside the panel instead of pushing the section off screen. */\n\n.operation-apply-panel {\n  min-height: 230px;\n  max-height: 560px;\n  overflow: auto;\n}\n\n.operation-apply-panel .operation-record-list {\n  overflow: visible;\n}\n\n.operation-history-actions,\n.operation-apply-actions {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n}\n\n.operation-history-actions {\n  margin-bottom: 8px;\n}\n\n.operation-history-actions small {\n  color: #64716c;\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.operation-apply-actions {\n  margin-top: 6px;\n}\n\n.operation-history-actions button,\n.operation-apply-actions button {\n  position: relative;\n  z-index: 1;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n}\n\n.operation-history-actions button:disabled,\n.operation-apply-actions button:disabled {\n  color: #8a948f;\n  cursor: not-allowed;\n}\n\n.operation-outcome {\n  display: grid;\n  gap: 3px;\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px dashed #d9dfdb;\n}\n\n.review-apply-drawer {\n  display: grid;\n  gap: 0;\n  min-height: 0;\n  padding: 10px;\n  border: 1px solid #c8d0cb;\n  border-radius: 6px;\n  background: #f8faf8;\n}\n\n.review-apply-drawer-header {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 12px;\n}\n\n.review-apply-drawer-header span {\n  color: #68736f;\n  font-size: 10px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.review-apply-drawer-header h2 {\n  margin: 1px 0 3px;\n  color: #263331;\n  font-size: 14px;\n}\n\n.review-apply-drawer-header p {\n  margin: 0;\n  color: #5f6b67;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.review-apply-drawer-header button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid #b8c3bd;\n  border-radius: 4px;\n  color: #263331;\n  background: #ffffff;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.review-apply-detail-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));\n  gap: 10px;\n  max-height: 0;\n  overflow: hidden;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.review-apply-drawer.open .review-apply-detail-grid {\n  max-height: none;\n  margin-top: 10px;\n  overflow: visible;\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.panel-subtitle {\n  margin-top: 10px;\n  color: #59645f;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n/* Rule-pack structured AST expression composer (TP-C2-COMPOSER-001). */\n\n.rule-pack-expression-composer {\n  gap: 8px;\n}\n\n.rule-pack-variable-browser {\n  padding: 4px 0;\n  color: #59645f;\n}\n\n.rule-pack-expression-rendering {\n  display: grid;\n  gap: 4px;\n  padding: 6px 8px;\n  border: 1px solid #d9dfdb;\n  border-radius: 6px;\n  background: #f8faf8;\n  color: #304139;\n}\n\n.rule-pack-expression-rendering > small {\n  color: #59645f;\n}\n\n.rule-pack-expression-rendering > pre {\n  margin: 0;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-size: 12px;\n}\n\n.rule-pack-node {\n  display: grid;\n  gap: 4px;\n  border-left: 2px solid #d9dfdb;\n}\n\n.rule-pack-node-label {\n  color: #59645f;\n}\n\n.rule-pack-node-readonly {\n  color: #8a5a2b;\n}\n\n.rule-pack-node-field {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n}\n\n.rule-pack-node-field > span {\n  min-width: 72px;\n  color: #59645f;\n}\n\n.rule-pack-operand {\n  display: grid;\n  gap: 4px;\n}\n\n.rule-pack-table-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.rule-pack-check-statuses {\n  display: grid;\n  gap: 2px;\n}\n\n.rule-pack-check-subgroup {\n  display: grid;\n  gap: 4px;\n  padding-left: 8px;\n  border-left: 2px solid #eef1ef;\n}\n\n/* Accepted vocabulary navigation; forms continue to own draft and operation state. */\n\n.toolkit-palette { position: relative; padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--border, #344152); }\n\n.toolkit-commands { padding: 0.7rem 0; max-height: min(60vh, 36rem); overflow: auto; }\n\n.toolkit-commands > label { display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.5rem; }\n\n.toolkit-commands input { min-width: 0; flex: 1; }\n\n.toolkit-command-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0.6rem 1rem; }\n\n.toolkit-command { display: grid; gap: 0.25rem; margin-bottom: 0.8rem; }\n\n.toolkit-command button { text-align: left; }\n\n.toolkit-command small { line-height: 1.45; }\n\n.toolkit-command button:disabled { opacity: 0.65; }\n\n.toolkit-palette :focus-visible { outline: 2px solid #60a5fa; outline-offset: 2px; }\n\n#geometry-tools, #boundary-authoring, #hanger-selection,\n#self-weight-plan, #offline-proposal-intake, #batch-review {\n  padding: 1rem;\n  border: 1px solid var(--border-color, #cad5d6);\n  border-radius: 0.4rem;\n  margin-block: 0.8rem;\n}\n\n#geometry-tools label, #boundary-authoring label, #hanger-selection label,\n#self-weight-plan label, #offline-proposal-intake label {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0.4rem;\n  max-width: 100%;\n}\n\n#offline-proposal-intake textarea {\n  min-width: min(36rem, 70vw);\n  font-family: monospace;\n}\n\n#batch-review article {\n  padding-block: 0.75rem;\n  border-top: 1px solid var(--border-color, #cad5d6);\n}\n\n#batch-review button + button {\n  margin-inline-start: 0.5rem;\n}\n\n[data-display-status] small {\n  font-size: 0.75em;\n}\n\n/* Modeling workspace, September 2026: viewport owns the remaining height.\n   Navigation never adds an unbounded content row. Creation forms and properties\n   scroll in rails; analysis/review uses one bounded dock. Minimum checked target\n   is 1024 × 768, an initial layout target rather than usability acceptance. */\n\nbody { min-width: 760px; min-height: 540px; }\n\n.app-shell, .app-shell.native-menu { display: flex; flex-direction: column; height: 100dvh; min-height: 540px; overflow: hidden; }\n\n.titlebar-actions { gap: 5px; flex-wrap: nowrap; }\n\n.titlebar-actions button { font-size: 11px; padding: 5px 7px; }\n\n.project-strip { position: relative; display: block; padding: 0 12px; min-height: 22px; flex: 0 0 auto; font-size: 11px; }\n\n.project-strip > summary { cursor: pointer; padding: 3px 0; }\n\n.project-strip[open] { max-height: 100px; overflow: auto; }\n\n.project-strip[open] > span { display: block; margin-block: 4px; overflow-wrap: anywhere; }\n\n.app-menu-bar { flex: 0 0 auto; padding: 0 8px; }\n\n.app-menu-trigger { min-height: 26px; font-size: 12px; padding: 3px 9px; }\n\n.operation-tabs button { display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-height: 30px; padding: 5px 8px; font-size: 12px; border: 1px solid transparent; border-radius: 5px; color: #31403d; background: transparent; white-space: nowrap; cursor: pointer; }\n\n.operation-tabs button:hover { background: #e5ece8; }\n\n.operation-tabs button[aria-pressed=\"true\"] { color: #fff; background: #285b50; border-color: #285b50; }\n\n.workspace-count { min-width: 18px; border-radius: 9px; padding: 1px 4px; color: #fff; background: #286453; font-size: 10px; }\n\n.workspace { flex: 1 1 0; min-width: 0; min-height: 0; padding: 6px; gap: 6px; overflow: hidden; }\n\n.workspace-pane { gap: 0; border: 1px solid #c8d0cb; border-radius: 6px; background: #fff; }\n\n.workspace-pane-tree > .panel, .workspace-pane-inspector > .panel { border: 0; border-radius: 0; padding: 10px; }\n\n.workspace-pane-viewport { overflow: hidden; }\n\n.workspace-pane-viewport > .viewport-shell { min-height: 0; height: 100%; border: 0; border-radius: 0; }\n\n.viewport-shell { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr) auto; overflow: hidden; }\n\n/* Keep toolbar wrapping inside its own scroll region, never in the canvas row.\n   Status has a separate fixed row so selection text cannot resize the canvas. */\n\n.viewport-toolbar { grid-row: 2; grid-column: 1; display: grid; align-items: stretch; justify-content: stretch; grid-template-rows: minmax(0, 1fr) 24px; box-sizing: border-box; height: 80px; min-height: 0; min-width: 0; padding: 4px 8px; gap: 4px; font-size: 11px; }\n\n.viewport-toolbar-controls { display: flex; flex-wrap: wrap; align-items: center; align-content: start; gap: 4px 8px; min-height: 0; min-width: 0; overflow: auto; scrollbar-width: thin; }\n\n.viewport-toolbar-controls > * { flex: 0 0 auto; max-width: 100%; }\n\n.viewport-toolbar-controls .viewport-deformation-status[open] > div { position: static; box-sizing: border-box; width: min(250px, 100%); }\n\n.viewport-toolbar-status-strip {\n  box-sizing: border-box;\n  display: flex;\n  flex: 1 1 100%;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  min-width: 0;\n  height: 24px;\n  min-height: 24px;\n  max-height: 24px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  white-space: nowrap;\n  scrollbar-width: thin;\n}\n\n.viewport-toolbar-status-strip > span {\n  flex: 0 0 auto;\n  min-width: 0;\n  max-width: min(28rem, 42%);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.viewport-toolbar-selection-status { max-width: min(22rem, 34%) !important; }\n\n.viewport-frame { grid-row: 3; grid-column: 1; min-height: 0; height: 100%; }\n\n.viewport-canvas { min-height: 0; height: 100%; }\n\n.viewport-canvas canvas { display: block; }\n\n.command-bar { grid-row: 1; grid-column: 1 / -1; box-sizing: border-box; max-height: 56px; overflow: auto; scrollbar-width: thin; min-width: 0; min-height: 38px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 5px 7px; border-top: 0; border-bottom: 1px solid #d6ded9; }\n\n.viewport-measurement-strip { grid-row: 4; grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; min-width: 0; min-height: 30px; padding: 5px 8px; overflow-wrap: anywhere; border-top: 1px solid var(--ui-divider); color: var(--ui-text); background: var(--ui-raised); font-size: 11px; }\n\n.viewport-measurement-strip strong { min-width: 0; }\n\n.command-buttons { gap: 4px; flex-wrap: wrap; }\n\n.command-buttons button, .command-preview-button { font-size: 11px; min-height: 28px; padding: 4px 6px; }\n\n.command-active-tool { font-size: 11px; padding: 4px 6px; }\n\n.command-context { font-size: 11px; margin-left: auto; position: relative; }\n\n.command-context summary { cursor: pointer; }\n\n.command-context[open] > .command-context-content { position: absolute; top: 25px; right: 0; z-index: 12; width: 260px; padding: 10px; border: 1px solid #c8d0cb; background: #fff; box-shadow: 0 6px 20px #162d3026; }\n\n.command-bar .command-context[open] > .command-context-content { position: static; width: min(260px, 100%); box-sizing: border-box; }\n\n.command-context-content > span { display: block; margin: 6px 0; overflow-wrap: anywhere; }\n\n.viewport-shell:has(.viewport-intents.active) { grid-template-columns: minmax(0, 1fr) 265px; }\n\n.viewport-shell > .viewport-intents.active { grid-column: 2; grid-row: 2 / 4; min-width: 0; min-height: 0; max-height: none; overflow: auto; padding: 10px; border-top: 0; border-left: 1px solid #c8d0cb; background: #f7f9f8; }\n\n.viewport-intent-controls, .viewport-node-form, .viewport-pipe-form { display: flex; flex-direction: column; align-items: stretch; gap: 9px; min-width: 0; }\n\n.viewport-node-form:not(.active), .viewport-pipe-form:not(.active) { display: none; }\n\n.viewport-node-form label, .viewport-pipe-form label, .viewport-endpoint-field { min-width: 0; }\n\n.viewport-node-form input, .viewport-pipe-form input, .viewport-pipe-form select { width: 100%; min-width: 0; }\n\n.viewport-end-mode { display: flex; flex-wrap: wrap; gap: 5px 10px; min-width: 0; margin: 0; padding: 7px; border: 1px solid #d6ded9; border-radius: 4px; }\n\n.viewport-end-mode legend { padding-inline: 4px; color: #54615d; font-size: 11px; }\n\n.viewport-end-mode label { display: flex; align-items: center; gap: 5px; font-size: 11px; }\n\n.viewport-end-mode input { width: auto; height: auto; }\n\n.viewport-new-endpoint { display: grid; gap: 7px; padding: 8px; border: 1px solid #d6ded9; border-radius: 5px; background: #fff; }\n\n.viewport-new-endpoint[hidden] { display: none; }\n\n.viewport-new-endpoint small { color: #5d6965; line-height: 1.35; }\n\n.viewport-routing-aids {\n  display: grid;\n  gap: 7px;\n  min-width: 0;\n  margin: 0;\n  padding: 8px;\n  border: 1px solid #c7d6d0;\n  border-radius: 5px;\n  background: #f3f8f5;\n}\n\n.viewport-routing-aids legend {\n  padding-inline: 4px;\n  color: #415652;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.viewport-routing-axis {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 5px;\n}\n\n.viewport-routing-axis label {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  min-height: 28px;\n  padding: 4px;\n  border: 1px solid #cbd6d1;\n  border-radius: 4px;\n  background: #fff;\n  font-size: 11px;\n}\n\n.viewport-routing-axis input {\n  width: auto;\n  min-width: auto;\n}\n\n.viewport-routing-axis label:has(input:disabled) {\n  color: #929c98;\n  background: #eef1ef;\n}\n\n.viewport-draft-review { display: grid; gap: 6px; min-width: 0; padding: 8px; border: 1px solid #aebdb6; border-radius: 5px; background: #eef4f1; font-size: 11px; }\n\n.viewport-draft-review h4, .viewport-draft-review p { margin: 0; overflow-wrap: anywhere; }\n\n.viewport-draft-review [data-testid=\"viewport-draft-review-preview\"] { max-height: 126px; min-height: 0; overflow: auto; }\n\n.viewport-draft-review ul { max-height: 120px; margin: 0; padding-left: 18px; overflow: auto; }\n\n.viewport-draft-review button { min-height: 30px; }\n\n.viewport-intent-list { margin-top: 8px; }\n\n.viewport-tool-heading { margin: 0 0 10px; font-size: 13px; font-weight: 650; }\n\n.viewport-technical-details { margin-top: 10px; font-size: 11px; }\n\n.viewport-technical-details summary { cursor: pointer; }\n\n.viewport-deformation-status { display: block; position: relative; max-width: 100%; font-size: 10px; }\n\n.viewport-deformation-status > summary { cursor: pointer; }\n\n.viewport-deformation-status[open] > div { position: absolute; top: 20px; left: 0; z-index: 12; width: 250px; padding: 10px; background: var(--ui-surface); border: 1px solid var(--ui-divider); box-shadow: 0 6px 20px #162d3026; }\n\n.viewport-toolbar > span:last-child { margin-left: auto; }\n\n.viewport-display-toggles { gap: 3px; }\n\n.viewport-display-toggles button { font-size: 10px; padding: 2px 5px; }\n\n/* Current measured viewport chrome plus 200px canvas and the workspace gap.\n   Clamping the displayed dock does not change its saved height preference. */\n\n.workspace-dock { flex: 0 0 clamp(180px, var(--workspace-dock-height, 260px), 600px); max-height: min(60%, max(0px, calc(100% - var(--workspace-modeling-reserve, 100%)))); min-height: 0; border: 1px solid #bccbc3; border-radius: 6px; overflow: hidden; background: #f7f9f8; }\n\n.workspace-dock-splitter { position: relative; flex: 0 0 24px; width: 100%; min-height: 24px !important; padding: 0; border: 0; border-radius: 0; background: transparent; cursor: row-resize; touch-action: none; }\n\n.workspace-dock-splitter::after { content: \"\"; position: absolute; inset: 11px 0; background: var(--ui-divider); }\n\n.workspace-dock-header { min-height: 32px; padding: 4px 9px; }\n\n.workspace-dock-header h2 { font-size: 13px; }\n\n.workspace-dock-header button { display: inline-flex; align-items: center; gap: 4px; min-height: 24px; }\n\n.workspace-dock-body { min-width: 0; min-height: 0; overflow: auto; padding: 8px; }\n\n.workspace-dock-section { grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 8px; }\n\n.workspace-dock-section[data-testid=\"workspace-section-operations\"] { display: block; }\n\n.workspace-dock-section.inactive, .workspace-dock-section[data-testid=\"workspace-section-operations\"].inactive { display: none; }\n\n.operation-tabs { display: flex; flex-wrap: wrap; gap: 4px; background: #f7f9f8; padding-bottom: 6px; border-bottom: 1px solid #d6ded9; }\n\n.operation-tool-page { min-width: 0; margin-top: 8px; }\n\n.operation-tool-page[hidden] { display: none; }\n\n.review-tool-page { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 8px; }\n\n.operation-apply-panel { min-height: 0; max-height: none; overflow: visible; }\n\n#geometry-tools, #boundary-authoring, #hanger-selection, #self-weight-plan, #offline-proposal-intake, #batch-review { min-width: 0; padding: 10px; margin-block: 0; }\n\n#offline-proposal-intake textarea { min-width: 0; width: 100%; }\n\n.status-bar { flex: 0 0 auto; min-height: 30px; padding: 3px 10px; gap: 6px; }\n\n.status-pill-group, .status-bar-actions { gap: 5px; }\n\n.status-pill { padding: 3px 5px; min-height: 24px; gap: 4px; font-size: 10px; }\n\n.status-drawer-button { min-height: 24px; padding: 3px 6px; font-size: 10px; }\n\n.status-drawer-button small { font-size: 9px; }\n\n.toolkit-palette { position: static; display: flex; align-items: center; min-width: 0; padding: 0; border: 0; }\n\n.toolkit-group-shortcuts { display: inline-flex; align-items: center; gap: 2px; margin-inline-start: 3px; }\n\n.toolkit-group-shortcuts button { min-height: 26px !important; padding-inline: 5px; font-size: 10px; }\n\n.toolkit-active-group { margin: 7px 0 0; color: var(--ui-muted); font-size: 11px; }\n\n.toolkit-commands { position: fixed; z-index: 100; top: 145px; left: 50%; transform: translateX(-50%); width: min(680px, calc(100vw - 48px)); max-height: min(540px, calc(100dvh - 180px)); margin: 0; padding: 14px; overflow: auto; border: 1px solid #aabeb3; border-radius: 10px; background: #fff; color: #263331; box-shadow: 0 18px 65px #152e3545; }\n\n.toolkit-search-header { display: flex; gap: 10px; position: sticky; top: -14px; z-index: 1; background: #fff; padding-block: 5px 10px; border-bottom: 1px solid #d6ded9; }\n\n.toolkit-search-header label { display: flex; align-items: center; gap: 10px; flex: 1; font-size: 12px; }\n\n.toolkit-search-header input { min-width: 0; flex: 1; padding: 8px; border: 1px solid #b8c3bd; border-radius: 5px; }\n\n.toolkit-command-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 10px; }\n\n.toolkit-command-groups h3 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #65716c; margin: 8px 0; }\n\n.toolkit-command { padding-bottom: 7px; margin-bottom: 5px; border-bottom: 1px solid #edf2ef; gap: 2px; }\n\n.toolkit-command > button { justify-content: flex-start; width: 100%; white-space: normal; text-align: left; }\n\n.toolkit-command small, .toolkit-command-help { font-size: 11px; color: #59645f; }\n\n.toolkit-command-help summary { cursor: pointer; }\n\n@media (max-width: 1100px) {\n  .workspace-toolbar { gap: 4px; padding-inline: 7px; }\n  .workspace-toolbar button { padding-inline: 6px; gap: 4px; font-size: 11px; }\n\n\n\n  .viewport-shell:has(.viewport-intents.active) { grid-template-columns: minmax(310px, 1fr) 250px; }\n  .viewport-intents.active { padding: 8px; }\n}\n\n.project-strip > summary { display: flex; align-items: baseline; gap: 12px; }\n\n.project-strip > summary [role=\"status\"] { overflow-wrap: anywhere; }\n\n.project-details-label { margin-left: auto; text-decoration: underline; flex-shrink: 0; }\n\n.toolkit-backdrop { position: fixed; inset: 0; z-index: 99; background: #172f3010; }\n\n.inspector { font-size: 12px; line-height: 1.4; }\n\n.inspector h2, .inspector h3 { font-size: 13px; margin-block: 8px; }\n\n.inspector summary { cursor: pointer; padding-block: 5px; font-weight: 550; }\n\n.inspector label { font-size: 12px; }\n\n.inspector fieldset { min-width: 0; margin: 8px 0; padding: 9px; border: 1px solid #d6ded9; border-radius: 5px; }\n\n.inspector fieldset > label { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 7px 0; }\n\n.inspector input:not([type=\"checkbox\"]):not([type=\"radio\"]), .inspector select, .inspector textarea { min-width: 0; max-width: 100%; padding: 6px; border: 1px solid #b8c3bd; border-radius: 4px; font: inherit; color: #263331; background: #fff; }\n\n.inspector input[type=\"checkbox\"], .inspector input[type=\"radio\"] { flex: 0 0 auto; width: auto; min-width: 0; margin: 0; }\n\n.inspector button { font-size: 12px; }\n\n.inspector p { margin-block: 7px; }\n\n.inspector #section-assignment { grid-template-columns: minmax(0, 1fr); }\n\n.status-pill { display: block; position: relative; }\n\n.status-pill > summary { cursor: pointer; display: flex; gap: 4px; align-items: center; }\n\n.status-pill[open] > div { position: absolute; bottom: 30px; left: 0; z-index: 30; min-width: 210px; max-width: 340px; padding: 10px; border: 1px solid #c8d0cb; border-radius: 5px; background: #fff; box-shadow: 0 -4px 20px #162d3026; }\n\n.status-pill[open] > div > strong, .status-pill[open] code { display: block; white-space: normal; overflow-wrap: anywhere; }\n\n/*\n * Workspace variables, defined in terms of the design tokens (tokens.css, generated from\n * design/tokens.json; design system V1.3 section 2). The token blocks follow the resolved theme\n * through data-theme on the document root, which the session (features/workspace/workspaceSession.ts)\n * keeps equal to the shell's data-theme,\n * so each mapped variable is defined once and needs no dark override.\n * --ui-canvas and --ui-viewport-selection-geometry mirror the viewport's own scene and selection\n * colours (features/viewport), which read canvas.bg and canvas.selection; the tokens carry the theme.\n * Kept without a token, each with its dark value in the override below:\n * --ui-border draws the boundary of buttons and inputs, which the product holds at 3:1 or better\n * against the surface (WCAG 1.4.11; e2e resolved-style check); border.strong measures 1.75:1 to\n * 2.36:1 (design system section 2.9).\n * --ui-disabled-text keeps a disabled control's label findable, because a control that is\n * disabled with its reason has to be found to be read. On disabled.fill (tokens 1.2) the kept\n * values measure 3.94:1 in light and 5.71:1 in dark; text.disabled measures 1.94:1 and 2.28:1\n * there. Section 2.9 names text.disabled as the one token to lift and section 8 item 6 leaves the\n * contrast target open, so the mapping waits for the design system to settle it. --ui-disabled,\n * the fill, is mapped.\n */\n\n.app-shell {\n  --ui-bg: var(--surface-base); --ui-surface: var(--surface-panel); --ui-raised: var(--surface-header);\n  --ui-canvas: var(--canvas-bg);\n  --ui-text: var(--text-primary); --ui-muted: var(--text-secondary);\n  --ui-divider: var(--border-hairline); --ui-border: #71838d;\n  --ui-accent: var(--selection-bar); --ui-accent-text: var(--text-inverse);\n  --ui-selection: var(--selection-band); --ui-selection-text: var(--text-primary);\n  --ui-info-surface: var(--issue-infoTint); --ui-info-text: var(--status-reviewInk); --ui-info-border: var(--issue-info);\n  --ui-warning-surface: var(--issue-warningTint); --ui-warning-text: var(--status-incompleteInk); --ui-warning-border: var(--issue-warning);\n  --ui-error-surface: var(--issue-blockingTint); --ui-error-text: var(--status-failedInk); --ui-error-border: var(--issue-blocking);\n  --ui-viewport-selection-geometry: var(--canvas-selection);\n  --ui-focus: var(--focus-ring); --ui-disabled: var(--disabled-fill); --ui-disabled-text: #667680;\n  color: var(--ui-text); background: var(--ui-bg);\n  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: 14px; line-height: 1.4;\n}\n\n.app-shell[data-theme=\"dark\"] {\n  --ui-border: #70828c;\n  --ui-disabled-text: #9baab2;\n}\n\n.app-shell[data-density=\"compact\"] { font-size: 13px; }\n\n.app-shell .workspace-toolbar, .app-shell .workspace-pane, .app-shell .workspace-dock,\n.app-shell .panel, .app-shell .viewport-toolbar, .app-shell .command-bar,\n.app-shell .workspace-dock-body, .app-shell .operation-tabs { color: var(--ui-text); background: var(--ui-surface); border-color: var(--ui-divider); }\n\n.app-shell input, .app-shell select, .app-shell textarea, .app-shell button {\n  color: var(--ui-text); background-color: var(--ui-surface); border-color: var(--ui-border);\n}\n\n.app-shell button[aria-pressed=\"true\"], .app-shell .tree-row[aria-selected=\"true\"] {\n  color: var(--ui-selection-text); background: var(--ui-selection); border-inline-start: 3px solid var(--ui-accent);\n}\n\n.app-shell button:disabled, .app-shell input:disabled, .app-shell select:disabled {\n  color: var(--ui-disabled-text); background: var(--ui-disabled);\n}\n\n.app-shell :focus-visible { outline: 2px solid var(--ui-focus); outline-offset: 2px; }\n\n.app-shell .layout-mode-toggle button,\n.app-shell .entity-grid-tabs button,\n.app-shell .entity-grid-actions button {\n  appearance: none;\n  border: 1px solid var(--ui-border);\n  border-radius: 5px;\n  color: var(--ui-text);\n  background: var(--ui-surface);\n  box-shadow: none;\n}\n\n.app-shell .layout-mode-toggle button:hover:not(:disabled),\n.app-shell .entity-grid-tabs button:hover:not(:disabled),\n.app-shell .entity-grid-actions button:hover:not(:disabled) { background: var(--ui-raised); }\n\n.app-shell .layout-mode-toggle button[aria-pressed=\"true\"],\n.app-shell .entity-grid-tabs button[aria-pressed=\"true\"] {\n  border: 1px solid var(--ui-accent);\n  color: var(--ui-selection-text);\n  background: var(--ui-selection);\n  box-shadow: none;\n  font-weight: 600;\n}\n\n.app-shell .layout-mode-toggle button:disabled,\n.app-shell .entity-grid-tabs button:disabled,\n.app-shell .entity-grid-actions button:disabled {\n  border-color: var(--ui-divider);\n  color: var(--ui-disabled-text);\n  background: var(--ui-disabled);\n  box-shadow: none;\n}\n\n.app-shell[data-density=\"comfortable\"] button, .app-shell[data-density=\"comfortable\"] select,\n.app-shell[data-density=\"comfortable\"] input:not([type=\"checkbox\"]):not([type=\"radio\"]) { min-height: 32px; }\n\n.app-shell[data-density=\"compact\"] button, .app-shell[data-density=\"compact\"] select,\n.app-shell[data-density=\"compact\"] input:not([type=\"checkbox\"]):not([type=\"radio\"]) { min-height: 28px; }\n\n.task-action-footer { position: sticky; bottom: 0; z-index: 8; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; padding: 8px 0; border-top: 1px solid var(--ui-divider); background: var(--ui-surface); }\n\n.task-action-footer button { min-width: 0; }\n\n.inspector-view-tabs { position: sticky; top: 0; z-index: 9; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding-block: 4px; background: var(--ui-surface); }\n\n.inspector-view-tabs [role=\"tab\"][aria-selected=\"true\"] { color: var(--ui-selection-text); background: var(--ui-selection); border-color: var(--ui-accent); }\n\n.model-tree-virtual { min-height: 0; max-height: 100%; border-block: 1px solid var(--ui-divider); }\n\n.tree-row { box-sizing: border-box; width: 100%; height: 100%; min-width: 0; min-height: 0; max-height: 100%; padding: 3px 6px; align-items: center; grid-template-columns: 18px minmax(0, 1fr) auto; gap: 5px; overflow: hidden; border: 0; border-bottom: 1px solid var(--ui-divider); border-radius: 0; line-height: 1.15; }\n\n.tree-row > span { min-width: 0; overflow: hidden; }\n\n.tree-row strong, .tree-row small { display: block; min-width: 0; overflow: hidden; overflow-wrap: normal; text-overflow: ellipsis; white-space: nowrap; }\n\n.tree-row small { margin-top: 1px; }\n\n.tree-row.hidden-entity { opacity: .7; text-decoration: line-through; }\n\n.tree-visibility-state { margin-left: auto; color: var(--ui-muted); font-size: .78em; text-decoration: none; }\n\n.viewport-selection-tools, .viewport-geometry-tools { display: flex; align-items: center; flex-wrap: wrap; gap: 3px; }\n\n.viewport-selection-tools button, .viewport-selection-tools select, .viewport-geometry-tools button { min-height: 28px; padding: 3px 6px; font-size: 11px; }\n\n.viewport-toolbar button, .viewport-intents button, .inspector button, .property-inspector button { border: 1px solid var(--ui-border); border-radius: 4px; font: inherit; }\n\n.viewport-box-rect { position: absolute; z-index: 9; pointer-events: none; border: 1px solid var(--ui-focus); background: color-mix(in srgb, var(--ui-selection) 35%, transparent); }\n\n.box-select-active .viewport-selection-layer { pointer-events: none; }\n\n.box-select-active .viewport-select-target { pointer-events: none; }\n\n.box-select-active canvas { cursor: crosshair; }\n\n.visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n.virtual-target-picker { display: grid; gap: 6px; min-width: 0; }\n\n.virtual-target-picker input { width: 100%; min-width: 0; }\n\n.virtual-target-picker-list { border: 1px solid var(--ui-divider); border-radius: 4px; background: var(--ui-surface); }\n\n.virtual-target-picker-option { box-sizing: border-box; width: 100%; height: 100%; min-height: 0 !important; justify-content: flex-start; overflow: hidden; border: 0; border-bottom: 1px solid var(--ui-divider); border-radius: 0; text-align: left; }\n\n.entity-grid-virtual-table { min-width: max-content; border: 1px solid var(--ui-divider); }\n\n.entity-grid-virtual-row { display: grid; min-width: max-content; border-bottom: 1px solid var(--ui-divider); }\n\n.entity-grid-virtual-row > * { min-width: 0; padding: 4px 6px; border-right: 1px solid var(--ui-divider); overflow: hidden; }\n\n.entity-grid-virtual-row input, .entity-grid-virtual-row select { width: 100%; min-width: 0; }\n\n.entity-grid-virtual-row.header { position: sticky; top: 0; z-index: 2; background: var(--ui-raised); }\n\n.app-shell .viewport-intents.active, .app-shell .viewport-new-endpoint,\n.app-shell .viewport-routing-aids, .app-shell .viewport-draft-review,\n.app-shell .command-context[open] > .command-context-content,\n.app-shell .viewport-deformation-status[open] > div,\n.app-shell .toolkit-commands, .app-shell .toolkit-search-header,\n.app-shell .status-pill[open] > div {\n  color: var(--ui-text);\n  background: var(--ui-surface);\n  border-color: var(--ui-divider);\n}\n\n.app-shell .viewport-routing-axis label, .app-shell .operation-tabs,\n.app-shell .entity-grid-virtual-row.header { color: var(--ui-text); background: var(--ui-raised); border-color: var(--ui-divider); }\n\n.app-shell .viewport-new-endpoint small, .app-shell .viewport-routing-aids legend,\n.app-shell .toolkit-command small, .app-shell .toolkit-command-help,\n.app-shell .toolkit-command-groups h3 { color: var(--ui-muted); }\n\n.app-shell .inspector input:not([type=\"checkbox\"]):not([type=\"radio\"]),\n.app-shell .inspector select, .app-shell .inspector textarea { color: var(--ui-text); background: var(--ui-surface); border-color: var(--ui-border); }\n\n@media (max-width: 1279px) {\n  body { min-width: 0; }\n  .viewport-shell:has(.viewport-intents.active) { grid-template-columns: minmax(0, 1fr) minmax(250px, 34vw); }\n}\n\n@media (max-width: 899px) {\n  .viewport-shell:has(.viewport-intents.active) { grid-template-columns: minmax(0, 1fr); }\n  .viewport-shell > .viewport-intents.active { position: absolute; z-index: 40; right: 0; top: 70px; bottom: 0; width: min(360px, calc(100vw - 48px)); border: 1px solid var(--ui-divider); }\n}\n\n/* Theme-owned workspace surfaces. Keep each foreground paired with the\n   surface it describes so legacy light literals cannot leak into Dark. */\n\n.app-shell .project-strip,\n.app-shell .status-bar {\n  color: var(--ui-text);\n  background: var(--ui-raised);\n  border-color: var(--ui-divider);\n}\n\n.app-shell .workspace-drawer {\n  color: var(--ui-text);\n  background: var(--ui-surface);\n  border-color: var(--ui-border);\n}\n\n.app-shell .drawer-header h2,\n.app-shell .panel-title,\n.app-shell .inspector h2,\n.app-shell .inspector h3,\n.app-shell .editor-intent h3,\n.app-shell .result-group h3,\n.app-shell .result-detail-panel h3,\n.app-shell .diagnostic-detail-panel h3,\n.app-shell .mechanics-gap-ledger h3,\n.app-shell .endpoint-pair h4,\n.app-shell .viewport-tool-heading {\n  color: var(--ui-text);\n}\n\n.app-shell .drawer-header span,\n.app-shell .status-drawer-button small,\n.app-shell .boundary-item code,\n.app-shell .model-tree-controls label span,\n.app-shell .model-tree-controls > span,\n.app-shell .tree-group h3,\n.app-shell .tree-row small,\n.app-shell .inspector dt,\n.app-shell .editor-intent-controls label span,\n.app-shell .inspector-context-card > span,\n.app-shell .inspector-context-card dt,\n.app-shell .record-row small,\n.app-shell .operation-record small,\n.app-shell .diagnostic-controls label span,\n.app-shell .diagnostic-controls > span,\n.app-shell .diagnostic-severity-summary span,\n.app-shell .result-filter-row label span,\n.app-shell .result-filter-row > span,\n.app-shell .result-page-size span,\n.app-shell .result-page-row > span,\n.app-shell .result-detail-panel dt,\n.app-shell .diagnostic-detail-panel dt,\n.app-shell .gap-list small,\n.app-shell .gap-list p,\n.app-shell .panel-subtitle,\n.app-shell .report-actions span,\n.app-shell .report-line span,\n.app-shell .report-note,\n.app-shell .muted {\n  color: var(--ui-muted);\n}\n\n.app-shell .tree-row strong,\n.app-shell .inspector dd,\n.app-shell .inspector-context-card dd,\n.app-shell .editor-intent-fact strong,\n.app-shell .editor-intent-queue strong,\n.app-shell .proposal-fact strong,\n.app-shell .proposal-flag strong,\n.app-shell .status-pill strong,\n.app-shell .diagnostic-severity-summary strong,\n.app-shell .result-detail-panel dd,\n.app-shell .diagnostic-detail-panel dd,\n.app-shell .report-line strong {\n  color: var(--ui-text);\n}\n\n.app-shell .tree-row[aria-selected=\"true\"] strong,\n.app-shell .tree-row[aria-selected=\"true\"] small,\n.app-shell .tree-row[aria-selected=\"true\"] .tree-visibility-state {\n  color: var(--ui-selection-text);\n}\n\n.app-shell .storage-capability,\n.app-shell .issue-row,\n.app-shell .record-row,\n.app-shell .operation-record,\n.app-shell .result-detail-panel,\n.app-shell .diagnostic-detail-panel,\n.app-shell .mechanics-gap-ledger,\n.app-shell .gap-list article,\n.app-shell .report-line,\n.app-shell .inspector-context-card,\n.app-shell .editor-intent-fact,\n.app-shell .editor-intent-queue,\n.app-shell .editor-inline-validation,\n.app-shell .diagnostic-severity-summary span {\n  color: var(--ui-text);\n  background: var(--ui-raised);\n  border-color: var(--ui-divider);\n}\n\n.app-shell .boundary-item {\n  color: var(--ui-text);\n}\n\n.app-shell .report-export-link {\n  color: var(--ui-text);\n  background: var(--ui-surface);\n  border-color: var(--ui-border);\n}\n\n.app-shell .issue-row p,\n.app-shell .record-row p,\n.app-shell .operation-record p,\n.app-shell .diff-list p {\n  color: var(--ui-muted);\n}\n\n.app-shell .diagnostic {\n  color: var(--ui-text);\n  background: var(--ui-raised);\n  border-color: var(--ui-divider);\n}\n\n.app-shell .diagnostic p,\n.app-shell .diagnostic strong {\n  color: inherit;\n}\n\n.app-shell .diagnostic.warning,\n.app-shell .issue-row.warning {\n  color: var(--ui-warning-text);\n  background: var(--ui-warning-surface);\n  border-color: var(--ui-warning-border);\n}\n\n.app-shell .diagnostic.error,\n.app-shell .diagnostic.blocking,\n.app-shell .issue-row.error,\n.app-shell .issue-row.blocking {\n  color: var(--ui-error-text);\n  background: var(--ui-error-surface);\n  border-color: var(--ui-error-border);\n}\n\n.app-shell .diagnostic.info,\n.app-shell .issue-row.info {\n  color: var(--ui-info-text);\n  background: var(--ui-info-surface);\n  border-color: var(--ui-info-border);\n}\n\n.app-shell .issue-row.warning p,\n.app-shell .issue-row.error p,\n.app-shell .issue-row.blocking p,\n.app-shell .issue-row.info p {\n  color: inherit;\n}\n\n.app-shell .diagnostic.active {\n  outline-color: var(--ui-accent);\n}\n\n.app-shell .status-pill,\n.app-shell .status-pill[open] > div {\n  color: var(--ui-text);\n  background: var(--ui-surface);\n  border-color: var(--ui-divider);\n}\n\n.app-shell .status-pill code {\n  color: var(--ui-muted);\n}\n\n.app-shell .operation-tabs button:hover:not(:disabled) {\n  background: var(--ui-raised);\n}\n\n.app-shell input::placeholder,\n.app-shell textarea::placeholder {\n  color: var(--ui-muted);\n  opacity: 1;\n}\n\n/* Results text follows the active appearance, including the selected row. */\n\n.app-shell .workspace-dock-header h2 { color: var(--ui-text); }\n\n.app-shell .results-panel .dual-unit-cell { color: var(--ui-muted); }\n\n.app-shell .results-panel .selected-result-row {\n  color: var(--ui-selection-text);\n  background: var(--ui-selection);\n  box-shadow: inset 3px 0 0 var(--ui-accent);\n}\n\n.app-shell .results-panel .selected-result-row .dual-unit-cell { color: var(--ui-selection-text); }\n\n/* The primary Current or Historical result table owns the complete dock row. */\n\n.app-shell [data-testid=\"workspace-section-results\"] > .results-panel,\n.app-shell [data-testid=\"workspace-section-results\"] > [data-testid=\"historical-run-context\"] {\n  grid-column: 1 / -1;\n  min-width: 0;\n}\n\n.app-shell .results-panel .result-group { min-width: 0; overflow-x: auto; }\n\n.app-shell .results-panel .result-group td:nth-child(4) {\n  white-space: nowrap;\n  overflow-wrap: normal;\n}\n\n.app-shell .results-panel th { color: var(--ui-muted); }\n\n.app-shell .inspector .required-flag { color: var(--ui-warning-text); }\n\n/*\n * The shell of slice B3 (UX specification V1.2 sections 2.3 and 5.5; design system V1.3 sections 0,\n * 5.2 and 5.3). Structure only: regions, their order and their sizes. Every colour, border, radius\n * and spacing is a token or a --ui-* variable; appearance is settled at the closing visual pass.\n * Regions: menu bar (in-app, browser runtime only), toolbar band 48, stage rail 56, surfaces,\n * agent strip 44, status bar 24. The three views lay the same mounted panes out differently;\n * nothing is re-parented, so the canvas, the inspector and every section keep their state.\n */\n\n.app-shell, .app-shell.native-menu { display: flex; flex-direction: column; height: 100dvh; min-height: 540px; overflow: hidden; }\n\n.app-shell .shell-toolbar {\n  flex: 0 0 var(--layout-toolbar); box-sizing: border-box; height: var(--layout-toolbar); min-height: 0;\n  display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--space-4);\n  color: var(--ui-text); background: var(--ui-bg); border-bottom: 1px solid var(--ui-divider);\n}\n\n.app-shell .shell-toolbar-identity { display: flex; align-items: baseline; gap: var(--space-3); min-width: 0; flex: 0 1 auto; }\n\n.app-shell .shell-wordmark { margin: 0; font-size: var(--type-size-body); font-weight: 500; letter-spacing: 0.04em; color: var(--ui-muted); }\n\n.app-shell .shell-project-name { margin: 0; max-width: 220px; overflow: hidden; color: var(--ui-text); font-size: var(--type-size-body); text-overflow: ellipsis; white-space: nowrap; }\n\n.app-shell .shell-toolbar-group, .app-shell .shell-view-switch, .app-shell .shell-toolbar-centre { display: flex; align-items: center; gap: var(--space-1); flex: 0 0 auto; }\n\n.app-shell .shell-toolbar-centre { flex: 1 1 auto; justify-content: center; gap: var(--space-3); }\n\n.app-shell .shell-toolbar button, .app-shell .shell-appearance > summary {\n  display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);\n  min-width: 28px; min-height: 28px; padding: 0 var(--space-3); box-sizing: border-box;\n  border: 1px solid var(--ui-border); border-radius: var(--radius-control);\n  color: var(--ui-text); background: var(--ui-surface); font-size: var(--type-size-body); white-space: nowrap; cursor: pointer;\n}\n\n.app-shell .shell-toolbar button:hover:not(:disabled):not([aria-disabled=\"true\"]) { background: var(--ui-raised); }\n\n.app-shell .shell-toolbar button:disabled, .app-shell .shell-toolbar button[aria-disabled=\"true\"],\n.app-shell .shell-rail-item[aria-disabled=\"true\"], .app-shell .shell-agent-strip button[aria-disabled=\"true\"] {\n  color: var(--ui-disabled-text); background: var(--ui-disabled); cursor: not-allowed;\n}\n\n.app-shell .shell-view-switch { gap: 0; }\n\n.app-shell .shell-view-switch .shell-reason-anchor:not(:first-child) button { margin-inline-start: -1px; }\n\n.app-shell .shell-view-switch button { min-height: 26px; border-radius: 0; color: var(--ui-muted); background: var(--ui-bg); }\n\n.app-shell .shell-view-switch button[aria-pressed=\"true\"] { color: var(--ui-text); background: var(--ui-surface); border-inline-start: 1px solid var(--ui-border); }\n\n.app-shell .shell-toolbar .shell-run { color: var(--text-inverse); background: var(--accent-fill); border-color: var(--accent-fill); }\n\n.app-shell .shell-toolbar .shell-run:hover { background: var(--accent-fillHover); }\n\n.app-shell .shell-toolbar button[aria-pressed=\"true\"]:not([data-testid^=\"view-switch-\"]), .app-shell .shell-panel-toggle.latched {\n  color: var(--pressed-ink); background: var(--pressed-fill); border-inline-start: 1px solid var(--ui-border);\n}\n\n.app-shell .shell-toolbar-units select { min-height: 28px; width: 80px; box-sizing: border-box; border: 1px solid var(--ui-border); border-radius: var(--radius-control); }\n\n.app-shell .shell-appearance { position: relative; flex: 0 0 auto; }\n\n.app-shell .shell-appearance > summary { list-style: none; padding: 0; }\n\n.app-shell .shell-appearance > summary::-webkit-details-marker { display: none; }\n\n.app-shell .shell-appearance-popover {\n  position: absolute; z-index: 60; top: calc(100% + var(--space-2)); right: 0; display: grid; gap: var(--space-3); min-width: 200px; padding: var(--space-4);\n  color: var(--ui-text); background: var(--surface-raised); border: 1px solid var(--ui-border); border-radius: var(--radius-card); box-shadow: var(--elevation-2);\n}\n\n.app-shell .shell-appearance-popover label { display: grid; grid-template-columns: 64px minmax(0, 1fr); al