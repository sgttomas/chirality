+// RV123 scratch: the two-mechanics milestone, step by step through W1's own helpers.
+#[test]
+fn rv123_r2_probe_two_mechanics_steps() {
+    let mut two = raw();
+    two["model"]["combinations"] = json!([
+        {"id": "combination:2case", "label": "RV123 probe: 2 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": 2.0}], "provenance": B2P},
+        {"id": "combination:m3case", "label": "RV123 probe: -3 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": -3.0}], "provenance": B2P}]);
+    let name_end = |end: &rp::AttemptEnd| match end {
+        rp::AttemptEnd::Preparation => "Preparation", rp::AttemptEnd::Prepared => "Prepared", rp::AttemptEnd::Native => "Native",
+        rp::AttemptEnd::Selected => "Selected", rp::AttemptEnd::Frozen(_) => "Frozen", rp::AttemptEnd::Candidate(_) => "Candidate" };
+    for (name, raw) in [("two", two), ("c1_range_mechanics", b2_c1_range_mechanics())] {
+        let mode = PreviewSolverMode::SparseInteractive;
+        let (capture, observer, ordinary) = observed(mode, &raw);
+        let cases = w1_case_ids(&capture).expect("domain");
+        let attempted = cases.attempted(case_triggers(&ordinary.numerical_quality, &observer.ordinary, cases.ids()));
+        println!("RV123_STEP {name} ids={:?} attempted={:?}", cases.ids(), attempted.requests());
+        let mut prepared = match observer.prepare_cases(ordinary, cases.ids().len(), attempted.requests()) {
+            Ok(p) => p,
+            Err(f) => { println!("RV123_STEP {name} custody_err={:?}", f.error); continue; }
+        };
+        println!("RV123_STEP {name} after T-7 {:?}", prepared.attempts.iter().map(|a| name_end(&a.end)).collect::<Vec<_>>());
+        prepared.native();
+        println!("RV123_STEP {name} after T-8 {:?} native_error={:?}", prepared.attempts.iter().map(|a| name_end(&a.end)).collect::<Vec<_>>(),
+            prepared.attempts.iter().map(|a| format!("{:?}", a.trace.native_error)).collect::<Vec<_>>());
+        prepared.freeze();
+        println!("RV123_STEP {name} after T-9 {:?}", prepared.attempts.iter().map(|a| name_end(&a.end)).collect::<Vec<_>>());
+    }
+}
