+// RV123 scratch: the two-mechanics milestone through w1_transaction and retained_w1 directly.
+#[test]
+fn rv123_r2_probe_two_mechanics_direct() {
+    let mut two = raw();
+    two["model"]["combinations"] = json!([
+        {"id": "combination:2case", "label": "RV123 probe: 2 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": 2.0}], "provenance": B2P},
+        {"id": "combination:m3case", "label": "RV123 probe: -3 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": -3.0}], "provenance": B2P}]);
+    for mode in MODES {
+        let (capture, observer, ordinary) = observed(mode, &two);
+        let (_, r) = retained_w1(observer, ordinary, &capture);
+        println!("RV123_DIRECT {mode:?} retained_w1={:?}", r.as_ref().err());
+        let (capture, observer, ordinary) = observed(mode, &two);
+        let (_, r) = w1_transaction(observer, ordinary, &capture, 1, &[0]);
+        println!("RV123_DIRECT {mode:?} w1_transaction={:?}", r.as_ref().err());
+        let (capture, observer, ordinary) = observed(mode, &two);
+        let cases = w1_case_ids(&capture).expect("domain");
+        let attempted = cases.attempted(case_triggers(&ordinary.numerical_quality, &observer.ordinary, cases.ids()));
+        let mut prepared = match observer.prepare_cases(ordinary, 1, attempted.requests()) { Ok(p) => p, Err(f) => { println!("custody {:?}", f.error); continue; } };
+        prepared.native(); prepared.freeze(); prepared.dispositions();
+        let combined = prepared.combine();
+        println!("RV123_DIRECT {mode:?} combine={:?} ends={:?}", combined.as_ref().err().map(|e| e.0),
+            prepared.combinations.iter().map(|c| format!("{:?}", std::mem::discriminant(&c.end))).collect::<Vec<_>>());
+        match prepared.staged_envelope() { Ok(_) => println!("RV123_DIRECT {mode:?} staged ok"), Err(f) => println!("RV123_DIRECT {mode:?} staging {f:?}") }
+    }
+}
