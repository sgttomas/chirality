+// ---- RV123 (RV-P2 round 2), scratch only: dump every B2-P witness successor for checks outside PP ----
+#[test]
+fn rv123_r2_dump_b2p_successors() {
+    let dir = std::env::var("RV123_DUMP").expect("RV123_DUMP");
+    let mut all = b2p_witnesses();
+    all.extend(b2p_cap_witnesses());
+    // RV123 probes: W-CB3 with its terms reversed (operand 0 the not_required, operand-prepared
+    // case: the freeze on a prepared slot), B + 0.5 A, and c = 1 with two retained mechanics
+    // combinations (two Calls; the meter chain and the ordinal mapping over three Calls).
+    let mut ba = w_cb3();
+    ba["model"]["combinations"][0]["terms"] = json!([{"load_case": "case:b", "factor": 1.0}, {"load_case": "case:a", "factor": 1.0}]);
+    ba["model"]["combinations"][0]["id"] = json!("combination:ba");
+    let mut bha = ba.clone();
+    bha["model"]["combinations"][0]["terms"][1]["factor"] = json!(0.5);
+    bha["model"]["combinations"][0]["id"] = json!("combination:b-half-a");
+    let mut two = raw();
+    two["model"]["combinations"] = json!([
+        {"id": "combination:2case", "label": "RV123 probe: 2 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": 2.0}], "provenance": B2P},
+        {"id": "combination:m3case", "label": "RV123 probe: -3 case", "basis": "mechanics", "terms": [{"load_case": "case", "factor": -3.0}], "provenance": B2P}]);
+    all.extend([("rv123_w_cb3_ba", ba), ("rv123_w_cb3_b_half_a", bha), ("rv123_c1_two_mechanics", two)]);
+    for (name, raw) in all {
+        for mode in MODES {
+            let plain = plain(mode, &raw);
+            let (capture, observer, ordinary) = observed(mode, &raw);
+            let ((_, retained), _, captured) = hooks::counted_with_successor(|| retained_w1(observer, ordinary, &capture));
+            let Some(successor) = captured else {
+                println!("RV123_DUMP {name} {} successor=none w1={retained:?}", mode.as_str());
+                continue;
+            };
+            let doc = json!({"name": name, "source": successor, "invocation": {"request": raw, "solver_mode": mode.as_str()},
+                "precommit_today": retained.as_ref().err().map(|e| format!("{e:?}"))});
+            std::fs::write(format!("{dir}/{name}.{}.successor.json", mode.as_str()), serde_json::to_vec(&doc).unwrap()).unwrap();
+            std::fs::write(format!("{dir}/{name}.{}.plain.json", mode.as_str()), &plain).unwrap();
+            println!("RV123_DUMP {name} {} bytes={}", mode.as_str(), sha(&serde_json::to_vec(&successor).unwrap()));
+        }
+    }
+}
