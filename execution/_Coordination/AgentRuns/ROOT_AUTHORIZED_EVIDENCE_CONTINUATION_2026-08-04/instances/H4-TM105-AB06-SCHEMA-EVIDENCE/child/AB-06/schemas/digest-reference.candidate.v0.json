{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:tm105:candidate:digest-reference:v0",
  "title": "NON_AUTHORITATIVE_INCOMPLETE_CANDIDATE TM105 digest reference alternatives v0",
  "description": "Carries one unselected digest-bearing alternative. No serialization, canonicalization, digest algorithm, cryptographic profile, domain separation, agility, payload scope, correctness, equality, or compatibility meaning is selected.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "candidateStatus", "alternative", "payloadReference"],
  "properties": {
    "schemaVersion": {"const": "tm105.digest-reference.candidate/v0"},
    "candidateStatus": {"const": "NON_AUTHORITATIVE_INCOMPLETE_CANDIDATE"},
    "alternative": {"enum": ["OPAQUE_ORIGINAL_BYTES", "UTF8_JSON_LATER_SELECTED_PROFILE", "TYPED_BINARY_LATER_SELECTED_PROFILE"]},
    "payloadReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "algorithmId": {"type": "string", "minLength": 1},
    "canonicalizationProfileId": {"type": "string", "minLength": 1},
    "binaryProfileId": {"type": "string", "minLength": 1},
    "payloadScopeId": {"type": "string", "minLength": 1},
    "domainSeparationId": {"type": "string", "minLength": 1},
    "digestText": {"type": "string", "minLength": 1},
    "allSelectionFieldsStatus": {"const": "TBD"}
  },
  "allOf": [
    {
      "if": {"properties": {"alternative": {"const": "OPAQUE_ORIGINAL_BYTES"}}, "required": ["alternative"]},
      "then": {"not": {"anyOf": [{"required": ["canonicalizationProfileId"]}, {"required": ["binaryProfileId"]}]}}
    },
    {
      "if": {"properties": {"alternative": {"const": "UTF8_JSON_LATER_SELECTED_PROFILE"}}, "required": ["alternative"]},
      "then": {"required": ["canonicalizationProfileId", "allSelectionFieldsStatus"]}
    },
    {
      "if": {"properties": {"alternative": {"const": "TYPED_BINARY_LATER_SELECTED_PROFILE"}}, "required": ["alternative"]},
      "then": {"required": ["binaryProfileId", "allSelectionFieldsStatus"]}
    }
  ],
  "x-candidate-status": "NON_AUTHORITATIVE_INCOMPLETE_CANDIDATE",
  "x-open-tbds": ["TBD-105-03", "TBD-105-21"]
}
